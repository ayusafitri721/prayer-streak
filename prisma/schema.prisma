generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  phone       String?
  profileImage String?
  password    String
  role        Role      @default(USER)
  streakProtection Int   @default(3)
  restoreChallengeActive Boolean @default(false)
  restoreChallengeProgress Int @default(0)
  restoreReflectionDone Boolean @default(false)
  restoreReflectionDate DateTime? @db.Date
  lastStreakEvaluatedDate DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  prayerLogs  PrayerLog[]
  streakDays  StreakDay[]
  achievements UserAchievement[]
  xpHistories XPHistory[]
  favoriteContents FavoriteContent[]
}

model PrayerLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  prayerType String
  date       DateTime @db.Date
  status     Boolean  @default(false)
  prayedAt   DateTime?
  isOnTime   Boolean  @default(false)
  xpEarned   Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, prayerType])
  @@index([userId, date])
}

model Achievement {
  id           Int    @id @default(autoincrement())
  slug         String @unique
  name         String
  description  String
  targetType   String
  targetValue  Int
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  achievementId Int
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XPHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  pointChange Int
  reason      String
  relatedDate DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StreakDay {
  id             Int      @id @default(autoincrement())
  userId         Int
  date           DateTime @db.Date
  completedCount Int      @default(0)
  status         String
  protectionUsed Boolean  @default(false)
  restoreProgressAfter Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model FavoriteContent {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  reference String
  content   String   @db.Text
  sourceUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, reference])
  @@index([userId, createdAt])
}
