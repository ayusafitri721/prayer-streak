<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "Prayer Streak" %></title>
    <% if (metaDescription) { %>
      <meta name="description" content="<%= metaDescription %>" />
    <% } %>
    <% if (robots) { %>
      <meta name="robots" content="<%= robots %>" />
    <% } %>
    <% if (canonicalUrl) { %>
      <link rel="canonical" href="<%= canonicalUrl %>" />
    <% } %>
    <% if (openGraph) { %>
      <meta property="og:title" content="<%= openGraph.title || title || 'Prayer Streak' %>" />
      <% if (openGraph.description || metaDescription) { %>
        <meta property="og:description" content="<%= openGraph.description || metaDescription %>" />
        <meta name="twitter:description" content="<%= openGraph.description || metaDescription %>" />
      <% } %>
      <meta property="og:type" content="<%= openGraph.type || 'website' %>" />
      <% if (openGraph.url || canonicalUrl) { %>
        <meta property="og:url" content="<%= openGraph.url || canonicalUrl %>" />
      <% } %>
      <meta property="og:site_name" content="Prayer Streak" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content="<%= openGraph.title || title || 'Prayer Streak' %>" />
    <% } %>
    <link rel="icon" type="image/svg+xml" href="/assets/prayer-streak-logo.svg" />
    <link rel="shortcut icon" href="/assets/prayer-streak-logo.svg" />
    <link rel="manifest" href="/manifest.webmanifest?v=2" />
    <meta name="theme-color" content="#588157" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Prayer Streak" />
    <link rel="apple-touch-icon" href="/assets/icons/icon-192.png" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Amiri+Quran&display=swap" rel="stylesheet" />
  </head>
<body
  class="min-h-screen <%= hideTopbar ? 'bg-white' : 'bg-[#F6F1E9]' %> text-[#344E41]"
  data-page-transition-type="<%= pageTransition?.type || '' %>"
  data-page-transition-name="<%= pageTransition?.name || '' %>"
  data-user-id="<%= user?.id || '' %>"
>
    <%- include('../partials/splash-screen') %>
    <div class="<%= hideTopbar ? 'min-h-screen bg-white' : 'min-h-screen bg-[linear-gradient(180deg,_#F6F1E9_0%,_#F3ECDf_100%)]' %>">
      <div>
        <% if (!hideTopbar) { %>
          <%- include('../partials/topbar') %>
        <% } %>
        <% if (flashMessage) { %>
          <div class="mx-auto mt-4 w-full max-w-6xl px-4 sm:px-6">
            <div class="rounded-2xl border border-[#A3B18A]/50 bg-white/75 px-4 py-3 text-sm font-medium text-[#344E41] shadow-sm">
              <%= flashMessage %>
            </div>
          </div>
        <% } %>
        <% if (flashError) { %>
          <div class="mx-auto mt-4 w-full max-w-6xl px-4 sm:px-6">
            <div class="rounded-2xl border border-red-300/40 bg-red-50 px-4 py-3 text-sm font-medium text-red-700 shadow-sm">
              <%= flashError %>
            </div>
          </div>
        <% } %>
        <%- body %>
      </div>
    </div>
    <button
      type="button"
      class="fixed bottom-5 right-5 z-[90] hidden rounded-full bg-[#588157] px-4 py-2.5 text-sm font-semibold text-white shadow-[0_10px_28px_rgba(52,78,65,0.28)] transition hover:bg-[#466B47]"
      data-app-install-btn
      aria-hidden="true"
    >
      Install Aplikasi
    </button>
    <script src="/js/main.js"></script>
    <script src="/js/pwa-install.js"></script>
  </body>
</html>
