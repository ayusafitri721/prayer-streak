<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "Prayer Streak" %></title>
    <% if (metaDescription) { %>
      <meta name="description" content="<%= metaDescription %>" />
    <% } %>
    <% if (robots) { %>
      <meta name="robots" content="<%= robots %>" />
    <% } %>
    <% if (canonicalUrl) { %>
      <link rel="canonical" href="<%= canonicalUrl %>" />
    <% } %>
    <% if (openGraph) { %>
      <meta property="og:title" content="<%= openGraph.title || title || 'Prayer Streak' %>" />
      <% if (openGraph.description || metaDescription) { %>
        <meta property="og:description" content="<%= openGraph.description || metaDescription %>" />
        <meta name="twitter:description" content="<%= openGraph.description || metaDescription %>" />
      <% } %>
      <meta property="og:type" content="<%= openGraph.type || 'website' %>" />
      <% if (openGraph.url || canonicalUrl) { %>
        <meta property="og:url" content="<%= openGraph.url || canonicalUrl %>" />
      <% } %>
      <meta property="og:site_name" content="Prayer Streak" />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content="<%= openGraph.title || title || 'Prayer Streak' %>" />
    <% } %>
    <link rel="icon" type="image/svg+xml" href="/assets/prayer-streak-logo.svg" />
    <link rel="shortcut icon" href="/assets/prayer-streak-logo.svg" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet" />
  </head>
<body
  class="min-h-screen <%= hideTopbar ? 'bg-white' : 'bg-[#F6F1E9]' %> text-[#344E41]"
  data-page-transition-type="<%= pageTransition?.type || '' %>"
  data-page-transition-name="<%= pageTransition?.name || '' %>"
  data-user-id="<%= user?.id || '' %>"
>
    <%- include('../partials/splash-screen') %>
    <div class="<%= hideTopbar ? 'min-h-screen bg-white' : 'min-h-screen bg-[linear-gradient(180deg,_#F6F1E9_0%,_#F3ECDf_100%)]' %>">
      <% if (!hideTopbar) { %>
        <%- include('../partials/topbar') %>
      <% } %>
      <% if (flashMessage) { %>
        <div class="mx-auto mt-4 w-full max-w-6xl px-4 sm:px-6">
          <div class="rounded-2xl border border-[#A3B18A]/50 bg-white/75 px-4 py-3 text-sm font-medium text-[#344E41] shadow-sm">
            <%= flashMessage %>
          </div>
        </div>
      <% } %>
      <% if (flashError) { %>
        <div class="mx-auto mt-4 w-full max-w-6xl px-4 sm:px-6">
          <div class="rounded-2xl border border-red-300/40 bg-red-50 px-4 py-3 text-sm font-medium text-red-700 shadow-sm">
            <%= flashError %>
          </div>
        </div>
      <% } %>
      <%- body %>
    </div>
    <script src="/js/main.js"></script>
  </body>
</html>
