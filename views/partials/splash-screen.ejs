<div
  id="app-splash-screen"
  class="fixed inset-0 z-[100] flex items-center justify-center overflow-hidden bg-[#344E41] px-6 text-[#F6F1E9]"
  data-splash-screen
  aria-hidden="true"
>
  <div class="absolute inset-0 opacity-90">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(212,163,115,0.28),_transparent_42%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,_rgba(163,177,138,0.2),_transparent_38%)]"></div>
  </div>

  <div class="relative z-10 flex max-w-md flex-col items-center text-center">
    <div class="relative flex h-28 w-28 items-center justify-center">
      <div class="absolute h-28 w-28 rounded-full border border-white/12"></div>
      <div class="absolute h-20 w-20 rounded-full border border-[#D4A373]/45 splash-pulse-ring"></div>
      <div class="absolute h-3 w-3 rounded-full bg-[#D4A373] splash-orbit"></div>
      <div class="relative flex h-16 w-16 items-center justify-center rounded-[1.5rem] border border-white/15 bg-white/10 shadow-2xl shadow-black/20 backdrop-blur">
        <svg class="h-8 w-8 text-[#F6F1E9]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.25 0 4.07 1.82 4.07 4.07 0 1.26-.57 2.39-1.46 3.14.89.75 1.46 1.88 1.46 3.14 0 2.25-1.82 4.08-4.07 4.08S7.93 17.1 7.93 14.85c0-1.26.57-2.39 1.46-3.14-.89-.75-1.46-1.88-1.46-3.14C7.93 6.32 9.75 4.5 12 4.5z" />
        </svg>
      </div>
    </div>

    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.4em] text-[#A3B18A]">Prayer Streak</p>
    <h2 class="mt-4 text-4xl font-bold tracking-tight text-white">Bangun Ritme Ibadah</h2>
    <p class="mt-3 max-w-sm text-sm leading-7 text-[#F6F1E9]/70">
      Menyiapkan dashboard, progres, dan konten harian untuk menemani konsistensi salatmu.
    </p>

    <div class="mt-7 flex items-center gap-2 text-[#A3B18A]">
      <span class="h-2.5 w-2.5 rounded-full bg-current splash-dot" style="animation-delay: 0s"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-current splash-dot" style="animation-delay: 0.18s"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-current splash-dot" style="animation-delay: 0.36s"></span>
    </div>
  </div>
</div>

<style>
  .splash-hide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s ease, visibility 0.45s ease;
  }

  .splash-orbit {
    animation: splashOrbit 2.8s linear infinite;
    transform-origin: center center;
  }

  .splash-pulse-ring {
    animation: splashPulse 2.2s ease-in-out infinite;
  }

  .splash-dot {
    animation: splashDot 1s ease-in-out infinite;
  }

  @keyframes splashOrbit {
    from {
      transform: rotate(0deg) translateY(-40px) rotate(0deg);
    }

    to {
      transform: rotate(360deg) translateY(-40px) rotate(-360deg);
    }
  }

  @keyframes splashPulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.96);
    }

    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @keyframes splashDot {
    0%,
    80%,
    100% {
      transform: translateY(0);
      opacity: 0.38;
    }

    40% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-orbit,
    .splash-pulse-ring,
    .splash-dot {
      animation: none;
    }

    .splash-hide {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    try {
      if (window.sessionStorage.getItem("prayer-streak-splash-seen") === "true") {
        var splash = document.getElementById("app-splash-screen");
        if (splash) {
          splash.style.display = "none";
        }
      }
    } catch (error) {}
  })();
</script>
