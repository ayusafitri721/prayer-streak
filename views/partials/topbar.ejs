<header class="border-b border-white/10 bg-slate-900/70">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6">
    <a href="/" class="text-xl font-bold tracking-wide text-emerald-200">Prayer Streak</a>

    <% if (user) { %>
      <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-200">
        <a href="/dashboard" class="rounded-full px-3 py-2 hover:bg-white/10 hover:text-white">Dashboard</a>
        <a href="/statistics" class="rounded-full px-3 py-2 hover:bg-white/10 hover:text-white">Statistik</a>
        <a href="/achievements" class="rounded-full px-3 py-2 hover:bg-white/10 hover:text-white">Achievement</a>
        <a href="/profile" class="rounded-full px-3 py-2 hover:bg-white/10 hover:text-white">Profile</a>
        <form action="/logout" method="POST">
          <button type="submit" class="rounded-full border border-red-300/30 bg-red-400/10 px-3 py-2 text-red-100 hover:bg-red-400/20">
            Logout
          </button>
        </form>
      </nav>
    <% } else { %>
      <div class="flex items-center gap-2 text-sm">
        <a href="/login" class="rounded-full px-3 py-2 text-slate-200 hover:bg-white/10 hover:text-white">Login</a>
        <a href="/register" class="rounded-full bg-emerald-300 px-3 py-2 font-semibold text-slate-950 hover:bg-amber-300">Register</a>
      </div>
    <% } %>
  </div>
</header>
