<%
const primaryNavItems = user ? [
  { href: "/dashboard", label: "Dashboard", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />' },
  { href: "/statistics", label: "Statistik", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />' },
  { href: "/achievements", label: "Achievement", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />' },
] : [];

if (user && user.role === "ADMIN") {
  primaryNavItems.unshift({
    href: "/admin",
    label: "Admin",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 13h6V4H4v9Zm10 7h6V4h-6v16ZM4 20h6v-4H4v4Z" />',
  });
}

const spiritualNavItems = user ? [
  { href: "/belajar", label: "Belajar", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v13H6.5A2.5 2.5 0 0 0 4 19.5V6.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M20 17v3H6.5A2.5 2.5 0 1 1 6.5 15H20" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 8h7M9 11h5" />' },
  { href: "/quran", label: "Al-Qur'an", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />' },
  { href: "/hadis", label: "Hadis", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />' },
  { href: "/doa", label: "Doa", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.25 0 4.07 1.82 4.07 4.07 0 1.26-.57 2.39-1.46 3.14.89.75 1.46 1.88 1.46 3.14 0 2.25-1.82 4.08-4.07 4.08S7.93 17.1 7.93 14.85c0-1.26.57-2.39 1.46-3.14-.89-.75-1.46-1.88-1.46-3.14C7.93 6.32 9.75 4.5 12 4.5z" />' },
  { href: "/dzikir", label: "Dzikir", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4c4.6 0 8.4 3.8 8.4 8.4S16.6 20.8 12 20.8 3.6 17 3.6 12.4 7.4 4 12 4z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.2v4.2l2.8 2.1" /><path stroke-linecap="round" stroke-linejoin="round" d="M8.4 3.8 7.1 5.1M15.6 3.8l1.3 1.3" />' },
] : [];

const navItems = user ? [
  ...primaryNavItems,
  ...spiritualNavItems,
  { href: "/profile", label: "Profile", icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />' },
] : [];

const isSpiritualActive = user && spiritualNavItems.some((item) => currentPath === item.href || currentPath.startsWith(`${item.href}/`));
const showReadingSettingsShortcut = user && (currentPath.startsWith("/quran") || currentPath.startsWith("/dzikir"));
const streakValue = typeof streak !== "undefined" ? streak : (typeof activeStreak !== "undefined" ? activeStreak : 0);
const userInitial = user && user.name ? user.name.trim().charAt(0).toUpperCase() : "P";
const userProfileImage = user && user.profileImage ? user.profileImage : null;
%>

<header class="relative z-40 px-3 pt-3 sm:px-5">
  <div class="mx-auto flex w-full max-w-[92rem] items-center justify-between rounded-[1.55rem] border border-[#DCCFBF]/80 bg-white/88 px-3 py-3 shadow-[0_18px_55px_rgba(52,78,65,0.11)] backdrop-blur-xl sm:px-5">
    <a href="<%= user ? '/dashboard' : '/' %>" class="group flex min-w-fit items-center gap-3">
      <span class="grid h-11 w-11 place-items-center overflow-hidden rounded-2xl shadow-md shadow-[#344E41]/14 ring-1 ring-[#A3B18A]/25 transition group-hover:-translate-y-0.5">
        <img src="/assets/prayer-streak-logo.svg" alt="Prayer Streak" class="h-full w-full" />
      </span>
      <span class="leading-tight">
        <span class="block text-lg font-black tracking-wide text-[#244338] sm:text-xl">Prayer Streak</span>
        <span class="hidden text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-[#588157]/70 sm:block">Habit ibadah harian</span>
      </span>
    </a>
    <% if (user) { %>
      <nav class="hidden items-center gap-1 rounded-full border border-[#E7DAC8] bg-[#F6F1E9]/68 p-1 text-sm shadow-inner shadow-white/70 lg:flex" aria-label="Navigasi utama">
        <% primaryNavItems.forEach((item) => { %>
          <% const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`); %>
          <a href="<%= item.href %>" class="<%= isActive ? 'bg-[#588157] text-white shadow-md shadow-[#588157]/22' : 'text-[#344E41]/72 hover:bg-white hover:text-[#244338]' %> inline-flex h-10 items-center gap-2 rounded-full px-3 font-semibold transition" title="<%= item.label %>">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <%- item.icon %>
            </svg>
            <span class="hidden xl:inline"><%= item.label %></span>
          </a>
        <% }) %>

        <div class="group relative">
          <button type="button" class="<%= isSpiritualActive ? 'bg-[#588157] text-white shadow-md shadow-[#588157]/22' : 'text-[#344E41]/72 hover:bg-white hover:text-[#244338]' %> inline-flex h-10 items-center gap-2 rounded-full px-3 font-semibold transition">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span class="hidden xl:inline">Spiritual</span>
            <svg class="h-4 w-4 transition group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="invisible absolute left-1/2 top-full z-50 mt-3 w-56 -translate-x-1/2 rounded-3xl border border-[#E3D5C2] bg-white/96 p-2 opacity-0 shadow-[0_22px_55px_rgba(52,78,65,0.18)] backdrop-blur-xl transition before:absolute before:-top-3 before:left-0 before:h-3 before:w-full before:content-[''] group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <% spiritualNavItems.forEach((item) => { %>
              <% const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`); %>
              <a href="<%= item.href %>" class="<%= isActive ? 'bg-[#A3B18A]/22 text-[#244338]' : 'text-[#344E41]/72 hover:bg-[#F6F1E9]' %> flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-semibold transition">
                <svg class="h-5 w-5 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <%- item.icon %>
                </svg>
                <%= item.label %>
              </a>
            <% }) %>
          </div>
        </div>
      </nav>

      <div class="hidden items-center gap-2 lg:flex">
        <div class="flex h-11 items-center gap-2 rounded-full border border-[#F0D7B7] bg-[#FFF7EA] px-2.5 text-sm font-bold text-[#344E41] shadow-sm" title="<%= streakValue %> Day Streak">
          <span class="grid h-7 w-7 place-items-center rounded-full bg-[#D4A373]/22 text-[#B7792D]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21c3.6 0 6.5-2.7 6.5-6.2 0-2.1-1-3.8-2.5-5.3-.9 2.1-2.5 3.2-4.1 3.7.8-2.8-.2-5.8-3-8.2.1 3.4-3.4 5.1-3.4 9.7C5.5 18.3 8.4 21 12 21Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          </span>
          <span><%= streakValue %></span>
        </div>

        <% if (showReadingSettingsShortcut) { %>
          <button
            type="button"
            class="relative grid h-11 w-11 place-items-center rounded-full border border-[#E3D5C2] bg-white text-[#244338] shadow-sm transition hover:-translate-y-0.5 hover:border-[#A3B18A]"
            aria-label="Pengaturan bacaan"
            title="Pengaturan bacaan"
            data-reading-settings-modal-open
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.983 5.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm0 9a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-6-4.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm12 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/>
            </svg>
          </button>
        <% } %>

        <button type="button" class="relative grid h-11 w-11 place-items-center rounded-full border border-[#E3D5C2] bg-white text-[#244338] shadow-sm transition hover:-translate-y-0.5 hover:border-[#A3B18A]" aria-label="Notifikasi" data-notification-panel-toggle>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 17H9m10-2h-1V9a6 6 0 1 0-12 0v6H5a2 2 0 0 0 0 4h14a2 2 0 0 0 0-4ZM10 20a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="absolute right-2 top-2 h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-white" data-notification-badge></span>
        </button>

        <a href="/profile" class="flex h-11 items-center gap-2 rounded-full border border-[#E3D5C2] bg-white py-1.5 pl-1.5 pr-3 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-[#A3B18A]" title="Profile">
            <span class="grid h-9 w-9 place-items-center overflow-hidden rounded-full bg-[#588157] text-sm font-black text-white">
              <% if (userProfileImage) { %>
                <img src="<%= userProfileImage %>" alt="Foto profil <%= user.name %>" class="h-full w-full object-cover" />
              <% } else { %>
                <%= userInitial %>
              <% } %>
            </span>
            <span class="hidden leading-tight 2xl:block">
              <span class="block max-w-28 truncate text-sm font-bold text-[#244338]"><%= user.name %></span>
              <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-[#588157]/62">Profile</span>
            </span>
        </a>

        <form action="/logout" method="POST" data-auth-submit="logout">
          <button type="submit" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#E3D5C2] bg-white text-red-500 shadow-sm transition hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50" title="Logout" aria-label="Logout">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </form>
      </div>

      <div class="flex items-center gap-2 lg:hidden">
        <span class="hidden items-center gap-1 rounded-full border border-[#F0D7B7] bg-[#FFF7EA] px-3 py-2 text-xs font-bold text-[#344E41] sm:flex">
          <span class="text-[#B7792D]"><%= streakValue %></span>
          Streak
        </span>
        <% if (showReadingSettingsShortcut) { %>
          <button
            type="button"
            class="grid h-10 w-10 place-items-center rounded-full border border-[#E3D5C2] bg-white text-[#244338]"
            aria-label="Pengaturan bacaan"
            title="Pengaturan bacaan"
            data-reading-settings-modal-open
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.983 5.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm0 9a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-6-4.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm12 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/>
            </svg>
          </button>
        <% } %>
        <button type="button" class="relative grid h-10 w-10 place-items-center rounded-full border border-[#E3D5C2] bg-white text-[#244338]" aria-label="Notifikasi" data-notification-panel-toggle>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 17H9m10-2h-1V9a6 6 0 1 0-12 0v6H5a2 2 0 0 0 0 4h14a2 2 0 0 0 0-4ZM10 20a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="absolute right-1.5 top-1.5 h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-white" data-notification-badge></span>
        </button>
        <button type="button" class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#A3B18A]/30 bg-white/70 text-[#344E41]" id="sidebar-open-btn" aria-label="Buka menu">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    <% } else { %>
      <div class="flex items-center gap-2 text-sm">
        <a href="/quran" class="rounded-full border border-[#A3B18A]/30 bg-white/65 px-4 py-2.5 font-semibold text-[#344E41] transition hover:bg-[#A3B18A]/18">Al-Qur'an</a>
        <a href="/login" class="rounded-full border border-[#A3B18A]/30 bg-white/65 px-4 py-2.5 font-semibold text-[#344E41] transition hover:bg-[#A3B18A]/18">Login</a>
        <a href="/register" class="rounded-full bg-[#588157] px-4 py-2.5 font-bold text-white shadow-md shadow-[#588157]/20 transition hover:-translate-y-0.5 hover:bg-[#466B47]">Register</a>
      </div>
    <% } %>
  </div>

  <% if (user) { %>
    <div
      class="pointer-events-none hidden absolute right-3 top-[5.15rem] z-[60] w-[min(27.5rem,calc(100vw-1.5rem))] opacity-0 transition duration-200 sm:right-5"
      data-notification-panel
      aria-hidden="true"
    >
      <section class="pointer-events-auto rounded-[1.45rem] border border-[#DCCFBF] bg-white/97 p-4 shadow-[0_24px_60px_rgba(52,78,65,0.22)] backdrop-blur" data-push-settings>
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-[#588157]">Notifikasi</p>
            <h3 class="mt-1 text-lg font-black text-[#244338]">Pengaturan Notifikasi</h3>
          </div>
          <button type="button" class="grid h-8 w-8 place-items-center rounded-full border border-[#E3D5C2] text-[#344E41]/70 transition hover:bg-[#F6F1E9]" data-notification-panel-close aria-label="Tutup panel notifikasi">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 18 18 6M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="mt-3 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/82 px-3 py-2.5 text-xs text-[#344E41]/72" data-push-status>
          Belum aktif.
        </div>

        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <label class="rounded-xl border border-[#A3B18A]/30 bg-[#F6F1E9]/75 p-3">
            <span class="text-xs font-semibold text-[#344E41]">Reminder waktu shalat</span>
            <select class="mt-1.5 w-full rounded-lg border border-[#A3B18A]/35 bg-white px-2.5 py-2 text-xs text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15" data-push-prayer-enabled>
              <option value="true" selected>Aktif</option>
              <option value="false">Nonaktif</option>
            </select>
          </label>
          <label class="rounded-xl border border-[#A3B18A]/30 bg-[#F6F1E9]/75 p-3">
            <span class="text-xs font-semibold text-[#344E41]">Notifikasi imsak</span>
            <select class="mt-1.5 w-full rounded-lg border border-[#A3B18A]/35 bg-white px-2.5 py-2 text-xs text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15" data-push-imsak-enabled>
              <option value="true">Aktif</option>
              <option value="false" selected>Nonaktif</option>
            </select>
          </label>
          <label class="rounded-xl border border-[#A3B18A]/30 bg-[#F6F1E9]/75 p-3">
            <span class="text-xs font-semibold text-[#344E41]">Motivasi ayat/hadis</span>
            <select class="mt-1.5 w-full rounded-lg border border-[#A3B18A]/35 bg-white px-2.5 py-2 text-xs text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15" data-push-motivation-enabled>
              <option value="true" selected>Aktif</option>
              <option value="false">Nonaktif</option>
            </select>
          </label>
          <label class="rounded-xl border border-[#A3B18A]/30 bg-[#F6F1E9]/75 p-3">
            <span class="text-xs font-semibold text-[#344E41]">Jam motivasi</span>
            <input type="time" class="mt-1.5 w-full rounded-lg border border-[#A3B18A]/35 bg-white px-2.5 py-2 text-xs text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15" value="07:00" data-push-motivation-time />
          </label>
          <label class="rounded-xl border border-[#A3B18A]/30 bg-[#F6F1E9]/75 p-3 sm:col-span-2">
            <span class="text-xs font-semibold text-[#344E41]">Reminder sebelum adzan (menit)</span>
            <select class="mt-1.5 w-full rounded-lg border border-[#A3B18A]/35 bg-white px-2.5 py-2 text-xs text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15" data-push-reminder-minute>
              <option value="5">5 menit</option>
              <option value="10" selected>10 menit</option>
              <option value="15">15 menit</option>
            </select>
          </label>
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" class="inline-flex items-center rounded-full bg-[#588157] px-3.5 py-2 text-xs font-semibold text-white transition hover:bg-[#466B47]" data-push-enable>
            Aktifkan
          </button>
          <button type="button" class="inline-flex items-center rounded-full border border-[#A3B18A]/45 bg-white px-3.5 py-2 text-xs font-semibold text-[#344E41] transition hover:bg-[#F6F1E9]" data-push-test>
            Test
          </button>
          <button type="button" class="inline-flex items-center rounded-full border border-red-300/45 bg-red-50 px-3.5 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-100" data-push-disable>
            Matikan
          </button>
        </div>
      </section>
    </div>

    <% if (showReadingSettingsShortcut) { %>
      <div class="fixed inset-0 z-[95] hidden items-center justify-center p-4" data-reading-settings-modal>
        <button type="button" class="absolute inset-0 bg-[#244338]/45 backdrop-blur-[2px]" data-reading-settings-modal-close aria-label="Tutup modal pengaturan bacaan"></button>
        <section class="relative z-10 w-full max-w-2xl rounded-[1.5rem] border border-[#DCCFBF] bg-white p-5 shadow-[0_24px_64px_rgba(52,78,65,0.24)] sm:p-6">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#588157]">Pengaturan Bacaan</p>
              <h3 class="mt-1 text-xl font-black text-[#244338]">Qur'an & Dzikir</h3>
              <p class="mt-1 text-xs text-[#344E41]/62">Berlaku global untuk halaman detail ayat dan dzikir.</p>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="inline-flex items-center rounded-full border border-[#DCCFBF] bg-white px-3 py-1.5 text-[11px] font-semibold text-[#344E41] transition hover:bg-[#EFE6D8]"
                data-reading-settings-reset
              >
                Reset ke default
              </button>
              <button
                type="button"
                class="grid h-9 w-9 place-items-center rounded-full border border-[#E3D5C2] text-[#344E41]/70 transition hover:bg-[#F6F1E9]"
                data-reading-settings-modal-close
                aria-label="Tutup modal pengaturan bacaan"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 18 18 6M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="inline-flex items-center gap-2 text-sm font-medium text-[#344E41]">
              <input type="checkbox" class="h-4 w-4 rounded border-[#A3B18A] text-[#588157]" data-reading-setting-latin />
              Tampilkan Latin
            </label>
            <label class="inline-flex items-center gap-2 text-sm font-medium text-[#344E41]">
              <input type="checkbox" class="h-4 w-4 rounded border-[#A3B18A] text-[#588157]" data-reading-setting-translation />
              Tampilkan Terjemahan
            </label>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="text-sm font-medium text-[#344E41]">
              Ukuran teks Arab
              <input type="range" min="1.8" max="3.4" step="0.1" class="mt-2 w-full accent-[#588157]" data-reading-setting-arabic-size />
            </label>
            <label class="text-sm font-medium text-[#344E41]">
              Ukuran teks arti/latin
              <input type="range" min="0.9" max="1.5" step="0.05" class="mt-2 w-full accent-[#588157]" data-reading-setting-translation-size />
            </label>
          </div>

          <div class="mt-4 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/72 p-3">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#344E41]/50">Contoh Tampilan</p>
            <p class="mt-2 text-right font-['Amiri'] leading-[1.9] text-[#244338]" dir="rtl" data-reading-preview-arabic>
              ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ
            </p>
            <p class="mt-2 text-sm font-semibold text-[#466B47]" data-reading-preview-latin>
              Alhamdu lillaahi rabbil-'aalamiin.
            </p>
            <p class="mt-1 text-sm leading-7 text-[#344E41]/80" data-reading-preview-translation>
              Segala puji bagi Allah, Tuhan seluruh alam.
            </p>
          </div>
        </section>
      </div>
    <% } %>
  <% } %>
</header>

<% if (user) { %>
<div class="fixed inset-0 z-50 hidden" id="sidebar-container">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="sidebar-backdrop"></div>
  <aside class="absolute right-0 top-0 flex h-full w-[300px] max-w-[86vw] translate-x-full flex-col border-l border-[#A3B18A]/20 bg-[#F6F1E9] shadow-2xl transition-transform duration-300 ease-out" id="sidebar-panel">
    <div class="flex items-center justify-between px-5 py-4">
      <div class="flex items-center gap-3">
        <span class="grid h-10 w-10 place-items-center overflow-hidden rounded-xl shadow-md shadow-[#344E41]/12">
          <img src="/assets/prayer-streak-logo.svg" alt="" class="h-full w-full" />
        </span>
        <span class="text-base font-black text-[#344E41]">Menu</span>
      </div>
      <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-[#344E41]/60 transition hover:bg-[#A3B18A]/20 hover:text-[#344E41]" id="sidebar-close-btn" aria-label="Tutup menu">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="mx-5 rounded-2xl bg-[#588157]/10 px-4 py-3">
      <div class="flex items-center gap-3">
        <span class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-[#588157] text-sm font-black text-white">
          <% if (userProfileImage) { %>
            <img src="<%= userProfileImage %>" alt="Foto profil <%= user.name %>" class="h-full w-full object-cover" />
          <% } else { %>
            <%= userInitial %>
          <% } %>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold text-[#344E41]"><%= user.name %></span>
          <span class="mt-0.5 block truncate text-xs text-[#344E41]/50"><%= user.email %></span>
        </span>
      </div>
    </div>

    <nav class="mt-4 flex-1 overflow-y-auto px-3">
      <% navItems.forEach((item) => { %>
        <% const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`); %>
        <a
          href="<%= item.href %>"
          class="<%= isActive ? 'bg-[#588157]/12 text-[#344E41] font-semibold' : 'text-[#344E41]/70' %> mb-1 flex items-center gap-3 rounded-2xl px-4 py-3 text-sm transition hover:bg-[#A3B18A]/15"
        >
          <svg class="h-5 w-5 flex-shrink-0 <%= isActive ? 'text-[#588157]' : 'text-[#A3B18A]' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <%- item.icon %>
          </svg>
          <%= item.label %>
        </a>
      <% }) %>
    </nav>

    <div class="border-t border-[#A3B18A]/20 p-3">
      <form action="/logout" method="POST" data-auth-submit="logout">
        <button type="submit" class="flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-sm font-semibold text-red-500 transition hover:bg-red-50">
          <svg class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Logout
        </button>
      </form>
    </div>
  </aside>
</div>

<script>
(function () {
  var openBtn = document.getElementById("sidebar-open-btn");
  var closeBtn = document.getElementById("sidebar-close-btn");
  var container = document.getElementById("sidebar-container");
  var backdrop = document.getElementById("sidebar-backdrop");
  var panel = document.getElementById("sidebar-panel");
  if (!openBtn || !container || !panel) return;

  function openSidebar() {
    container.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    requestAnimationFrame(function () {
      panel.classList.remove("translate-x-full");
      panel.classList.add("translate-x-0");
    });
  }

  function closeSidebar() {
    panel.classList.remove("translate-x-0");
    panel.classList.add("translate-x-full");
    document.body.style.overflow = "";
    setTimeout(function () { container.classList.add("hidden"); }, 300);
  }

  openBtn.addEventListener("click", openSidebar);
  if (closeBtn) closeBtn.addEventListener("click", closeSidebar);
  if (backdrop) backdrop.addEventListener("click", closeSidebar);
})();
</script>

<script>
(function () {
  var modal = document.querySelector("[data-reading-settings-modal]");
  var openButtons = Array.prototype.slice.call(
    document.querySelectorAll("[data-reading-settings-modal-open]")
  );
  if (!modal || !openButtons.length) return;

  var closeButtons = Array.prototype.slice.call(
    modal.querySelectorAll("[data-reading-settings-modal-close]")
  );
  var latinInput = modal.querySelector("[data-reading-setting-latin]");
  var translationInput = modal.querySelector("[data-reading-setting-translation]");
  var arabicSizeInput = modal.querySelector("[data-reading-setting-arabic-size]");
  var translationSizeInput = modal.querySelector("[data-reading-setting-translation-size]");
  var resetButton = modal.querySelector("[data-reading-settings-reset]");
  var previewArabic = modal.querySelector("[data-reading-preview-arabic]");
  var previewLatin = modal.querySelector("[data-reading-preview-latin]");
  var previewTranslation = modal.querySelector("[data-reading-preview-translation]");
  var storageKey = "prayer-streak:reading-settings:v1";
  var defaults = {
    showLatin: true,
    showTranslation: true,
    arabicSize: 2.4,
    translationSize: 1.0
  };
  var settings = defaults;

  function readSettings() {
    try {
      var raw = window.localStorage.getItem(storageKey);
      return raw ? Object.assign({}, defaults, JSON.parse(raw)) : defaults;
    } catch (_) {
      return defaults;
    }
  }

  function writeSettings(next) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(next));
    } catch (_) {}
  }

  function applyToPreview(next) {
    if (latinInput) latinInput.checked = Boolean(next.showLatin);
    if (translationInput) translationInput.checked = Boolean(next.showTranslation);
    if (arabicSizeInput) arabicSizeInput.value = String(next.arabicSize);
    if (translationSizeInput) translationSizeInput.value = String(next.translationSize);

    if (previewLatin) {
      previewLatin.classList.toggle("hidden", !next.showLatin);
      previewLatin.style.fontSize = String(next.translationSize) + "rem";
    }
    if (previewTranslation) {
      previewTranslation.classList.toggle("hidden", !next.showTranslation);
      previewTranslation.style.fontSize = String(next.translationSize) + "rem";
    }
    if (previewArabic) {
      previewArabic.style.fontSize = String(next.arabicSize) + "rem";
    }
  }

  function applyToLiveContent(next) {
    var latinNodes = document.querySelectorAll("[data-quran-latin], [data-dzikir-latin]");
    var translationNodes = document.querySelectorAll("[data-quran-translation], [data-dzikir-translation]");
    var arabicNodes = document.querySelectorAll("[data-quran-arabic], [data-dzikir-arabic]");

    latinNodes.forEach(function (node) {
      node.classList.toggle("hidden", !next.showLatin);
      node.style.fontSize = String(next.translationSize) + "rem";
    });

    translationNodes.forEach(function (node) {
      node.classList.toggle("hidden", !next.showTranslation);
      node.style.fontSize = String(next.translationSize) + "rem";
    });

    arabicNodes.forEach(function (node) {
      node.style.fontSize = String(next.arabicSize) + "rem";
      node.style.lineHeight = "1.9";
    });
  }

  function applySettings(next) {
    settings = Object.assign({}, next);
    applyToPreview(settings);
    applyToLiveContent(settings);
    writeSettings(settings);
  }

  function openModal() {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  openButtons.forEach(function (button) {
    button.addEventListener("click", openModal);
  });

  closeButtons.forEach(function (button) {
    button.addEventListener("click", closeModal);
  });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  latinInput && latinInput.addEventListener("change", function () {
    applySettings(Object.assign({}, settings, { showLatin: latinInput.checked }));
  });

  translationInput && translationInput.addEventListener("change", function () {
    applySettings(Object.assign({}, settings, { showTranslation: translationInput.checked }));
  });

  arabicSizeInput && arabicSizeInput.addEventListener("input", function () {
    applySettings(Object.assign({}, settings, { arabicSize: Number(arabicSizeInput.value || defaults.arabicSize) }));
  });

  translationSizeInput && translationSizeInput.addEventListener("input", function () {
    applySettings(
      Object.assign({}, settings, {
        translationSize: Number(translationSizeInput.value || defaults.translationSize)
      })
    );
  });

  resetButton && resetButton.addEventListener("click", function () {
    applySettings(defaults);
  });

  settings = readSettings();
  applyToPreview(settings);
})();
</script>
<% } %>
