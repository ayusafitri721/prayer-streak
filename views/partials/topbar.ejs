<header class="border-b border-[#A3B18A]/30 bg-[#F6F1E9]/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6">
    <a href="/" class="text-xl font-bold tracking-wide text-[#344E41]">Prayer Streak</a>

    <% if (user) { %>
      <nav class="flex flex-wrap items-center gap-2 text-sm text-[#344E41]">
        <a href="/dashboard" class="rounded-full px-3 py-2 hover:bg-[#A3B18A]/25">Dashboard</a>
        <a href="/statistics" class="rounded-full px-3 py-2 hover:bg-[#A3B18A]/25">Statistik</a>
        <a href="/achievements" class="rounded-full px-3 py-2 hover:bg-[#A3B18A]/25">Achievement</a>
        <a href="/profile" class="rounded-full px-3 py-2 hover:bg-[#A3B18A]/25">Profile</a>
        <form action="/logout" method="POST">
          <button type="submit" class="rounded-full border border-[#588157]/30 bg-white/60 px-3 py-2 text-[#588157] hover:bg-[#A3B18A]/20">
            Logout
          </button>
        </form>
      </nav>
    <% } else { %>
      <div class="flex items-center gap-2 text-sm">
        <a href="/login" class="rounded-full px-3 py-2 text-[#344E41] hover:bg-[#A3B18A]/25">Login</a>
        <a href="/register" class="rounded-full bg-[#588157] px-3 py-2 font-semibold text-white hover:bg-[#D4A373]">Register</a>
      </div>
    <% } %>
  </div>
</header>
