          <h3 class="text-xl font-black text-[#244338]">Pencapaian Terbaru</h3>
          <a href="/achievements" class="text-sm font-black text-[#2F654D] transition hover:text-[#B7792D]">Lihat semua -></a>
        </div>
        <div class="mt-5 grid grid-cols-3 gap-3">
          <% achievementCards.forEach((item) => { %>
            <article class="text-center">
              <div class="<%= item.unlocked ? 'border-[#D4A373] bg-[#FFF5E4] text-[#B7792D]' : 'border-[#D8CDBB] bg-[#F6F1E9] text-[#A3B18A]' %> mx-auto grid h-16 w-16 place-items-center rounded-2xl border-2 shadow-sm">
                <% if (item.icon === "star") { %>
                  <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.2l-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                <% } else if (item.icon === "user") { %>
                  <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 21a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <% } else { %>
                  <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 15.5A7 7 0 0 1 8.5 6 7.5 7.5 0 1 0 18 15.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                <% } %>
              </div>
              <p class="mt-3 text-sm font-black text-[#244338]"><%= item.name %></p>
              <p class="mt-1 text-xs leading-5 text-[#244338]/58"><%= item.desc %></p>
            </article>
          <% }) %>
        </div>
      </section>
    </aside>
  </section>

  <nav class="fixed bottom-4 left-1/2 z-30 hidden w-[min(720px,calc(100%-2rem))] -translate-x-1/2 items-center justify-around rounded-full border border-[#D8CDBB] bg-white/90 px-5 py-3 shadow-2xl shadow-[#344E41]/12 backdrop-blur md:flex lg:hidden">
    <a href="/dashboard" class="flex flex-col items-center gap-1 text-xs font-bold text-[#2F654D]">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3 3 10.5V21h6v-6h6v6h6V10.5L12 3Z"/></svg>
      Beranda
    </a>
    <a href="/statistics" class="flex flex-col items-center gap-1 text-xs font-bold text-[#244338]/58">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Statistik
    </a>
    <a href="/dashboard" class="-mt-10 grid h-16 w-16 place-items-center rounded-full bg-[#4F7F53] text-white shadow-xl shadow-[#4F7F53]/30">
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </a>
    <a href="/achievements" class="flex flex-col items-center gap-1 text-xs font-bold text-[#244338]/58">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.2l-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      Badge
    </a>
    <a href="/profile" class="flex flex-col items-center gap-1 text-xs font-bold text-[#244338]/58">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM5 21a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Profil
    </a>
  </nav>

  <div
    class="fixed inset-0 z-[90] hidden items-center justify-center px-4 py-3 sm:py-4"
    data-hijri-calendar-modal
    data-hijri-calendar-endpoint="/dashboard/hijri-calendar"
    data-hijri-calendar-month="<%= hijriCalendar.monthNumber || '' %>"
    data-hijri-calendar-year="<%= hijriCalendar.year || '' %>"
  >
    <div class="absolute inset-0 bg-[#244338]/55 backdrop-blur-sm" data-hijri-calendar-overlay></div>
    <section class="relative z-10 w-full max-w-[780px] rounded-[1.75rem] border border-[#D8CDBB] bg-[#FFFDF8] p-3.5 shadow-2xl shadow-[#244338]/20 sm:p-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.24em] text-[#B7792D]">Kalender Hijriyah</p>
          <h3 class="mt-1.5 text-lg font-black text-[#244338] sm:text-[1.35rem]" data-hijri-calendar-month><%= hijriCalendar.monthLabel %></h3>
          <p class="mt-1 text-xs text-[#244338]/65 sm:text-sm" data-hijri-calendar-today><%= hijriToday %></p>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="grid h-10 w-10 place-items-center rounded-full border border-[#D8CDBB] bg-white text-[#244338]/70 transition hover:bg-[#F6F1E9] disabled:cursor-not-allowed disabled:opacity-40"
            data-hijri-calendar-prev
            aria-label="Bulan sebelumnya"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 19 8 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="grid h-10 w-10 place-items-center rounded-full border border-[#D8CDBB] bg-white text-[#244338]/70 transition hover:bg-[#F6F1E9] disabled:cursor-not-allowed disabled:opacity-40"
            data-hijri-calendar-next
            aria-label="Bulan berikutnya"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="grid h-10 w-10 place-items-center rounded-full border border-[#D8CDBB] bg-white text-[#244338]/70 transition hover:bg-[#F6F1E9]" data-close-hijri-calendar>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 18 18 6M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="mt-3 grid grid-cols-7 gap-1 text-center text-[10px] font-bold uppercase tracking-[0.12em] text-[#244338]/45 sm:gap-1 sm:text-[10px]">
        <% ["Sen", "Sel", "Rab", "Kam", "Jum", "Sab", "Min"].forEach((dayLabel) => { %>
          <span class="py-1"><%= dayLabel %></span>
        <% }) %>
      </div>

      <div class="mt-1.5 grid grid-cols-7 gap-1" data-hijri-calendar-grid>
        <% if (hijriCalendar.entries.length) { %>
          <% hijriCalendar.entries.forEach((entry) => { %>
            <div class="<%= entry.isCurrentMonth ? 'border-[#D8CDBB] bg-white' : 'border-[#E7DED1] bg-[#F8F3EB]' %> <%= entry.isToday ? 'border-[#4F7F53] bg-[#EEF6EA] shadow-sm' : '' %> min-h-[60px] rounded-[0.95rem] border p-2 transition sm:min-h-[64px]">
              <div class="flex items-start justify-between gap-2">
                <span class="<%= entry.isToday ? 'text-[#4F7F53]' : entry.isCurrentMonth ? 'text-[#244338]' : 'text-[#244338]/35' %> text-sm font-black sm:text-base"><%= entry.day %></span>
                <% if (entry.isToday) { %>
                  <span class="rounded-full bg-[#4F7F53] px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.08em] text-white">Hari ini</span>
                <% } %>
              </div>
              <p class="mt-1.5 text-[9px] font-semibold uppercase tracking-[0.08em] sm:text-[10px] <%= entry.isToday ? 'text-[#588157]' : entry.isCurrentMonth ? 'text-[#B7792D]' : 'text-[#B7792D]/45' %>"><%= entry.gregorianLabel %></p>
              <% if (entry.holidays?.length) { %>
                <p class="mt-0.5 line-clamp-1 text-[9px] leading-3 text-[#244338]/48 sm:text-[10px]"><%= entry.holidays[0] %></p>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-span-7 rounded-[1.25rem] border border-dashed border-[#D8CDBB] bg-[#F8F3EB] px-4 py-8 text-center text-sm text-[#244338]/58">
            Kalender Hijriyah belum tersedia untuk ditampilkan.
          </div>
        <% } %>
      </div>

      <div class="mt-5 flex justify-end">
        <button type="button" class="inline-flex items-center gap-2 rounded-full bg-[#4F7F53] px-4 py-2 text-sm font-bold text-white transition hover:bg-[#D4A373] hover:text-[#244338]" data-close-hijri-calendar>
          Tutup
        </button>
      </div>
    </section>
  </div>

  <div class="fixed inset-0 z-[95] hidden items-center justify-center px-4 py-6" data-prayer-alert-modal>
    <div class="absolute inset-0 bg-[#244338]/62 backdrop-blur-sm" data-prayer-alert-overlay></div>
    <section class="relative z-10 w-full max-w-lg overflow-hidden rounded-[2rem] border border-[#D8CDBB] bg-[#FFFDF8] shadow-2xl shadow-[#244338]/25">
      <div class="relative bg-[#2F5946] px-6 py-7 text-white">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(212,163,115,0.28),_transparent_38%)]"></div>
        <div class="relative z-10 flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-[#D9E7D1]">Waktu Salat Tiba</p>
            <h3 class="mt-3 text-3xl font-black" data-prayer-alert-title>Sudah masuk waktu salat</h3>
            <p class="mt-2 text-sm text-white/76" data-prayer-alert-subtitle>Semoga dimudahkan untuk segera menunaikannya.</p>
          </div>
          <div class="grid h-14 w-14 place-items-center rounded-full bg-white/10 text-[#D4A373]">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3a5 5 0 0 1 5 5v2.5c0 .9.3 1.7.9 2.3l.8.8c.4.4.1 1.1-.5 1.1H5.8c-.6 0-.9-.7-.5-1.1l.8-.8c.6-.6.9-1.4.9-2.3V8a5 5 0 0 1 5-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M9.5 18a2.5 2.5 0 0 0 5 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="p-6">
        <div class="rounded-[1.5rem] border border-[#D8CDBB] bg-[#F6F1E9]/70 p-5">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-[#244338]/60">Salat</p>
              <p class="mt-1 text-2xl font-black text-[#244338]" data-prayer-alert-name><%= nextPrayer.name %></p>
            </div>
            <div class="text-right">
              <p class="text-sm font-semibold text-[#244338]/60">Jam</p>
              <p class="mt-1 text-2xl font-black text-[#2F654D]" data-prayer-alert-time><%= nextPrayer.time || "--:--" %></p>
            </div>
          </div>
          <p class="mt-4 text-sm leading-7 text-[#244338]/68">
            Popup ini akan muncul sekali setiap kali masuk waktu salat pada halaman yang sedang terbuka.
          </p>
        </div>

        <div class="mt-5 flex flex-wrap gap-3">
          <button type="button" class="inline-flex items-center gap-2 rounded-full border border-[#D8CDBB] bg-white px-5 py-3 text-sm font-bold text-[#244338] transition hover:bg-[#F6F1E9]" data-prayer-alert-close>
            Tutup
          </button>
        </div>
      </div>
    </section>
  </div>
</main>
