<%
  const progressPercent = totalToday > 0 ? Math.round((todayCompleted / totalToday) * 100) : 0;
  const safeDailyHadis = typeof dailyHadis !== "undefined" ? dailyHadis : null;
  const safeFavoriteMotivation = typeof favoriteMotivation !== "undefined" ? favoriteMotivation : null;
  const remainingToday = Math.max(totalToday - todayCompleted, 0);
  const isDailyComplete = todayCompleted === totalToday;
  const weeklyDays = Array.isArray(weeklyBreakdown) ? weeklyBreakdown : [];
  const completedLabel = isDailyComplete
    ? "Luar biasa! Semua target hari ini selesai."
    : `${remainingToday} salat lagi untuk menyelesaikan target hari ini.`;
  const levelBase = typeof currentLevelBase === "number" ? currentLevelBase : (level - 1) * 100;
  const levelTarget = typeof nextLevelTarget === "number" ? nextLevelTarget : level * 100;
  const levelRange = Math.max(levelTarget - levelBase, 1);
  const levelProgress = Math.min(100, Math.max(0, Math.round(((xp - levelBase) / levelRange) * 100)));
  const totalSalatDone = typeof totalCompletedSalat === "number" ? totalCompletedSalat : todayCompleted;
  const bonusXp = typeof dailyBonusXp === "number" ? dailyBonusXp : 50;
  const safeSunnahChecklist = Array.isArray(sunnahChecklist) ? sunnahChecklist : [];
  const sunnahCompleted = typeof todaySunnahCompleted === "number"
    ? todaySunnahCompleted
    : safeSunnahChecklist.filter((item) => Boolean(todayState?.[item.key])).length;
  const sunnahTotal = typeof totalSunnahToday === "number" ? totalSunnahToday : safeSunnahChecklist.length;
  const todayFardhuXpValue = typeof todayFardhuXp === "number" ? todayFardhuXp : todayCompleted * 10;
  const todaySunnahXpValue = typeof todaySunnahXp === "number" ? todaySunnahXp : Math.min(sunnahCompleted * 3, 15);
  const todayXpValue = typeof todayXp === "number" ? todayXp : todayFardhuXpValue + todaySunnahXpValue;
  const sunnahXpPerItem = typeof sunnahXpPerPrayer === "number" ? sunnahXpPerPrayer : 3;
  const sunnahXpLimit = typeof maxSunnahXpPerDay === "number" ? maxSunnahXpPerDay : 15;
  const sunnahXpLabel = `Setiap sunnah +${sunnahXpPerItem} XP, total maksimal ${sunnahXpLimit} XP/hari`;
  const todayDate = new Date().toLocaleDateString("id-ID", {
    weekday: "long",
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
  const safeHijriData = hijriData || {};
  const hijriToday = safeHijriData.today?.fullLabel || "";
  const hijriTodaySpecials = Array.isArray(safeHijriData.today?.holidays) ? safeHijriData.today.holidays : [];
  const hijriTodaySpecial = hijriTodaySpecials[0] || null;
  const hijriCalendar = safeHijriData.calendar || { monthLabel: "Kalender Hijriyah", entries: [] };
  const hijriWarning = safeHijriData.warning || null;
  const hijriSourceName = safeHijriData.sourceName || null;
  const dashboardHeaderQuotes = [
    {
      text: "Amalan yang paling dicintai Allah adalah yang dikerjakan terus-menerus walaupun sedikit.",
      source: "HR. Bukhari & Muslim",
    },
    {
      text: "Sesungguhnya Allah beserta orang-orang yang sabar.",
      source: "QS. Al-Baqarah: 153",
    },
    {
      text: "Dan sembahlah Tuhanmu sampai datang kepadamu yang diyakini (ajal).",
      source: "QS. Al-Hijr: 99",
    },
    {
      text: "Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain).",
      source: "QS. Ash-Sharh: 7",
    },
    {
      text: "Bahwa manusia hanya memperoleh apa yang telah diusahakannya.",
      source: "QS. An-Najm: 39",
    },
    {
      text: "Mukmin yang kuat lebih Allah cintai daripada mukmin yang lemah, dan pada keduanya ada kebaikan.",
      source: "HR. Muslim",
    },
    {
      text: "Sesungguhnya bersama kesulitan ada kemudahan.",
      source: "QS. Ash-Sharh: 6",
    },
  ];
  const dashboardQuoteDateKey = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Jakarta" }).format(new Date());
  const dashboardQuoteSeed = dashboardQuoteDateKey
    .split("-")
    .reduce((sum, part) => sum + Number(part), 0);
  const dashboardHeaderQuote = dashboardHeaderQuotes[dashboardQuoteSeed % dashboardHeaderQuotes.length];
  const prayerIconPaths = {
    shubuh: '<path d="M4 15a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 3v3M5.6 6.6l2.1 2.1M18.4 6.6l-2.1 2.1M3 15h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
    dzuhur: '<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
    ashar: '<path d="M4 15a8 8 0 0 0 16 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 8v3M5.6 17.4l2.1-2.1M18.4 17.4l-2.1-2.1M3 15h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
    maghrib: '<path d="M4 16h16M7 13a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 4v2M5 9l1.5 1M19 9l-1.5 1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
    isya: '<path d="M18 15.5A7 7 0 0 1 8.5 6 7.5 7.5 0 1 0 18 15.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  };
  const achievementCards = [
    { name: "Perfect Day", desc: "Selesaikan 5 salat dalam sehari", unlocked: isDailyComplete, icon: "star" },
    { name: "Istiqomah 7 Hari", desc: "7 hari berturut-turut tanpa bolong", unlocked: streak >= 7, icon: "user" },
    { name: "Subuh Warrior", desc: "Catat Subuh tepat waktu", unlocked: Boolean(todayState.shubuh), icon: "moon" },
  ];
%>

<main class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-4 pb-28 pt-5 text-[#244338] sm:px-6 lg:py-6" data-streak-complete="<%= isDailyComplete ? 'true' : 'false' %>" data-streak-count="<%= streak %>" data-dashboard-root>
  <section class="grid gap-5 lg:grid-cols-[minmax(0,1.48fr)_minmax(340px,0.72fr)]">
    <div class="order-2 flex flex-col gap-5 lg:order-1">
      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.10)] sm:p-6">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <p class="text-sm font-bold text-[#2F654D]">Assalamu'alaikum, <%= userName %></p>
            <h1 class="mt-4 text-4xl font-black leading-tight text-[#244338] sm:text-5xl">Dashboard Harian</h1>
            <p class="mt-3 text-base text-[#244338]/70">Catat dan jaga konsistensi salatmu setiap hari.</p>
            <div class="relative mt-5 max-w-2xl overflow-hidden rounded-3xl border border-[#D4A373]/38 bg-[linear-gradient(145deg,#FFFDF8_0%,#F8F2E7_100%)] p-4 shadow-[0_14px_30px_rgba(36,67,56,0.08)] sm:p-5">
              <div class="pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full bg-[#D4A373]/16 blur-2xl"></div>
              <div class="relative flex items-start gap-3">
                <span class="mt-1 grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-[#D4A373]/16 text-[#B7792D]">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 11H5.5c0-2.9 1.6-4.9 4.4-5.9M18.5 11H15c0-2.9 1.6-4.9 4.4-5.9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M6.4 11c0 5.2 2 7.9 5.5 7.9M15.9 11c0 5.2 2 7.9 5.5 7.9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </span>
                <p class="text-base font-medium italic leading-8 text-[#1f3b31] sm:text-[1.08rem]" style="font-family: 'Amiri', serif;">"<%= dashboardHeaderQuote.text %>"</p>
              </div>
              <p class="relative mt-4 inline-flex rounded-full border border-[#A3B18A]/45 bg-white/80 px-3 py-1 text-xs font-black uppercase tracking-wide text-[#2F654D]/82"><%= dashboardHeaderQuote.source %></p>
            </div>
          </div>

          <div class="flex w-full items-center justify-between gap-4 rounded-3xl border border-[#D4A373]/35 bg-[#FFF9F0] p-4 shadow-sm lg:w-44 lg:flex-col lg:text-center">
            <div class="flex items-center gap-2 lg:flex-col">
              <span class="grid h-9 w-9 place-items-center rounded-2xl bg-[#D4A373]/18 text-[#D4A373]">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 22c3.6 0 6.5-2.5 6.5-6.1 0-2.6-1.5-4.6-3.2-6.4-.9 2.1-2.3 3.1-3.9 3.4.7-2.4.1-5.1-2.5-7.9-.4 3.1-2.1 5-3.2 6.5-1 1.3-1.7 2.6-1.7 4.4C4 19.5 6.9 22 10.5 22H12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
              </span>
              <p class="text-sm font-black text-[#244338]">Streak-mu</p>
            </div>
            <div>
              <p class="text-5xl font-black leading-none text-[#2F654D]" data-dashboard-streak><%= streak %></p>
              <p class="mt-1 text-sm font-bold text-[#244338]">hari</p>
              <p class="mt-2 rounded-full bg-[#EDE5D8] px-3 py-1 text-xs font-bold text-[#244338]/70" data-dashboard-longest-streak>Terbaik: <%= longestStreak || streak %> hari</p>
            </div>
          </div>
        </div>

        <div class="mt-8 border-t border-[#D8CDBB] pt-5">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-bold text-[#244338]/78">Target 5 Salat</p>
            <div class="flex items-center gap-4">
              <p class="text-2xl font-black text-[#2F654D]" data-dashboard-progress-percent><%= progressPercent %>%</p>
              <p class="text-sm font-semibold text-[#244338]/70" data-dashboard-progress-label><%= completedLabel %></p>
            </div>
          </div>
          <div class="mt-3 h-3 overflow-hidden rounded-full bg-[#EDE5D8]">
            <div class="dashboard-progress h-full rounded-full bg-[#4F7F53]" style="--progress-width: <%= progressPercent %>%; width: <%= progressPercent %>%" data-dashboard-progress-bar></div>
          </div>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-[#D8CDBB] bg-[#FFF9F0] p-4">
            <p class="text-sm font-semibold text-[#244338]/62">XP Hari Ini</p>
            <div class="mt-3 flex items-center justify-between">
              <div>
                <p class="text-2xl font-black text-[#2F654D]" data-dashboard-xp-today><%= todayXpValue %> XP</p>
                <p class="mt-1 text-xs font-bold text-[#244338]/52" data-dashboard-xp-breakdown>Wajib <%= todayFardhuXpValue %> + Sunnah <%= todaySunnahXpValue %></p>
              </div>
              <span class="grid h-11 w-11 place-items-center rounded-full bg-[#D4A373]/18 text-[#B7792D]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 10-13h-7l1-7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </article>

          <article class="rounded-2xl border border-[#D8CDBB] bg-[#FFF9F0] p-4">
            <p class="text-sm font-semibold text-[#244338]/62">Level</p>
            <div class="mt-3 flex items-center justify-between">
              <p class="text-2xl font-black text-[#2F654D]" data-dashboard-level><%= level %></p>
              <span class="grid h-11 w-11 place-items-center rounded-full bg-[#A3B18A]/22 text-[#4F7F53]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4 7l8 4 8-4-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m4 12 8 4 8-4M4 17l8 4 8-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </article>

          <article class="rounded-2xl border border-[#D8CDBB] bg-[#FFF9F0] p-4">
            <p class="text-sm font-semibold text-[#244338]/62">Salat Terlaksana</p>
            <div class="mt-3 flex items-center justify-between">
              <p class="text-2xl font-black text-[#2F654D]" data-dashboard-salat-done><%= todayCompleted %> / <%= totalToday %></p>
              <span class="grid h-11 w-11 place-items-center rounded-full bg-[#A3B18A]/22 text-[#2F654D]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </article>

          <article class="rounded-2xl border border-[#D8CDBB] bg-[#FFF9F0] p-4">
            <p class="text-sm font-semibold text-[#244338]/62">Total XP</p>
            <div class="mt-3 flex items-center justify-between">
              <p class="text-2xl font-black text-[#2F654D]" data-dashboard-total-xp><%= xp %> XP</p>
              <span class="grid h-11 w-11 place-items-center rounded-full bg-[#D4A373]/22 text-[#B7792D]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.2l-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </article>
        </div>
      </section>

      <% if (safeDailyHadis) { %>
      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#E2C6A8] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)] sm:p-6">
        <div class="flex items-start gap-4">
          <div class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-[#D4A373]/18 text-[#B7792D]">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-black uppercase tracking-wide text-[#B7792D]">Hadis Penyemangat Hari Ini</p>
            <p class="mt-3 text-base leading-7 text-[#244338]/78">"<%= safeDailyHadis.id.length > 210 ? safeDailyHadis.id.substring(0, 210) + '...' : safeDailyHadis.id %>"</p>
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <span class="rounded-full border border-[#D4A373]/35 bg-[#D4A373]/10 px-4 py-1.5 text-xs font-bold text-[#B7792D]">HR. <%= safeDailyHadis.name %> No. <%= safeDailyHadis.number %></span>
              <a href="/hadis/<%= safeDailyHadis.slug %>/<%= safeDailyHadis.number %>" class="text-sm font-black text-[#2F654D] transition hover:text-[#B7792D]">Baca selengkapnya -></a>
            </div>
          </div>
        </div>
      </section>
      <% } %>

      <% if (safeFavoriteMotivation) { %>
      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#A3B18A]/40 bg-[#F6F1E9] p-5 shadow-[0_18px_45px_rgba(52,78,65,0.07)] sm:p-6">
        <div class="flex items-start gap-4">
          <div class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-[#588157]/12 text-[#588157]">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.2l-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-black uppercase tracking-wide text-[#588157]">Favorit Pengingatmu</p>
            <h3 class="mt-2 text-lg font-black text-[#244338]"><%= safeFavoriteMotivation.title %></h3>
            <p class="mt-3 line-clamp-3 text-sm leading-7 text-[#244338]/75"><%= safeFavoriteMotivation.content %></p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <span class="rounded-full border border-[#A3B18A]/40 bg-white/70 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-[#588157]"><%= safeFavoriteMotivation.type %></span>
              <% if (safeFavoriteMotivation.sourceUrl) { %>
                <a href="<%= safeFavoriteMotivation.sourceUrl %>" class="text-sm font-black text-[#2F654D] transition hover:text-[#B7792D]">Buka kembali -></a>
              <% } %>
            </div>
          </div>
        </div>
      </section>
      <% } %>

      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)] sm:p-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-2xl font-black text-[#244338]">Checklist Salat</h2>
            <p class="mt-1 text-sm text-[#244338]/66">Catat setelah masuk waktu dan salat selesai.</p>
          </div>
          <span class="inline-flex w-fit items-center gap-2 rounded-full border border-[#D8CDBB] bg-[#FFF9F0] px-4 py-2 text-sm font-bold text-[#2F654D]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Kalender
          </span>
        </div>

        <div class="mt-5 grid gap-3" data-prayer-checklist>
          <% checklist.forEach((item, index) => { %>
            <% const isDone = Boolean(todayState[item.key]); %>
            <% const isLocked = !isDone && !item.isAvailable; %>
            <form method="POST" action="/dashboard/prayer/<%= item.key %>/complete" data-prayer-check-form data-prayer-key="<%= item.key %>" data-prayer-label="<%= item.label %>" data-prayer-completed="<%= isDone ? 'true' : 'false' %>" data-prayer-available="<%= item.isAvailable ? 'true' : 'false' %>" data-prayer-ready-note="Sudah masuk waktu, catat setelah selesai salat." class="<%= isDone ? 'border-[#BFD2B1] bg-[#F2F7EC]' : isLocked ? 'border-[#E2D8C8] bg-[#FFF9F0]' : 'border-[#C9D7B8] bg-[#F8FBF3]' %> dashboard-check-row grid gap-3 rounded-2xl border p-3 transition hover:-translate-y-0.5 hover:shadow-md hover:shadow-[#344E41]/8 sm:grid-cols-[auto_1fr_auto_auto] sm:items-center">
              <div data-prayer-index-pill class="<%= isDone ? 'bg-[#4F7F53] text-white' : 'bg-white text-[#4F7F53]' %> grid h-10 w-10 place-items-center rounded-full border border-[#C9D7B8] text-sm font-black"><%= index + 1 %></div>

              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-lg font-black text-[#244338]"><%= item.label %></p>
                  <svg data-prayer-icon class="<%= isDone ? 'text-[#4F7F53]' : 'text-[#A3B18A]' %> h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><%- prayerIconPaths[item.key] %></svg>
                  <span class="text-base font-semibold text-[#244338]/72" data-prayer-time-label><%= item.time %></span>
                  <% if (isDone) { %>
                    <span data-prayer-status-badge class="rounded-full bg-[#4F7F53] px-3 py-1 text-xs font-black text-white">Selesai</span>
                  <% } else if (isLocked) { %>
                    <span data-prayer-status-badge class="rounded-full bg-[#EDE5D8] px-3 py-1 text-xs font-black text-[#244338]/58">Belum masuk waktu</span>
                  <% } else { %>
                    <span data-prayer-status-badge class="rounded-full bg-[#A3B18A]/24 px-3 py-1 text-xs font-black text-[#2F654D]">Siap dicatat</span>
                  <% } %>
                </div>
                <p class="mt-1 text-sm text-[#244338]/60" data-prayer-note>
                  <% if (isDone) { %>
                    Dicatat jam <%= todayState[item.key] %>
                  <% } else if (isLocked) { %>
                    Tombol aktif setelah jam <%= item.time %>.
                  <% } else { %>
                    Sudah masuk waktu, catat setelah selesai salat.
                  <% } %>
                </p>
              </div>

              <button type="submit" data-prayer-submit class="<%= isDone || isLocked ? 'hidden' : 'bg-[#4F7F53] text-white shadow-sm shadow-[#4F7F53]/20 hover:bg-[#3E6A43]' %> rounded-full px-5 py-2.5 text-sm font-black transition" <%= isDone || isLocked ? "disabled" : "" %>>
                Checklist
              </button>

              <div data-prayer-check-indicator class="<%= isDone ? 'bg-[#4F7F53] text-white' : 'bg-white text-[#A3B18A]' %> grid h-9 w-9 place-items-center rounded-full border border-[#C9D7B8] sm:justify-self-end">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </form>
          <% }) %>
        </div>

        <% if (isDailyComplete) { %>
          <div class="mt-4 flex flex-col gap-3 rounded-2xl border border-[#E2C6A8] bg-[#FFF9F0] p-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="text-lg font-black text-[#2F654D]">MashaAllah!</p>
              <p class="mt-1 text-sm text-[#244338]/66">Kamu sudah menyelesaikan semua salat hari ini.</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="text-right">
                <p class="text-xs font-bold text-[#244338]/62">Bonus XP</p>
                <p class="text-xl font-black text-[#2F654D]">+<%= bonusXp %> XP</p>
              </div>
              <span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#D4A373]/18 text-[#B7792D]">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12v8H4v-8M2 7h20v5H2V7ZM12 20V7M12 7H8.5A2.5 2.5 0 1 1 11 4.5L12 7Zm0 0h3.5A2.5 2.5 0 1 0 13 4.5L12 7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>
        <% } %>
      </section>

      <% if (safeSunnahChecklist.length) { %>
      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)] sm:p-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-2xl font-black text-[#244338]">Checklist Sholat Sunnah</h2>
            <p class="mt-1 text-sm text-[#244338]/66">Tambahan ibadah harian, opsional dan fleksibel. <%= sunnahXpLabel %>.</p>
          </div>
          <span class="inline-flex w-fit items-center gap-2 rounded-full border border-[#D8CDBB] bg-[#FFF9F0] px-4 py-2 text-sm font-bold text-[#2F654D]" data-dashboard-sunnah-summary>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 15.5A7 7 0 0 1 8.5 6 7.5 7.5 0 1 0 18 15.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <span data-dashboard-sunnah-done><%= sunnahCompleted %></span>/<span data-dashboard-sunnah-total><%= sunnahTotal %></span> tercatat
          </span>
        </div>

        <div class="mt-5 grid gap-3">
          <% safeSunnahChecklist.forEach((item, index) => { %>
            <% const isDone = Boolean(todayState[item.key]); %>
            <form method="POST" action="/dashboard/prayer/<%= item.key %>/complete" data-prayer-check-form data-prayer-key="<%= item.key %>" data-prayer-label="<%= item.label %>" data-prayer-completed="<%= isDone ? 'true' : 'false' %>" data-prayer-available="true" data-prayer-ready-note="Waktu anjuran: <%= item.note %>." class="<%= isDone ? 'border-[#BFD2B1] bg-[#F2F7EC]' : 'border-[#C9D7B8] bg-[#F8FBF3]' %> dashboard-check-row grid gap-3 rounded-2xl border p-3 transition hover:-translate-y-0.5 hover:shadow-md hover:shadow-[#344E41]/8 sm:grid-cols-[auto_1fr_auto_auto] sm:items-center">
              <div data-prayer-index-pill class="<%= isDone ? 'bg-[#4F7F53] text-white' : 'bg-white text-[#4F7F53]' %> grid h-10 w-10 place-items-center rounded-full border border-[#C9D7B8] text-sm font-black"><%= checklist.length + index + 1 %></div>

              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-lg font-black text-[#244338]"><%= item.label %></p>
                  <svg data-prayer-icon class="<%= isDone ? 'text-[#4F7F53]' : 'text-[#A3B18A]' %> h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 15.5A7 7 0 0 1 8.5 6 7.5 7.5 0 1 0 18 15.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  <span class="text-base font-semibold text-[#244338]/72" data-prayer-time-label><%= item.time %></span>
                  <% if (isDone) { %>
                    <span data-prayer-status-badge class="rounded-full bg-[#4F7F53] px-3 py-1 text-xs font-black text-white">Selesai</span>
                  <% } else { %>
                    <span data-prayer-status-badge class="rounded-full bg-[#A3B18A]/24 px-3 py-1 text-xs font-black text-[#2F654D]">Siap dicatat</span>
                  <% } %>
                </div>
                <p class="mt-1 text-sm text-[#244338]/60" data-prayer-note>
                  <% if (isDone) { %>
                    Dicatat jam <%= todayState[item.key] %>
                  <% } else { %>
                    Waktu anjuran: <%= item.note %>.
                  <% } %>
                </p>
              </div>

              <button type="submit" data-prayer-submit class="<%= isDone ? 'hidden' : 'bg-[#4F7F53] text-white shadow-sm shadow-[#4F7F53]/20 hover:bg-[#3E6A43]' %> rounded-full px-5 py-2.5 text-sm font-black transition" <%= isDone ? "disabled" : "" %>>
                Checklist
              </button>

              <div data-prayer-check-indicator class="<%= isDone ? 'bg-[#4F7F53] text-white' : 'bg-white text-[#A3B18A]' %> grid h-9 w-9 place-items-center rounded-full border border-[#C9D7B8] sm:justify-self-end">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </form>
          <% }) %>
        </div>
      </section>
      <% } %>
    </div>

    <aside class="order-1 flex flex-col gap-5 lg:order-2">
      <section
        class="dashboard-card-enter relative overflow-hidden rounded-[1.75rem] bg-[#2F5946] p-6 text-white shadow-[0_18px_45px_rgba(52,78,65,0.18)]"
        data-prayer-countdown
        data-prayer-time="<%= nextPrayer.time || '' %>"
        data-prayer-name="<%= nextPrayer.name %>"
        data-prayer-tomorrow="<%= nextPrayer.isTomorrow ? 'true' : 'false' %>"
        data-prayer-timeline='<%- JSON.stringify(prayerTimeline || []) %>'
        data-imsak-timeline='<%- JSON.stringify(imsakReminderTimeline || []) %>'
      >
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_18%,rgba(212,163,115,0.28),transparent_22%),linear-gradient(135deg,rgba(255,255,255,0.07),transparent_45%)]"></div>
        <div class="pointer-events-none absolute right-5 top-8 h-16 w-16 rounded-full bg-[#D4A373] shadow-[0_0_40px_rgba(212,163,115,0.38)]"></div>
        <div class="pointer-events-none absolute right-10 top-6 h-16 w-16 rounded-full bg-[#2F5946]"></div>
        <div class="relative z-10">
          <p class="text-sm font-bold text-[#C9D7B8]">Shalat Berikutnya</p>
          <h2 class="mt-3 text-4xl font-black" data-next-prayer-name><%= nextPrayer.name %></h2>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <p class="text-base text-white/82"><%= todayDate %></p>
            <span class="rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-semibold text-[#D9E7D1]"><%= hijriToday %></span>
          </div>
          <% if (prayerLocationLabel) { %>
            <p class="mt-1 text-sm text-white/65"><%= prayerLocationLabel %></p>
          <% } %>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button
              type="button"
              class="relative z-20 inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/10 px-4 py-2 text-sm font-bold text-white transition hover:bg-white/16"
              data-open-hijri-calendar
            >
              <svg class="h-4 w-4 text-[#D4A373]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              Kalender Hijriyah
            </button>
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-white/55">Tanggal Islam hari ini</span>
          </div>
          <% if (hijriTodaySpecial) { %>
            <div class="mt-3 inline-flex max-w-full items-start gap-2 rounded-2xl border border-[#D4A373]/25 bg-[#D4A373]/12 px-3 py-2 text-left text-sm text-[#F6E6CF]">
              <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#D4A373]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m12 3 2.2 4.4 4.8.7-3.5 3.4.8 4.8L12 14.8 7.7 17l.8-4.8L5 8.8l4.8-.7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
              <div class="min-w-0">
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#D4A373]">Momen Hijriyah</p>
                <p class="mt-1 line-clamp-2 text-sm font-semibold text-[#F6E6CF]"><%= hijriTodaySpecial %></p>
              </div>
            </div>
          <% } %>
          <% if (nextPrayer.time) { %>
            <p class="mt-5 text-4xl font-black text-[#D4A373]" data-countdown-display>--:--:--</p>
            <p class="mt-1 text-sm font-semibold text-white/72" data-countdown-label>Menuju adzan <%= nextPrayer.name %></p>
          <% } %>

          <div class="relative z-10 mt-8 grid grid-cols-2 gap-3">
            <div class="min-w-0 rounded-[1.35rem] border border-white/10 bg-white/12 px-4 py-3.5 backdrop-blur">
              <p class="text-xs font-bold text-white/62">Waktu</p>
              <p class="mt-1 break-words text-xl font-black leading-tight" data-next-prayer-time><%= nextPrayer.time || "-" %></p>
            </div>
            <div class="min-w-0 rounded-[1.35rem] border border-white/10 bg-white/12 px-4 py-3.5 backdrop-blur">
              <p class="text-xs font-bold text-white/62">Status</p>
              <p class="mt-1 break-words text-xl font-black leading-tight" data-next-prayer-status><%= nextPrayer.isTomorrow ? "Besok" : "Berjalan" %></p>
            </div>
          </div>

        </div>
      </section>

      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-[#588157]">Streak Protection</p>
            <h3 class="mt-2 text-xl font-black text-[#244338]">
              <%= restoreChallengeActive ? "Restore Challenge Aktif" : "Nyawa Streak" %>
            </h3>
            <p class="mt-2 text-sm leading-6 text-[#244338]/64">
              <% if (restoreChallengeActive) { %>
                Selesaikan trial hari ini: 5/5 salat, minimal 3 tepat waktu, dan baca hadis penyemangat.
              <% } else if (streakProtection > 0) { %>
                Miss 1 salat masih bisa dilindungi. Protection dipakai otomatis saat hari berakhir 4/5.
              <% } else { %>
                Protection habis. Restore challenge akan aktif agar streak bisa diselamatkan lagi.
              <% } %>
            </p>
          </div>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-[#A3B18A]/20 text-[#2F654D]">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3 5 6v5c0 4.5 2.9 8.5 7 10 4.1-1.5 7-5.5 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M8.5 12.2 11 14.7l4.7-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <% for (let i = 1; i <= maxStreakProtection; i += 1) { %>
            <div class="<%= i <= streakProtection ? 'border-[#A3B18A] bg-[#F2F7EC] text-[#2F654D]' : 'border-[#E2D8C8] bg-[#F6F1E9] text-[#244338]/32' %> flex items-center justify-center rounded-2xl border px-4 py-3">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3 5 6v5c0 4.5 2.9 8.5 7 10 4.1-1.5 7-5.5 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </div>
          <% } %>
        </div>

        <% if (restoreChallengeActive) { %>
          <div class="mt-5 rounded-2xl border border-[#A3B18A]/35 bg-[#F2F7EC] p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-black text-[#244338]">Progress Trial</p>
              <p class="text-sm font-black text-[#2F654D]"><%= restoreChallengeProgress %>/<%= restoreChallengeTarget %></p>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-white">
              <div class="h-full rounded-full bg-[#588157]" style="width: <%= Math.min(Math.round((restoreChallengeProgress / restoreChallengeTarget) * 100), 100) %>%"></div>
            </div>
            <div class="mt-4 grid gap-2">
              <div class="flex items-center justify-between rounded-2xl bg-white/70 px-4 py-3">
                <span class="text-sm font-bold text-[#244338]">Salat hari ini 5/5</span>
                <span class="<%= restoreChallengeTasks.fullDayDone ? 'bg-[#588157] text-white' : 'bg-[#E2D8C8] text-[#244338]/58' %> rounded-full px-3 py-1 text-xs font-black">
                  <%= restoreChallengeTasks.completedCount %>/5
                </span>
              </div>
              <div class="flex items-center justify-between rounded-2xl bg-white/70 px-4 py-3">
                <span class="text-sm font-bold text-[#244338]">Minimal 3 tepat waktu</span>
                <span class="<%= restoreChallengeTasks.onTimeDone ? 'bg-[#588157] text-white' : 'bg-[#E2D8C8] text-[#244338]/58' %> rounded-full px-3 py-1 text-xs font-black">
                  <%= restoreChallengeTasks.onTimeCount %>/3
                </span>
              </div>
              <form action="/dashboard/restore/reflection" method="POST" class="flex items-center justify-between gap-3 rounded-2xl bg-white/70 px-4 py-3">
                <span class="text-sm font-bold text-[#244338]">Baca hadis penyemangat</span>
                <% if (restoreChallengeTasks.reflectionDone) { %>
                  <span class="rounded-full bg-[#588157] px-3 py-1 text-xs font-black text-white">Selesai</span>
                <% } else { %>
                  <button type="submit" class="rounded-full bg-[#588157] px-3 py-1 text-xs font-black text-white transition hover:bg-[#344E41]">
                    Tandai
                  </button>
                <% } %>
              </form>
            </div>
          </div>
        <% } %>
      </section>

      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]" data-qibla-compass data-prayer-location-sync="<%= prayerLocationSourceType === 'browser' ? 'ready' : 'pending' %>">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#D4A373]/18 text-[#B7792D]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z" stroke="currentColor" stroke-width="1.8"/>
                <path d="m15.5 8.5-2.2 5.1-4.8 1.9 2.2-5.1 4.8-1.9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <h3 class="text-xl font-black text-[#244338]">Arah Kiblat</h3>
              <p class="text-sm font-semibold text-[#244338]/58">Aktifkan lokasi untuk kompas.</p>
            </div>
          </div>
        </div>

        <div class="mt-5 flex justify-center">
          <svg viewBox="0 0 200 200" class="h-40 w-40 text-[#2F654D]" data-qibla-svg>
            <circle cx="100" cy="100" r="88" fill="#F6F1E9" stroke="#D8CDBB" stroke-width="2"/>
            <circle cx="100" cy="100" r="70" fill="none" stroke="#A3B18A" stroke-width="1" opacity="0.55"/>
            <text x="100" y="28" text-anchor="middle" fill="#244338" font-size="13" font-weight="800">N</text>
            <text x="100" y="184" text-anchor="middle" fill="#244338" font-size="13" font-weight="800" opacity="0.55">S</text>
            <text x="180" y="105" text-anchor="middle" fill="#244338" font-size="13" font-weight="800" opacity="0.55">E</text>
            <text x="20" y="105" text-anchor="middle" fill="#244338" font-size="13" font-weight="800" opacity="0.55">W</text>
            <g data-qibla-needle style="transform-origin:100px 100px;transition:transform 0.3s ease-out">
              <polygon points="100,30 91,102 109,102" fill="#D4A373"/>
              <polygon points="100,170 91,98 109,98" fill="#A3B18A"/>
              <circle cx="100" cy="100" r="8" fill="#D4A373"/>
              <circle cx="100" cy="100" r="3.5" fill="#244338"/>
              <g transform="translate(100,25)">
                <rect x="-8" y="-8" width="16" height="16" rx="2" fill="#244338"/>
                <rect x="-5" y="-2" width="10" height="7" rx="1" fill="#D4A373"/>
              </g>
            </g>
          </svg>
        </div>

        <p class="mt-1 text-center text-base font-black text-[#244338]" data-qibla-bearing>Mendeteksi lokasi...</p>
        <button class="mt-4 hidden w-full rounded-full bg-[#2F654D] px-4 py-3 text-sm font-black text-white transition hover:bg-[#D4A373] hover:text-[#244338]" data-qibla-permission-btn>
          Aktifkan Kompas
        </button>
      </section>

      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
        <div class="flex items-start gap-3">
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#D4A373]/18 text-[#B7792D]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22c3.6 0 6.5-2.5 6.5-6.1 0-2.6-1.5-4.6-3.2-6.4-.9 2.1-2.3 3.1-3.9 3.4.7-2.4.1-5.1-2.5-7.9-.4 3.1-2.1 5-3.2 6.5-1 1.3-1.7 2.6-1.7 4.4C4 19.5 6.9 22 10.5 22H12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </span>
          <div>
            <h3 class="text-xl font-black text-[#244338]">Kalender Streak</h3>
            <p class="text-base font-bold text-[#2F654D]"><%= streak %> hari berturut-turut</p>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-7 gap-2 text-center">
          <% weeklyDays.forEach((day) => { %>
            <div class="space-y-2">
              <p class="text-xs font-bold text-[#244338]/62"><%= day.label %></p>
              <p class="<%= day.isFull ? 'text-[#2F654D]' : day.completed > 0 ? 'text-[#B7792D]' : 'text-[#244338]/45' %> text-sm font-black"><%= new Date(day.date).getDate() %></p>
              <div class="<%= day.isFull ? 'border-[#4F7F53] bg-[#4F7F53] text-white' : day.completed > 0 ? 'border-[#D4A373] bg-[#D4A373]/14 text-[#B7792D]' : 'border-[#E2D8C8] bg-[#FFF9F0] text-[#A3B18A]' %> mx-auto grid h-8 w-8 place-items-center rounded-full border text-xs font-black">
                <% if (day.isFull) { %>
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <% } else { %>
                  <%= day.completed %>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
        <div class="flex items-center gap-4">
          <div class="grid h-20 w-20 shrink-0 place-items-center rounded-full border-4 border-[#D4A373] bg-[#2F654D] text-[#D4A373] shadow-lg shadow-[#D4A373]/20">
            <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4 7l8 4 8-4-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m4 12 8 4 8-4M4 17l8 4 8-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-black text-[#244338]" data-dashboard-level-heading>Level <%= level %></h3>
              <p class="text-sm font-bold text-[#244338]/72" data-dashboard-level-progress-label><%= xp %> / <%= levelTarget %> XP</p>
            </div>
            <p class="mt-1 text-sm text-[#244338]/64">Terus istiqomah untuk naik level.</p>
            <div class="mt-4 h-3 overflow-hidden rounded-full bg-[#EDE5D8]">
              <div class="dashboard-progress h-full rounded-full bg-[#4F7F53]" style="--progress-width: <%= levelProgress %>%; width: <%= levelProgress %>%" data-dashboard-level-progress-bar></div>
            </div>
          </div>
        </div>
      </section>

      <section class="dashboard-card-enter rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
