<main class="mx-auto mt-8 flex w-full max-w-5xl flex-col gap-5 px-4 pb-10 text-[#344E41] sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <p class="text-sm font-medium text-[#588157]">Hai, <%= userName %></p>
    <h1 class="mt-2 text-3xl font-bold text-[#344E41]">Dashboard Harian</h1>
    <p class="mt-2 text-[#344E41]/75">
      Waktu salat berikutnya: <strong class="text-[#588157]"><%= nextPrayer.name %></strong>
      <% if (nextPrayer.time) { %>jam <%= nextPrayer.time %><% } %>
    </p>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">XP</p>
        <p class="text-2xl font-bold text-[#588157]"><%= xp %></p>
      </div>
      <div class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Level</p>
        <p class="text-2xl font-bold text-[#588157]"><%= level %></p>
      </div>
      <div class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Streak Aktif</p>
        <p class="text-2xl font-bold text-[#588157]"><%= streak %> hari</p>
      </div>
      <div class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Hari ini</p>
        <p class="text-2xl font-bold text-[#588157]"><%= todayCompleted %> / <%= totalToday %></p>
      </div>
    </div>
  </section>

  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-bold text-[#344E41]">Checklist Salat 5 Waktu</h2>
      <% if (latestAchievement) { %>
        <span class="rounded-full bg-[#D4A373]/20 px-3 py-1 text-sm font-semibold text-[#344E41]"><%= latestAchievement %></span>
      <% } %>
    </div>
    <div class="mt-4 grid gap-3">
      <% checklist.forEach((item) => { %>
        <form method="POST" action="/dashboard/prayer/<%= item.key %>/complete" class="flex items-center justify-between gap-4 rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
          <div>
            <p class="font-semibold text-[#344E41]"><%= item.label %></p>
            <% if (todayState[item.key]) { %>
              <p class="text-xs font-medium text-[#588157]">Selesai jam <%= todayState[item.key] %></p>
            <% } else { %>
              <p class="text-xs text-[#344E41]/60">Belum dicentang</p>
            <% } %>
          </div>
          <button type="submit" class="rounded-full bg-[#588157] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#D4A373] hover:text-[#344E41] disabled:cursor-not-allowed disabled:bg-[#A3B18A]/50 disabled:text-[#344E41]/70" <%= todayState[item.key] ? "disabled" : "" %>>
            <%= todayState[item.key] ? "Done" : "Checklist" %>
          </button>
        </form>
      <% }) %>
    </div>
  </section>
</main>
