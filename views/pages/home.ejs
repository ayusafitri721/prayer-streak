<main class="-mt-px min-h-screen bg-[#F6F1E9] text-[#344E41]">
  <section class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-16">
    <div>
      <p class="inline-flex rounded-full border border-[#A3B18A]/60 bg-white/70 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-[#588157]">
        Habit tracker salat harian
      </p>
      <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-tight text-[#344E41] sm:text-5xl lg:text-6xl">
        Prayer Streak
      </h1>
      <p class="mt-5 max-w-2xl text-xl font-semibold leading-relaxed text-[#588157]">
        Bangun Konsistensi Salat dengan Streak, XP, dan Achievement
      </p>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[#344E41]/80">
        Prayer Streak membantu kamu mencatat salat 5 waktu, melihat progres harian, dan menjaga kebiasaan ibadah dengan pendekatan yang ringan, personal, dan tidak menghakimi.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/register" class="inline-flex rounded-full bg-[#588157] px-6 py-3 font-semibold text-white shadow-lg shadow-[#588157]/20 transition hover:bg-[#D4A373]">
          Mulai Tracking
        </a>
        <a href="/login" class="inline-flex rounded-full border border-[#588157]/30 bg-white/70 px-6 py-3 font-semibold text-[#344E41] transition hover:bg-[#A3B18A]/20">
          Login
        </a>
      </div>

    </div>

    <div class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/75 p-5 shadow-2xl shadow-[#344E41]/10">
      <div class="rounded-[1.5rem] bg-[#344E41] p-5 text-white">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-sm text-[#A3B18A]">Progress hari ini</p>
            <h2 class="mt-1 text-2xl font-bold">3 dari 5 salat</h2>
          </div>
          <span class="rounded-full bg-[#D4A373] px-3 py-1 text-sm font-semibold text-[#344E41]">Level 2</span>
        </div>

        <div class="mt-6 space-y-3">
          <% ["Shubuh", "Dzuhur", "Ashar", "Maghrib", "Isya"].forEach((prayer, index) => { %>
            <div class="flex items-center justify-between rounded-2xl bg-white/10 px-4 py-3">
              <span class="font-medium"><%= prayer %></span>
              <% if (index < 3) { %>
                <span class="rounded-full bg-[#A3B18A] px-3 py-1 text-xs font-semibold text-[#344E41]">Selesai</span>
              <% } else { %>
                <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/70">Belum</span>
              <% } %>
            </div>
          <% }) %>
        </div>

        <div class="mt-6 grid grid-cols-3 gap-3 text-center">
          <div class="rounded-2xl bg-white/10 p-3">
            <p class="text-xs text-[#A3B18A]">Streak</p>
            <p class="mt-1 text-xl font-bold">7</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-3">
            <p class="text-xs text-[#A3B18A]">XP</p>
            <p class="mt-1 text-xl font-bold">180</p>
          </div>
          <div class="rounded-2xl bg-white/10 p-3">
            <p class="text-xs text-[#A3B18A]">Badge</p>
            <p class="mt-1 text-xl font-bold">4</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>
