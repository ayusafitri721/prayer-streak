<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 text-[#344E41] sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <h1 class="text-3xl font-bold text-[#344E41]">Profile</h1>
    <p class="mt-2 text-[#344E41]/75">Informasi akun dan ringkasan progress.</p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Nama</p>
        <p class="mt-1 text-lg font-semibold text-[#344E41]"><%= user.name %></p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Email</p>
        <p class="mt-1 text-lg font-semibold text-[#344E41]"><%= user.email %></p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">XP</p>
        <p class="mt-1 text-lg font-semibold text-[#588157]"><%= profile.xp %></p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Level / Streak</p>
        <p class="mt-1 text-lg font-semibold text-[#588157]"><%= profile.level %> / <%= profile.streak %></p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4 sm:col-span-2">
        <p class="text-sm text-[#344E41]/60">Longest Streak</p>
        <p class="mt-1 text-lg font-semibold text-[#588157]"><%= profile.longestStreak %> hari</p>
      </article>
    </div>
  </section>

  <section class="mt-5 rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10" data-push-settings>
    <h2 class="text-2xl font-bold text-[#344E41]">Notifikasi Perangkat</h2>
    <p class="mt-2 text-sm text-[#344E41]/72">
      Notifikasi muncul di luar web (desktop/mobile) untuk pengingat waktu shalat dan motivasi harian.
    </p>

    <div class="mt-4 rounded-2xl border border-[#A3B18A]/35 bg-[#F6F1E9] px-4 py-3 text-sm text-[#344E41]/75" data-push-status>
      Belum aktif.
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="rounded-2xl border border-[#A3B18A]/35 bg-[#F6F1E9] p-4">
        <span class="text-sm font-semibold text-[#344E41]">Reminder waktu shalat</span>
        <select
          class="mt-2 w-full rounded-xl border border-[#A3B18A]/35 bg-white px-3 py-2 text-sm text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15"
          data-push-prayer-enabled
        >
          <option value="true" selected>Aktif</option>
          <option value="false">Nonaktif</option>
        </select>
      </label>

      <label class="rounded-2xl border border-[#A3B18A]/35 bg-[#F6F1E9] p-4">
        <span class="text-sm font-semibold text-[#344E41]">Motivasi ayat/hadis</span>
        <select
          class="mt-2 w-full rounded-xl border border-[#A3B18A]/35 bg-white px-3 py-2 text-sm text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15"
          data-push-motivation-enabled
        >
          <option value="true" selected>Aktif</option>
          <option value="false">Nonaktif</option>
        </select>
      </label>

      <label class="rounded-2xl border border-[#A3B18A]/35 bg-[#F6F1E9] p-4">
        <span class="text-sm font-semibold text-[#344E41]">Jam motivasi harian</span>
        <input
          type="time"
          class="mt-2 w-full rounded-xl border border-[#A3B18A]/35 bg-white px-3 py-2 text-sm text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15"
          value="07:00"
          data-push-motivation-time
        />
      </label>

      <label class="rounded-2xl border border-[#A3B18A]/35 bg-[#F6F1E9] p-4">
        <span class="text-sm font-semibold text-[#344E41]">Reminder sebelum adzan (menit)</span>
        <select
          class="mt-2 w-full rounded-xl border border-[#A3B18A]/35 bg-white px-3 py-2 text-sm text-[#344E41] outline-none focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/15"
          data-push-reminder-minute
        >
          <option value="5">5 menit</option>
          <option value="10" selected>10 menit</option>
          <option value="15">15 menit</option>
        </select>
      </label>
    </div>

    <div class="mt-4 flex flex-wrap gap-2.5">
      <button
        type="button"
        class="inline-flex items-center rounded-full bg-[#588157] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#466B47]"
        data-push-enable
      >
        Aktifkan Notifikasi
      </button>
      <button
        type="button"
        class="inline-flex items-center rounded-full border border-[#A3B18A]/40 bg-white px-4 py-2 text-sm font-semibold text-[#344E41] transition hover:bg-[#F6F1E9]"
        data-push-test
      >
        Kirim Test
      </button>
      <button
        type="button"
        class="inline-flex items-center rounded-full border border-red-300/45 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100"
        data-push-disable
      >
        Matikan
      </button>
    </div>
  </section>
</main>
