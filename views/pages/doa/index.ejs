<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <div class="text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#588157]/10">
        <svg class="h-7 w-7 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.25 0 4.07 1.82 4.07 4.07 0 1.26-.57 2.39-1.46 3.14.89.75 1.46 1.88 1.46 3.14 0 2.25-1.82 4.08-4.07 4.08S7.93 17.1 7.93 14.85c0-1.26.57-2.39 1.46-3.14-.89-.75-1.46-1.88-1.46-3.14C7.93 6.32 9.75 4.5 12 4.5z" />
        </svg>
      </div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41]">Koleksi Doa</h1>
      <p class="mt-2 text-[#344E41]/70">
        Pilih kategori doa untuk membaca kumpulan doa harian lengkap dengan teks Arab, transliterasi, dan terjemahan Indonesia.
      </p>
      <div class="mt-3 flex flex-wrap justify-center gap-2 text-xs">
        <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]">
          <%= categories.length %> kategori
        </span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70">
          Sumber: <%= sourceName %>
        </span>
      </div>
    </div>

    <div class="mt-6 flex justify-center">
      <form action="/doa" method="GET" class="flex w-full max-w-2xl flex-col gap-3 sm:flex-row">
        <label class="block flex-1">
          <div class="relative">
            <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="search"
              name="q"
              value="<%= searchQuery || '' %>"
              placeholder="Cari doa... (contoh: malas, bangun tidur, perlindungan)"
              class="w-full rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] py-3 pl-11 pr-4 text-[#344E41] outline-none transition placeholder:text-[#344E41]/40 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
            />
          </div>
        </label>
        <div class="flex gap-2">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-[#588157] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#4B6F4E]"
          >
            Cari Doa
          </button>
          <% if (searchQuery) { %>
            <a
              href="/doa"
              class="inline-flex items-center justify-center rounded-2xl border border-[#A3B18A]/40 bg-white px-5 py-3 text-sm font-semibold text-[#344E41] transition hover:border-[#588157]/50 hover:text-[#588157]"
            >
              Reset
            </a>
          <% } %>
        </div>
      </form>
    </div>

    <% if (pageError) { %>
      <div class="mt-6 rounded-2xl border border-red-300/40 bg-red-50 px-4 py-3 text-sm text-red-700">
        <%= pageError %>
      </div>
    <% } %>

    <% if (searchQuery && searchResult) { %>
      <section class="mt-8 rounded-[1.75rem] border border-[#A3B18A]/30 bg-[#F6F1E9]/70 p-5 sm:p-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#588157]">Hasil Pencarian Doa</p>
            <h2 class="mt-2 text-2xl font-bold text-[#344E41]">"<%= searchQuery %>"</h2>
            <p class="mt-1 text-sm text-[#344E41]/65">
              Ditemukan <%= searchResult.pagination.totalItems %> doa yang cocok dengan kata kunci ini.
            </p>
          </div>
          <div class="rounded-2xl border border-[#588157]/20 bg-white/80 px-4 py-2 text-sm text-[#344E41]/70">
            Halaman <%= searchResult.pagination.currentPage %> dari <%= searchResult.pagination.totalPages %>
          </div>
        </div>

        <% if (searchResult.items.length) { %>
          <div class="mt-5 grid grid-cols-1 gap-4 lg:grid-cols-2">
            <% searchResult.items.forEach((item) => { %>
              <a
                href="/doa/<%= item.sectionSlug %>/<%= item.id %>"
                class="group rounded-[1.5rem] border border-[#A3B18A]/30 bg-white/85 p-5 transition hover:border-[#588157]/40 hover:shadow-md"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <span class="inline-flex rounded-full border border-[#588157]/20 bg-[#588157]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#588157]">
                      <%= item.sectionTitle %>
                    </span>
                    <h3 class="mt-3 text-lg font-bold text-[#344E41] transition group-hover:text-[#588157]"><%= item.title %></h3>
                  </div>
                  <svg class="mt-1 h-4 w-4 flex-shrink-0 text-[#A3B18A] transition group-hover:text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </div>

                <% if (item.arabic && item.arabic !== "-") { %>
                  <p class="mt-4 line-clamp-2 text-right text-xl leading-10 text-[#344E41]" dir="rtl"><%= item.arabic %></p>
                <% } %>

                <% if (item.latin) { %>
                  <p class="mt-3 line-clamp-2 text-sm italic leading-6 text-[#344E41]/70"><%= item.latin %></p>
                <% } %>

                <p class="mt-3 line-clamp-3 text-sm leading-6 text-[#344E41]/80"><%= item.translation %></p>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="mt-5 rounded-2xl border border-[#A3B18A]/30 bg-white/70 px-4 py-8 text-center text-[#344E41]/60">
            <svg class="mx-auto h-10 w-10 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <p class="mt-3">Belum ada doa yang cocok dengan pencarian ini.</p>
          </div>
        <% } %>

        <% if (searchResult.pagination.totalPages > 1) { %>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <% if (searchResult.pagination.currentPage > 1) { %>
              <a
                href="/doa?q=<%= encodeURIComponent(searchQuery) %>&page=<%= searchResult.pagination.currentPage - 1 %>"
                class="inline-flex items-center rounded-xl border border-[#A3B18A]/30 bg-white px-4 py-2 text-sm font-medium text-[#344E41] transition hover:border-[#588157]/40 hover:text-[#588157]"
              >
                Prev
              </a>
            <% } %>
            <% for (let pageNumber = 1; pageNumber <= searchResult.pagination.totalPages; pageNumber += 1) { %>
              <a
                href="/doa?q=<%= encodeURIComponent(searchQuery) %>&page=<%= pageNumber %>"
                class="<%= pageNumber === searchResult.pagination.currentPage ? 'bg-[#588157] text-white border-[#588157]' : 'bg-white text-[#344E41] border-[#A3B18A]/30 hover:border-[#588157]/40 hover:text-[#588157]' %> inline-flex h-10 min-w-10 items-center justify-center rounded-xl border px-3 text-sm font-semibold transition"
              >
                <%= pageNumber %>
              </a>
            <% } %>
            <% if (searchResult.pagination.currentPage < searchResult.pagination.totalPages) { %>
              <a
                href="/doa?q=<%= encodeURIComponent(searchQuery) %>&page=<%= searchResult.pagination.currentPage + 1 %>"
                class="inline-flex items-center rounded-xl border border-[#A3B18A]/30 bg-white px-4 py-2 text-sm font-medium text-[#344E41] transition hover:border-[#588157]/40 hover:text-[#588157]"
              >
                Next
              </a>
            <% } %>
          </div>
        <% } %>
      </section>
    <% } %>

    <div class="mt-8">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#588157]">Kategori Doa</p>
          <h2 class="mt-2 text-2xl font-bold text-[#344E41]">Pilih Sesuai Kebutuhan</h2>
        </div>
        <p class="text-sm text-[#344E41]/60">Klik kategori untuk membuka daftar doanya.</p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <% categories.forEach((category) => { %>
          <a
            href="/doa/<%= category.slug %>"
            class="group rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-4 transition hover:border-[#588157]/50 hover:bg-[#A3B18A]/15 hover:shadow-md"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl border border-[#588157]/25 bg-[#588157]/10 transition group-hover:bg-[#588157] group-hover:text-white">
                <svg class="h-5 w-5 text-[#588157] group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.25 0 4.07 1.82 4.07 4.07 0 1.26-.57 2.39-1.46 3.14.89.75 1.46 1.88 1.46 3.14 0 2.25-1.82 4.08-4.07 4.08S7.93 17.1 7.93 14.85c0-1.26.57-2.39 1.46-3.14-.89-.75-1.46-1.88-1.46-3.14C7.93 6.32 9.75 4.5 12 4.5z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <h2 class="truncate font-bold text-[#344E41]"><%= category.title %></h2>
                    <p class="mt-1 text-xs leading-5 text-[#344E41]/60"><%= category.description %></p>
                  </div>
                  <span class="flex h-8 min-w-8 items-center justify-center rounded-full border border-[#588157]/20 bg-white/80 px-2 text-[11px] font-bold text-[#588157]">
                    <%= category.total %>
                  </span>
                </div>
                <% if (category.tags && category.tags.length) { %>
                  <div class="mt-3 flex flex-wrap gap-1.5 text-[10px]">
                    <% category.tags.slice(0, 3).forEach((tag) => { %>
                      <span class="rounded-full border border-[#A3B18A]/30 bg-white/70 px-2 py-0.5 text-[#344E41]/70"><%= tag %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
              <svg class="mt-1 h-4 w-4 flex-shrink-0 text-[#A3B18A] transition group-hover:text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (!categories.length && !pageError) { %>
        <div class="mt-6 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60">
          <svg class="mx-auto h-10 w-10 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h9A2.25 2.25 0 0118.75 6.75v10.5A2.25 2.25 0 0116.5 19.5h-9a2.25 2.25 0 01-2.25-2.25V6.75A2.25 2.25 0 017.5 4.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 8.25h6m-6 3h6m-6 3h3" />
          </svg>
          <p class="mt-3">Kategori doa belum tersedia.</p>
        </div>
      <% } %>
    </div>
  </section>
</main>
