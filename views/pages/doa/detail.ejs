<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <nav class="flex flex-wrap items-center gap-1.5 text-sm text-[#344E41]/60">
      <a href="/doa" class="transition hover:text-[#588157]">Doa</a>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/doa/<%= doa.slug %>" class="transition hover:text-[#588157]"><%= doa.categoryTitle %></a>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
      <span class="font-medium text-[#344E41]"><%= doa.title %></span>
    </nav>

    <div class="mt-6 text-center">
      <span class="inline-flex h-12 min-w-12 items-center justify-center rounded-full border border-[#588157]/25 bg-[#588157]/10 px-4 text-sm font-bold text-[#588157]">
        <%= doa.id %>
      </span>
      <h1 class="mt-4 text-2xl font-bold text-[#344E41] sm:text-3xl"><%= doa.title %></h1>
      <p class="mt-2 text-sm text-[#344E41]/60"><%= doa.categoryTitle %></p>
      <div class="mx-auto mt-5 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
    </div>

    <div class="mt-8 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-6">
      <p class="text-right font-[Amiri,serif] text-2xl leading-[2.5] text-[#344E41] sm:text-3xl" dir="rtl"><%= doa.arabic %></p>
    </div>

    <% if (doa.latin) { %>
      <div class="mt-4 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#588157]">Transliterasi</p>
        <p class="mt-3 text-sm italic leading-7 text-[#344E41]/80"><%= doa.latin %></p>
      </div>
    <% } %>

    <div class="mt-4 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#588157]"><%= doa.translationLabel || 'Terjemahan' %></p>
      <p class="mt-3 text-sm leading-7 text-[#344E41]/80"><%= doa.translation %></p>
    </div>

    <% if (doa.notes) { %>
      <div class="mt-4 rounded-2xl border border-[#D4A373]/30 bg-[#FFF9F1] p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#B07A32]">Catatan</p>
        <p class="mt-3 text-sm leading-7 text-[#344E41]/80"><%= doa.notes %></p>
      </div>
    <% } %>

    <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
      <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]"><%= doa.categoryTitle %></span>
      <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70">ID <%= doa.id %></span>
    </div>

    <div class="mt-4 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#588157]">Sumber</p>
      <p class="mt-3 text-sm leading-7 text-[#344E41]/80"><%= doa.source %></p>
    </div>

    <div class="mt-6 flex flex-wrap justify-center gap-2">
      <% if (previous) { %>
        <a href="/doa/<%= doa.slug %>/<%= previous.id %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Doa Sebelumnya
        </a>
      <% } %>
      <a href="/doa/<%= doa.slug %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" />
        </svg>
        Daftar Doa
      </a>
      <% if (next) { %>
        <a href="/doa/<%= doa.slug %>/<%= next.id %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
          Doa Selanjutnya
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      <% } %>
    </div>
  </section>
</main>
