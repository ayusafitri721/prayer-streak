<%
  const currentPage = pagination ? pagination.currentPage : 1;
  const totalPages = pagination ? pagination.totalPages : 1;
%>

<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <a href="/doa" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke kategori doa
    </a>

    <div class="mt-6 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#588157]/10">
        <svg class="h-7 w-7 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.25 0 4.07 1.82 4.07 4.07 0 1.26-.57 2.39-1.46 3.14.89.75 1.46 1.88 1.46 3.14 0 2.25-1.82 4.08-4.07 4.08S7.93 17.1 7.93 14.85c0-1.26.57-2.39 1.46-3.14-.89-.75-1.46-1.88-1.46-3.14C7.93 6.32 9.75 4.5 12 4.5z" />
        </svg>
      </div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41]"><%= title %></h1>
      <p class="mx-auto mt-2 max-w-2xl text-sm leading-7 text-[#344E41]/70"><%= description %></p>
      <div class="mt-3 flex flex-wrap justify-center gap-2 text-xs">
        <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]"><%= total.toLocaleString("id-ID") %> doa</span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70">Halaman <%= currentPage %> dari <%= totalPages %></span>
      </div>
      <% if (tags && tags.length) { %>
        <div class="mt-4 flex flex-wrap justify-center gap-2 text-[10px]">
          <% tags.forEach((tag) => { %>
            <span class="rounded-full border border-[#A3B18A]/30 bg-white/70 px-2.5 py-1 uppercase tracking-[0.16em] text-[#344E41]/70"><%= tag %></span>
          <% }) %>
        </div>
      <% } %>
      <div class="mx-auto mt-5 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-[minmax(0,1fr)_220px]">
      <label class="block">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            placeholder="Cari doa di halaman ini (judul / terjemahan)"
            class="w-full rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] py-3 pl-11 pr-4 text-[#344E41] outline-none transition placeholder:text-[#344E41]/40 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
            data-doa-filter-input
          />
        </div>
      </label>
      <form class="flex gap-2" data-doa-jump-form>
        <input
          type="number"
          min="1"
          inputmode="numeric"
          placeholder="ID doa"
          class="w-full rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] px-4 py-3 text-sm text-[#344E41] outline-none transition placeholder:text-[#344E41]/40 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
          data-doa-jump-input
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-2xl bg-[#588157] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#4B6F4E]"
        >
          Buka
        </button>
      </form>
    </div>

    <p class="mt-3 text-sm text-[#344E41]/65" data-doa-filter-info>
      Menampilkan <%= items.length %> doa pada halaman ini.
    </p>

    <div class="mt-4 space-y-3" data-doa-list>
      <% items.forEach((item) => { %>
        <a
          href="/doa/<%= slug %>/<%= item.id %>"
          class="group relative block overflow-hidden rounded-[1.5rem] border border-[#A3B18A]/35 bg-white/90 transition hover:-translate-y-0.5 hover:border-[#588157]/55 hover:shadow-[0_16px_32px_rgba(52,78,65,0.14)]"
          data-doa-item
          data-doa-id="<%= item.id %>"
          data-doa-search-value="<%= `${item.id} ${item.title} ${item.translation}`.toLowerCase() %>"
        >
          <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-[#588157] via-[#A3B18A] to-[#D4A373] opacity-80"></div>
          <div class="p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-center gap-2">
                <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-full border border-[#588157]/30 bg-[#588157]/12 px-2 text-xs font-black text-[#588157]">
                  <%= item.id %>
                </span>
                <h2 class="truncate text-sm font-bold text-[#2E3E36] sm:text-base"><%= item.title %></h2>
              </div>
              <svg class="h-4 w-4 flex-shrink-0 text-[#A3B18A] transition group-hover:text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>

            <div class="mt-3 rounded-2xl border border-[#A3B18A]/28 bg-[#F6F1E9]/85 px-3 py-3">
              <p class="line-clamp-3 text-right font-[Amiri,serif] text-xl leading-[1.9] text-[#2E3E36]" dir="rtl">
                <%= item.arabic.length > 220 ? item.arabic.substring(0, 220) + '...' : item.arabic %>
              </p>
            </div>

            <p class="mt-3 line-clamp-3 text-sm leading-7 text-[#344E41]/82">
              <%= item.translation.length > 240 ? item.translation.substring(0, 240) + '...' : item.translation %>
            </p>

            <div class="mt-3 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-[#588157]">Tap untuk baca penuh</span>
              <span class="text-[11px] font-medium text-[#344E41]/55">ID <%= item.id %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="mt-6 hidden rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60" data-doa-filter-empty>
      <svg class="mx-auto h-10 w-10 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="mt-3">Tidak ada doa yang cocok di halaman ini.</p>
    </div>

    <% if (!items.length) { %>
      <div class="mt-6 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60">
        <p>Tidak ada doa ditemukan pada halaman ini.</p>
      </div>
    <% } %>

    <% if (totalPages > 1) { %>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <% if (currentPage > 1) { %>
          <a href="/doa/<%= slug %>?page=<%= currentPage - 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Sebelumnya
          </a>
        <% } %>

        <span class="rounded-full border border-[#A3B18A]/30 bg-white px-4 py-2 text-sm font-semibold text-[#588157]">
          <%= currentPage %> / <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="/doa/<%= slug %>?page=<%= currentPage + 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            Selanjutnya
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        <% } %>
      </div>
    <% } %>
  </section>
</main>

<script>
(() => {
  const filterInput = document.querySelector("[data-doa-filter-input]");
  const infoEl = document.querySelector("[data-doa-filter-info]");
  const emptyEl = document.querySelector("[data-doa-filter-empty]");
  const cards = Array.from(document.querySelectorAll("[data-doa-item]"));
  const jumpForm = document.querySelector("[data-doa-jump-form]");
  const jumpInput = document.querySelector("[data-doa-jump-input]");

  if (!cards.length) return;

  const applyFilter = () => {
    const query = (filterInput?.value || "").trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const haystack = card.getAttribute("data-doa-search-value") || "";
      const isMatch = !query || haystack.includes(query);
      card.classList.toggle("hidden", !isMatch);
      if (isMatch) visibleCount += 1;
    });

    if (infoEl) {
      infoEl.textContent = query
        ? `Hasil: ${visibleCount} doa cocok dari ${cards.length} doa pada halaman ini.`
        : `Menampilkan ${cards.length} doa pada halaman ini.`;
    }
    if (emptyEl) {
      emptyEl.classList.toggle("hidden", visibleCount > 0);
    }
  };

  filterInput?.addEventListener("input", applyFilter);
  applyFilter();

  jumpForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const target = Number((jumpInput?.value || "").trim());
    if (!Number.isFinite(target) || target < 1) return;
    const found = cards.find((card) => Number(card.getAttribute("data-doa-id")) === target);
    if (found) {
      window.location.href = found.getAttribute("href");
      return;
    }
    if (filterInput) {
      filterInput.value = String(target);
      applyFilter();
      filterInput.focus();
    }
  });
})();
</script>


