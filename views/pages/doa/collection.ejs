<%
  const currentPage = pagination ? pagination.currentPage : 1;
  const totalPages = pagination ? pagination.totalPages : 1;
%>

<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <a href="/doa" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke kategori doa
    </a>

    <div class="mt-6 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#588157]/10">
        <svg class="h-7 w-7 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.25 0 4.07 1.82 4.07 4.07 0 1.26-.57 2.39-1.46 3.14.89.75 1.46 1.88 1.46 3.14 0 2.25-1.82 4.08-4.07 4.08S7.93 17.1 7.93 14.85c0-1.26.57-2.39 1.46-3.14-.89-.75-1.46-1.88-1.46-3.14C7.93 6.32 9.75 4.5 12 4.5z" />
        </svg>
      </div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41]"><%= title %></h1>
      <p class="mx-auto mt-2 max-w-2xl text-sm leading-7 text-[#344E41]/70"><%= description %></p>
      <div class="mt-3 flex flex-wrap justify-center gap-2 text-xs">
        <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]"><%= total.toLocaleString("id-ID") %> doa</span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70">Halaman <%= currentPage %> dari <%= totalPages %></span>
      </div>
      <% if (tags && tags.length) { %>
        <div class="mt-4 flex flex-wrap justify-center gap-2 text-[10px]">
          <% tags.forEach((tag) => { %>
            <span class="rounded-full border border-[#A3B18A]/30 bg-white/70 px-2.5 py-1 uppercase tracking-[0.16em] text-[#344E41]/70"><%= tag %></span>
          <% }) %>
        </div>
      <% } %>
      <div class="mx-auto mt-5 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
    </div>

    <div class="mt-6 space-y-3">
      <% items.forEach((item) => { %>
        <a
          href="/doa/<%= slug %>/<%= item.id %>"
          class="group block rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-4 transition hover:border-[#588157]/50 hover:bg-[#A3B18A]/15 hover:shadow-md"
        >
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-[#588157]/25 bg-[#588157]/10 text-xs font-bold text-[#588157]">
              <%= item.id %>
            </span>
            <div class="min-w-0 flex-1">
              <h2 class="font-bold text-[#344E41]"><%= item.title %></h2>
              <p class="mt-2 text-right font-[Amiri,serif] text-lg leading-[2] text-[#344E41]" dir="rtl"><%= item.arabic.length > 180 ? item.arabic.substring(0, 180) + '...' : item.arabic %></p>
              <div class="mt-2 h-px bg-gradient-to-r from-transparent via-[#A3B18A]/40 to-transparent"></div>
              <p class="mt-2 text-sm leading-6 text-[#344E41]/70"><%= item.translation.length > 180 ? item.translation.substring(0, 180) + '...' : item.translation %></p>
            </div>
            <svg class="mt-1 h-4 w-4 flex-shrink-0 text-[#A3B18A] transition group-hover:text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      <% }) %>
    </div>

    <% if (!items.length) { %>
      <div class="mt-6 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60">
        <p>Tidak ada doa ditemukan pada halaman ini.</p>
      </div>
    <% } %>

    <% if (totalPages > 1) { %>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <% if (currentPage > 1) { %>
          <a href="/doa/<%= slug %>?page=<%= currentPage - 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Sebelumnya
          </a>
        <% } %>

        <span class="rounded-full border border-[#A3B18A]/30 bg-white px-4 py-2 text-sm font-semibold text-[#588157]">
          <%= currentPage %> / <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="/doa/<%= slug %>?page=<%= currentPage + 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            Selanjutnya
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        <% } %>
      </div>
    <% } %>
  </section>
</main>
