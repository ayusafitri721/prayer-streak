<%
  const weeklyPercent = Math.min(consistencyPercent || 0, 100);
  const remainingLabel = remainingThisWeek === 0 ? "Target minggu ini selesai" : `Sisa ${remainingThisWeek} salat lagi`;
  const bestDayText = bestDay && bestDay.completed > 0
    ? `${bestDay.label}, ${bestDay.completed}/${bestDay.total} salat`
    : "Belum ada data minggu ini";
  const heatmapClass = {
    great: "bg-[#3F6F42]",
    good: "bg-[#9EB985]",
    low: "bg-[#F3B51B]",
    empty: "bg-[#E8E2D7]",
  };
  const insightClass = {
    success: "bg-[#EAF3E5] text-[#4F7F53]",
    warning: "bg-[#FFF2D9] text-[#D39100]",
    info: "bg-[#EAF5F6] text-[#3D8AA0]",
    spark: "bg-[#F6F1E9] text-[#588157]",
  };
  const achievementColor = {
    sun: "from-[#F7D47D] to-[#4F7F53]",
    star: "from-[#D4A373] to-[#7B4EC8]",
    flame: "from-[#F4A261] to-[#4169A8]",
  };
  const sunnahWeek = typeof sunnahThisWeek === "number" ? sunnahThisWeek : 0;
  const sunnahMonth = typeof sunnahThisMonth === "number" ? sunnahThisMonth : 0;
  const sunnahWeekXp = typeof sunnahXpThisWeek === "number" ? sunnahXpThisWeek : 0;
  const sunnahTarget = typeof sunnahWeeklyTarget === "number" ? sunnahWeeklyTarget : 35;
  const sunnahDailyXpLimit = typeof maxSunnahXpPerDay === "number" ? maxSunnahXpPerDay : 15;
  const sunnahPercent = Math.min(100, Math.round((sunnahWeek / Math.max(sunnahTarget, 1)) * 100));
  const sunnahDays = Array.isArray(sunnahWeeklyBreakdown) ? sunnahWeeklyBreakdown : [];
  const sunnahItems = Array.isArray(sunnahPerformance) ? sunnahPerformance : [];
  const sunnahAverage = typeof sunnahDailyAverage === "number" ? sunnahDailyAverage : Number((sunnahWeek / 7).toFixed(1));
  const bestSunnahText = bestSunnah && bestSunnah.completed > 0
    ? `${bestSunnah.label} (${bestSunnah.completed}/7 hari)`
    : "Belum ada sunnah dominan";
%>

<main class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-5 text-[#344E41] sm:px-6 lg:px-6">
  <section class="order-1 dashboard-card-enter overflow-hidden rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-sm font-black text-[#588157]">Statistik Mingguan</p>
        <h1 class="mt-2 text-3xl font-black leading-tight text-[#344E41] sm:text-4xl">Progress Konsistensi</h1>
        <p class="mt-3 max-w-3xl text-sm font-semibold leading-6 text-[#344E41]/62">
          Lihat perkembangan salatmu selama 7 hari terakhir. Terus jaga konsistensimu dan raih target 35 salat dalam seminggu.
        </p>
      </div>

      <div class="relative overflow-hidden rounded-[1.35rem] bg-[#2F5946] p-4 text-white shadow-lg shadow-[#344E41]/10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_18%,rgba(212,163,115,0.22),transparent_24%),linear-gradient(135deg,rgba(255,255,255,0.08),transparent_50%)]"></div>
        <div class="relative grid gap-5 sm:grid-cols-[1fr_auto_1fr] sm:items-center">
          <div>
            <p class="text-sm font-semibold text-white/78">Konsistensi Minggu Ini</p>
            <p class="mt-2 text-4xl font-black"><%= weeklyPercent %>%</p>
            <p class="mt-2 text-base font-bold text-white/82"><%= totalThisWeek %> / <%= weeklyTarget %> salat</p>
          </div>
          <div class="grid h-28 w-28 place-items-center rounded-full" style="background: conic-gradient(#D4A373 <%= weeklyPercent %>%, rgba(255,255,255,0.14) 0);">
            <div class="h-20 w-20 rounded-full bg-[#2F5946]"></div>
          </div>
          <div class="flex items-start gap-3">
            <div class="grid h-10 w-10 place-items-center rounded-full bg-[#D4A373]/18 text-[#D4A373]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 3v18M5 5h12l-2 4 2 4H5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="font-black">Target Mingguan</p>
              <p class="mt-1 text-lg font-black"><%= weeklyTarget %> salat</p>
              <p class="mt-2 text-sm font-semibold text-white/72"><%= remainingLabel %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="flex items-center gap-4 rounded-2xl border border-[#E4D8C8] bg-white p-4 shadow-sm">
        <div class="grid h-14 w-14 place-items-center rounded-full bg-[#EEF3E6] text-[#588157]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-[#344E41]/62">Total Minggu Ini</p>
          <p class="mt-1 text-2xl font-black text-[#344E41]"><%= totalThisWeek %></p>
          <p class="text-sm font-semibold text-[#344E41]/54">dari <%= weeklyTarget %> salat</p>
        </div>
      </article>

      <article class="flex items-center gap-4 rounded-2xl border border-[#E4D8C8] bg-white p-4 shadow-sm">
        <div class="grid h-14 w-14 place-items-center rounded-full bg-[#EEF3E6] text-[#588157]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m9 12 2 2 4-5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-[#344E41]/62">Hari Full Completed</p>
          <p class="mt-1 text-2xl font-black text-[#344E41]"><%= fullDays %></p>
          <p class="text-sm font-semibold text-[#344E41]/54">dari 7 hari</p>
        </div>
      </article>

      <article class="flex items-center gap-4 rounded-2xl border border-[#E4D8C8] bg-white p-4 shadow-sm">
        <div class="grid h-14 w-14 place-items-center rounded-full bg-[#FFF2E3] text-[#D9822B]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 22c4 0 7-2.8 7-6.7 0-3.2-1.9-5.4-4.2-7.6-.7 2.5-2 3.7-3.6 4.8.4-3-1.2-5.4-3.2-7.5C7.7 8.8 5 11.7 5 15.2 5 19.2 8 22 12 22Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-[#344E41]/62">Streak Aktif</p>
          <p class="mt-1 text-2xl font-black text-[#344E41]"><%= activeStreak %></p>
          <p class="text-sm font-semibold text-[#344E41]/54">hari berturut-turut</p>
        </div>
      </article>

      <article class="flex items-center gap-4 rounded-2xl border border-[#E4D8C8] bg-white p-4 shadow-sm">
        <div class="grid h-14 w-14 place-items-center rounded-full bg-[#FFF5D9] text-[#D39100]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM5 6H3v2a4 4 0 0 0 4 4M19 6h2v2a4 4 0 0 1-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-[#344E41]/62">Longest Streak</p>
          <p class="mt-1 text-2xl font-black text-[#344E41]"><%= longestStreak %></p>
          <p class="text-sm font-semibold text-[#344E41]/54">hari terbaik</p>
        </div>
      </article>
    </div>
  </section>

  <section class="order-3 dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="text-sm font-black text-[#588157]">Ibadah Sunnah</p>
        <h2 class="mt-1 text-2xl font-black text-[#344E41]">Bonus Ibadah Tambahan</h2>
        <p class="mt-2 max-w-2xl text-sm font-semibold leading-6 text-[#344E41]/62">
          Salat sunnah tidak masuk target wajib 5 waktu dan tidak memengaruhi streak utama. Bagian ini hanya mencatat bonus ibadah tambahan.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4 lg:min-w-[640px]">
        <article class="rounded-2xl border border-[#E4D8C8] bg-[#FFF9F0] p-4">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]/75">Minggu Ini</p>
          <p class="mt-2 text-2xl font-black text-[#344E41]"><%= sunnahWeek %></p>
          <p class="mt-1 text-xs font-semibold text-[#344E41]/55">sunnah tercatat</p>
        </article>
        <article class="rounded-2xl border border-[#E4D8C8] bg-[#FFF9F0] p-4">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]/75">Bonus XP</p>
          <p class="mt-2 text-2xl font-black text-[#344E41]"><%= sunnahWeekXp %> XP</p>
          <p class="mt-1 text-xs font-semibold text-[#344E41]/55">max <%= sunnahDailyXpLimit %> XP/hari</p>
        </article>
        <article class="rounded-2xl border border-[#E4D8C8] bg-[#FFF9F0] p-4">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]/75">Bulan Ini</p>
          <p class="mt-2 text-2xl font-black text-[#344E41]"><%= sunnahMonth %></p>
          <p class="mt-1 text-xs font-semibold text-[#344E41]/55">aktivitas sunnah</p>
        </article>
        <article class="rounded-2xl border border-[#E4D8C8] bg-[#FFF9F0] p-4">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]/75">Rata-rata</p>
          <p class="mt-2 text-2xl font-black text-[#344E41]"><%= sunnahAverage %></p>
          <p class="mt-1 text-xs font-semibold text-[#344E41]/55">sunnah / hari</p>
        </article>
      </div>
    </div>
    <div class="mt-5 h-3 overflow-hidden rounded-full bg-[#EDE5D8]">
      <div class="dashboard-progress h-full rounded-full bg-[#A3B18A]" style="--progress-width: <%= sunnahPercent %>%; width: <%= sunnahPercent %>%"></div>
    </div>
    <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_0.9fr]">
      <div class="rounded-[1.25rem] border border-[#E4D8C8] bg-[#F8F5EE] p-4">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h3 class="font-black text-[#344E41]">Grafik Sunnah 7 Hari</h3>
            <p class="mt-1 text-xs font-semibold text-[#344E41]/58">Bonus terpisah dari target wajib dan streak utama.</p>
          </div>
          <span class="rounded-full bg-[#EEF3E6] px-3 py-1 text-xs font-black text-[#588157]"><%= sunnahWeek %>/<%= sunnahTarget %></span>
        </div>

        <div class="mt-5 grid grid-cols-7 items-end gap-3">
          <% sunnahDays.forEach((day, index) => { %>
            <% const hasSunnahProgress = day.completed > 0; const isSunnahToday = index === sunnahDays.length - 1; %>
            <div class="flex flex-col items-center gap-2">
              <div class="relative flex h-24 w-full max-w-10 items-end overflow-hidden rounded-full bg-white/80 ring-1 ring-[#E4D8C8]">
                <div
                  class="<%= day.isFull ? 'bg-[#588157]' : day.completed >= 3 ? 'bg-[#A3B18A]' : hasSunnahProgress ? 'bg-[#D4A373]' : 'bg-[#E8E2D7]' %> stats-bar w-full rounded-full"
                  style="--bar-height: <%= Math.max(day.percent, hasSunnahProgress ? 16 : 3) %>%; animation-delay: <%= index * 70 %>ms;"
                ></div>
              </div>
              <p class="<%= hasSunnahProgress ? 'bg-[#588157] text-white' : 'bg-[#E8E2D7] text-[#344E41]/50' %> rounded-full px-2 py-1 text-[11px] font-black"><%= day.completed %>/<%= day.total %></p>
              <p class="text-[11px] font-bold text-[#344E41]/62"><%= day.label %></p>
              <% if (isSunnahToday) { %>
                <p class="text-[10px] font-black text-[#588157]">Hari ini</p>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="rounded-[1.25rem] border border-[#E4D8C8] bg-[#F8F5EE] p-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="font-black text-[#344E41]">Breakdown Sunnah</h3>
            <p class="mt-1 text-xs font-semibold text-[#344E41]/58">Paling sering: <%= bestSunnahText %></p>
          </div>
          <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#D4A373]/18 text-[#B7792D]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v18M5 8h14M6 16h12M8 3h8a2 2 0 0 1 2 2v14H6V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>

        <div class="mt-4 space-y-3">
          <% sunnahItems.forEach((item) => { %>
            <div>
              <div class="mb-1 flex items-center justify-between gap-3 text-xs font-black">
                <span class="text-[#344E41]"><%= item.label %></span>
                <span class="text-[#588157]"><%= item.completed %>/<%= item.total %> hari</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-white">
                <div class="dashboard-progress h-full rounded-full bg-[#A3B18A]" style="--progress-width: <%= item.percent %>%; width: <%= item.percent %>%"></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <section class="order-2 grid gap-5 xl:grid-cols-[1.35fr_0.85fr]">
    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-black text-[#344E41]">Grafik 7 Hari</h2>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Jumlah salat dari 5 waktu yang kamu selesaikan per hari.</p>
        </div>
        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-[#EEF3E6] px-4 py-2 text-sm font-black text-[#588157]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          Target: 5/hari
        </span>
      </div>

      <div class="mt-8 grid grid-cols-7 items-end gap-4">
        <% weeklyBreakdown.forEach((day, index) => { %>
          <% const hasProgress = day.completed > 0; const isToday = index === weeklyBreakdown.length - 1; %>
          <div class="<%= isToday ? 'rounded-3xl border-2 border-[#A3B18A] p-2' : '' %> flex min-h-48 flex-col items-center justify-end gap-3">
            <div class="relative flex h-32 w-full max-w-14 items-end justify-center overflow-hidden rounded-full border border-[#E8E2D7] bg-[#F8F5EE]">
              <div
                class="<%= day.isFull ? 'bg-[#588157]' : day.completed >= 3 ? 'bg-[#9EB985]' : hasProgress ? 'bg-[#F3B51B]' : 'bg-[#E8E2D7]' %> stats-bar w-full rounded-full"
                style="--bar-height: <%= Math.max(day.percent, hasProgress ? 18 : 3) %>%; animation-delay: <%= index * 80 %>ms;"
              ></div>
            </div>
            <div class="text-center">
              <p class="<%= day.isFull ? 'bg-[#588157]' : hasProgress ? 'bg-[#F3B51B]' : 'bg-[#E8E2D7] text-[#344E41]/45' %> rounded-full px-3 py-1 text-xs font-black <%= hasProgress ? 'text-white' : '' %>"><%= day.completed %>/<%= day.total %></p>
              <p class="mt-2 text-xs font-bold text-[#344E41]/68"><%= day.label %></p>
              <% if (isToday) { %>
                <p class="text-[11px] font-black text-[#588157]">Hari ini</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <h2 class="text-xl font-black text-[#344E41]">Kalender Konsistensi</h2>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Lihat konsistensi harianmu dalam 30 hari terakhir.</p>
      <p class="mt-5 text-center text-sm font-black text-[#344E41]/72"><%= currentMonthLabel %></p>

      <div class="mx-auto mt-5 grid max-w-xl grid-cols-10 gap-2">
        <% heatmapDays.forEach((day) => { %>
          <div class="h-4 w-4 rounded <%= heatmapClass[day.level] %>" title="<%= day.label %>: <%= day.completed %>/<%= day.total %> salat"></div>
        <% }) %>
      </div>

      <div class="mt-6 flex flex-wrap justify-center gap-4 text-xs font-semibold text-[#344E41]/62">
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#3F6F42]"></i>Sangat Baik (5)</span>
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#9EB985]"></i>Baik (3-4)</span>
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#F3B51B]"></i>Cukup (1-2)</span>
        <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#E8E2D7]"></i>Tidak Ada</span>
      </div>
    </div>
  </section>

  <section class="order-4 grid gap-5 lg:grid-cols-[0.9fr_0.8fr_1fr]">
    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <h2 class="text-xl font-black text-[#344E41]">Performa Waktu Salat</h2>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Persentase keberhasilan dalam 7 hari terakhir.</p>

      <div class="mt-5 space-y-4">
        <% prayerPerformance.forEach((item) => { %>
          <div class="grid grid-cols-[5.5rem_1fr_3rem] items-center gap-3">
            <p class="flex items-center text-sm font-black text-[#344E41]">
              <svg class="mr-2 h-4 w-4 text-[#D4A373]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <% if (item.label === "Isya") { %>
                  <path d="M18 15.5A7 7 0 0 1 8.5 6 7.5 7.5 0 1 0 18 15.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <% } else if (item.label === "Maghrib") { %>
                  <path d="M4 16h16M7 13a5 5 0 0 1 10 0M12 4v2M5 9l1.5 1M19 9l-1.5 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <% } else { %>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <% } %>
              </svg>
              <%= item.label %>
            </p>
            <div class="h-3 overflow-hidden rounded-full bg-[#E8E2D7]">
              <div class="dashboard-progress h-full rounded-full bg-[#588157]" style="--progress-width: <%= item.percent %>%;"></div>
            </div>
            <p class="text-right text-sm font-black text-[#344E41]/72"><%= item.percent %>%</p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <h2 class="text-xl font-black text-[#344E41]">Insight Minggu Ini</h2>

      <div class="mt-5 space-y-3">
        <% weeklyInsights.slice(0, 3).forEach((insight) => { %>
          <div class="flex gap-3 rounded-2xl bg-[#F8F5EE] p-3">
            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full <%= insightClass[insight.type] %>">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <% if (insight.type === "success") { %>
                  <path d="M4 16 10 10l4 4 6-8M14 6h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <% } else if (insight.type === "warning") { %>
                  <path d="M12 8v5M12 17h.01M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <% } else { %>
                  <path d="M12 17v-6M12 7h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <% } %>
              </svg>
            </div>
            <div>
              <p class="text-sm font-black text-[#344E41]"><%= insight.title %></p>
              <p class="mt-1 text-xs font-semibold text-[#344E41]/58"><%= insight.description %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-xl font-black text-[#344E41]">Achievement Minggu Ini</h2>
        <a href="/achievements" class="text-sm font-black text-[#588157]">Lihat semua</a>
      </div>

      <div class="mt-6 grid grid-cols-3 gap-4 text-center">
        <% weeklyAchievements.forEach((item) => { %>
          <div class="<%= item.unlocked ? '' : 'opacity-45' %>">
            <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-gradient-to-br <%= achievementColor[item.icon] %> text-3xl text-white shadow-lg shadow-[#344E41]/10">
              <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <% if (item.icon === "sun") { %>
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                <% } else if (item.icon === "star") { %>
                  <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1-4.4-4.3 6.1-.9L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <% } else { %>
                  <path d="M12 22c4 0 7-2.8 7-6.7 0-3.2-1.9-5.4-4.2-7.6-.7 2.5-2 3.7-3.6 4.8.4-3-1.2-5.4-3.2-7.5C7.7 8.8 5 11.7 5 15.2 5 19.2 8 22 12 22Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <% } %>
              </svg>
            </div>
            <p class="mt-3 text-sm font-black text-[#344E41]"><%= item.name %></p>
            <p class="mt-1 text-xs font-semibold text-[#344E41]/58"><%= item.description %></p>
            <p class="mt-1 text-xs text-[#344E41]/45"><%= item.meta %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="order-5 grid gap-5 lg:grid-cols-[1.05fr_0.8fr_1.1fr]">
    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <div class="flex items-center gap-5">
        <div class="grid h-24 w-24 shrink-0 place-items-center rounded-full" style="background: conic-gradient(#588157 <%= monthlyPercent %>%, #E8E2D7 0);">
          <div class="grid h-16 w-16 place-items-center rounded-full bg-white text-lg font-black text-[#344E41]"><%= monthlyPercent %>%</div>
        </div>
        <div>
          <h2 class="text-xl font-black text-[#344E41]">Rekap Bulanan</h2>
          <p class="mt-2 text-2xl font-black text-[#344E41]"><%= monthlyTotal %> / <%= monthlyTarget %> salat</p>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Target bulan ini: <%= monthlyTarget %> salat</p>
        </div>
      </div>
    </div>

    <div class="dashboard-card-enter rounded-[1.5rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <h2 class="text-xl font-black text-[#344E41]">Rata-rata Harian</h2>
      <div class="mt-4 flex items-end gap-4">
        <p class="text-4xl font-black text-[#588157]"><%= dailyAverage %></p>
        <div class="pb-1">
          <p class="text-sm font-semibold text-[#344E41]/68">salat / hari</p>
          <p class="mt-1 inline-flex rounded-full bg-[#EAF3E5] px-3 py-1 text-xs font-black text-[#588157]"><svg class="mr-1 h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><%= dailyAverageDelta %>%</p>
        </div>
      </div>
      <p class="mt-3 text-sm font-semibold text-[#344E41]/58">dibanding minggu lalu</p>
    </div>

    <div class="dashboard-card-enter relative overflow-hidden rounded-[1.5rem] bg-[#A3B18A]/80 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <img src="/assets/mosque-landing.svg" alt="" class="absolute bottom-0 right-5 w-28 opacity-70">
      <div class="relative max-w-md">
        <p class="text-3xl text-white/80">“</p>
        <p class="text-base font-semibold leading-7 text-[#344E41]">
          Dan dirikanlah salat, sesungguhnya salat itu mencegah dari perbuatan keji dan mungkar.
        </p>
        <p class="mt-3 text-sm font-black text-[#344E41]/72">(QS. Al-Ankabut: 45)</p>
      </div>
    </div>
  </section>
</main>
