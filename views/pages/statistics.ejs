<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 text-[#344E41] sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <h1 class="text-3xl font-bold text-[#344E41]">Statistik Progres</h1>
    <p class="mt-2 text-[#344E41]/75">Ringkasan performa konsistensi salat 5 waktu.</p>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Total salat selesai minggu ini</p>
        <p class="mt-2 text-2xl font-bold text-[#588157]"><%= totalThisWeek %></p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Persentase konsistensi</p>
        <p class="mt-2 text-2xl font-bold text-[#588157]"><%= consistencyPercent %>%</p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Hari full completed</p>
        <p class="mt-2 text-2xl font-bold text-[#588157]"><%= fullDays %></p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Streak aktif</p>
        <p class="mt-2 text-2xl font-bold text-[#588157]"><%= activeStreak %> hari</p>
      </article>
      <article class="rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] p-4">
        <p class="text-sm text-[#344E41]/60">Longest streak</p>
        <p class="mt-2 text-2xl font-bold text-[#588157]"><%= longestStreak %> hari</p>
      </article>
    </div>
  </section>
</main>
