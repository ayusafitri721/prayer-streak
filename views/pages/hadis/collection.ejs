<%
  const currentPage = pagination ? pagination.currentPage : 1;
  const totalPages = pagination ? pagination.totalPages : 1;
%>

<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <a href="/hadis" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke daftar perawi
    </a>

    <div class="mt-6 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#588157]/10">
        <svg class="h-7 w-7 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41]"><%= name %></h1>
      <div class="mt-3 flex flex-wrap justify-center gap-2 text-xs">
        <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]"><%= total.toLocaleString("id-ID") %> hadis</span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70">Halaman <%= currentPage %> dari <%= totalPages %></span>
      </div>
      <div class="mx-auto mt-5 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
    </div>

    <div class="mt-6 space-y-3">
      <% items.forEach((item) => { %>
        <a
          href="/hadis/<%= slug %>/<%= item.number %>"
          class="group block rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-4 transition hover:border-[#588157]/50 hover:bg-[#A3B18A]/15 hover:shadow-md"
        >
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-[#588157]/25 bg-[#588157]/10 text-xs font-bold text-[#588157]">
              <%= item.number %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-right font-[Amiri,serif] text-lg leading-[2] text-[#344E41]" dir="rtl"><%= item.arab.length > 200 ? item.arab.substring(0, 200) + '...' : item.arab %></p>
              <div class="mt-2 h-px bg-gradient-to-r from-transparent via-[#A3B18A]/40 to-transparent"></div>
              <p class="mt-2 text-sm leading-6 text-[#344E41]/70"><%= item.id.length > 200 ? item.id.substring(0, 200) + '...' : item.id %></p>
            </div>
            <svg class="mt-1 h-4 w-4 flex-shrink-0 text-[#A3B18A] transition group-hover:text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      <% }) %>
    </div>

    <% if (!items.length) { %>
      <div class="mt-6 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60">
        <p>Tidak ada hadis ditemukan pada halaman ini.</p>
      </div>
    <% } %>

    <% if (totalPages > 1) { %>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <% if (currentPage > 1) { %>
          <a href="/hadis/<%= slug %>?page=<%= currentPage - 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Sebelumnya
          </a>
        <% } %>

        <span class="rounded-full border border-[#A3B18A]/30 bg-white px-4 py-2 text-sm font-semibold text-[#588157]">
          <%= currentPage %> / <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="/hadis/<%= slug %>?page=<%= currentPage + 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            Selanjutnya
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        <% } %>
      </div>
    <% } %>
  </section>
</main>
