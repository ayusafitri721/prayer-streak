<%
  const currentPage = pagination ? pagination.currentPage : 1;
  const totalPages = pagination ? pagination.totalPages : 1;
  const savedFavoriteSet = new Set(savedFavoriteReferences || []);
%>

<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <a href="/hadis" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke daftar perawi
    </a>

    <div class="mt-6 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#588157]/10">
        <svg class="h-7 w-7 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41]"><%= name %></h1>
      <div class="mt-3 flex flex-wrap justify-center gap-2 text-xs">
        <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]"><%= total.toLocaleString("id-ID") %> hadis</span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70">Halaman <%= currentPage %> dari <%= totalPages %></span>
      </div>
      <div class="mx-auto mt-5 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-[minmax(0,1fr)_220px]">
      <label class="block">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            placeholder="Cari hadis di halaman ini (nomor / terjemahan)"
            class="w-full rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] py-3 pl-11 pr-4 text-[#344E41] outline-none transition placeholder:text-[#344E41]/40 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
            data-hadis-filter-input
          />
        </div>
      </label>
      <form class="flex gap-2" data-hadis-jump-form>
        <input
          type="number"
          min="1"
          inputmode="numeric"
          placeholder="No. hadis"
          class="w-full rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] px-4 py-3 text-sm text-[#344E41] outline-none transition placeholder:text-[#344E41]/40 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
          data-hadis-jump-input
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-2xl bg-[#588157] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#4B6F4E]"
        >
          Buka
        </button>
      </form>
    </div>

    <p class="mt-3 text-sm text-[#344E41]/65" data-hadis-filter-info>
      Menampilkan <%= items.length %> hadis pada halaman ini.
    </p>

    <div class="mt-4 space-y-3" data-hadis-list>
      <% items.forEach((item) => { %>
        <% const itemIsFavorite = savedFavoriteSet.has(`hadis:${slug}:${item.number}`); %>
        <article
          class="group relative overflow-hidden rounded-[1.5rem] border <%= itemIsFavorite ? 'border-[#588157]/50 bg-[#588157]/10' : 'border-[#A3B18A]/35 bg-white/90' %> transition hover:-translate-y-0.5 hover:border-[#588157]/55 hover:shadow-[0_16px_32px_rgba(52,78,65,0.14)]"
          data-hadis-item
          data-hadis-number="<%= item.number %>"
          data-hadis-search-value="<%= `${item.number} ${item.id}`.toLowerCase() %>"
          data-detail-url="/hadis/<%= slug %>/<%= item.number %>"
        >
          <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-[#588157] via-[#A3B18A] to-[#D4A373] opacity-80"></div>
          <div class="p-4 sm:p-5">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-full border border-[#588157]/30 bg-[#588157]/12 px-2 text-xs font-black text-[#588157]">
                  <%= item.number %>
                </span>
                <span class="rounded-full border border-[#A3B18A]/35 bg-[#F6F1E9] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#344E41]/72">
                  HR. <%= name %>
                </span>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <form action="/favorites" method="POST">
                  <input type="hidden" name="type" value="hadis">
                  <input type="hidden" name="title" value="HR. <%= name %> No. <%= item.number %>">
                  <input type="hidden" name="reference" value="hadis:<%= slug %>:<%= item.number %>">
                  <input type="hidden" name="content" value="<%= item.id %>">
                  <input type="hidden" name="sourceUrl" value="/hadis/<%= slug %>/<%= item.number %>">
                  <button
                    type="submit"
                    class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-bold transition <%= itemIsFavorite ? 'border-[#588157] bg-[#588157] text-white shadow-sm shadow-[#588157]/25' : 'border-[#A3B18A]/35 bg-white/80 text-[#588157] hover:bg-[#588157] hover:text-white' %>"
                    title="<%= itemIsFavorite ? 'Sudah tersimpan di favorit' : 'Simpan hadis ke favorit' %>"
                  >
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <% if (itemIsFavorite) { %>
                        <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                      <% } else { %>
                        <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.2l-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                      <% } %>
                    </svg>
                    <%= itemIsFavorite ? 'Tersimpan' : 'Favorit' %>
                  </button>
                </form>
                <a href="/hadis/<%= slug %>/<%= item.number %>" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#A3B18A]/30 bg-white/80 text-[#588157] transition hover:bg-[#588157] hover:text-white" aria-label="Buka hadis <%= item.number %>">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="mt-3 rounded-2xl border border-[#A3B18A]/28 bg-[#F6F1E9]/85 px-3 py-3">
              <p class="line-clamp-3 text-right font-[Amiri,serif] text-xl leading-[1.9] text-[#2E3E36]" dir="rtl">
                <%= item.arab.length > 220 ? item.arab.substring(0, 220) + '...' : item.arab %>
              </p>
            </div>

            <p class="mt-3 line-clamp-3 text-sm leading-7 text-[#344E41]/82">
              <%= item.id.length > 240 ? item.id.substring(0, 240) + '...' : item.id %>
            </p>

            <div class="mt-3 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-[#588157]">Tap untuk baca penuh</span>
              <span class="text-[11px] font-medium text-[#344E41]/55">No. <%= item.number %></span>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <div class="mt-6 hidden rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60" data-hadis-filter-empty>
      <svg class="mx-auto h-10 w-10 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="mt-3">Tidak ada hadis yang cocok di halaman ini.</p>
    </div>

    <% if (!items.length) { %>
      <div class="mt-6 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60">
        <p>Tidak ada hadis ditemukan pada halaman ini.</p>
      </div>
    <% } %>

    <% if (totalPages > 1) { %>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <% if (currentPage > 1) { %>
          <a href="/hadis/<%= slug %>?page=<%= currentPage - 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Sebelumnya
          </a>
        <% } %>

        <span class="rounded-full border border-[#A3B18A]/30 bg-white px-4 py-2 text-sm font-semibold text-[#588157]">
          <%= currentPage %> / <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="/hadis/<%= slug %>?page=<%= currentPage + 1 %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
            Selanjutnya
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        <% } %>
      </div>
    <% } %>
  </section>
</main>

<script>
(() => {
  const filterInput = document.querySelector("[data-hadis-filter-input]");
  const infoEl = document.querySelector("[data-hadis-filter-info]");
  const emptyEl = document.querySelector("[data-hadis-filter-empty]");
  const cards = Array.from(document.querySelectorAll("[data-hadis-item]"));
  const jumpForm = document.querySelector("[data-hadis-jump-form]");
  const jumpInput = document.querySelector("[data-hadis-jump-input]");

  if (!cards.length) return;

  const applyFilter = () => {
    const query = (filterInput?.value || "").trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const haystack = card.getAttribute("data-hadis-search-value") || "";
      const isMatch = !query || haystack.includes(query);
      card.classList.toggle("hidden", !isMatch);
      if (isMatch) visibleCount += 1;
    });

    if (infoEl) {
      infoEl.textContent = query
        ? `Hasil: ${visibleCount} hadis cocok dari ${cards.length} hadis pada halaman ini.`
        : `Menampilkan ${cards.length} hadis pada halaman ini.`;
    }
    if (emptyEl) {
      emptyEl.classList.toggle("hidden", visibleCount > 0);
    }
  };

  filterInput?.addEventListener("input", applyFilter);
  applyFilter();

  jumpForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const target = Number((jumpInput?.value || "").trim());
    if (!Number.isFinite(target) || target < 1) return;
    const found = cards.find((card) => Number(card.getAttribute("data-hadis-number")) === target);
    if (found) {
      window.location.href = found.getAttribute("data-detail-url");
      return;
    }
    if (filterInput) {
      filterInput.value = String(target);
      applyFilter();
      filterInput.focus();
    }
  });
})();
</script>
