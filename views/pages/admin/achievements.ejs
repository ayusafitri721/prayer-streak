<%
  const topAchievementName = adminAchievementSummary.mostUnlocked.name;
%>

<main class="mx-auto flex w-full max-w-[92rem] flex-col gap-5 px-3 py-4 text-[#344E41] sm:px-5 lg:px-6">
  <section class="overflow-hidden rounded-2xl border border-[#E6DDD1] bg-white/95 p-6 shadow-[0_12px_35px_rgba(52,78,65,0.07)]">
    <div class="grid gap-5 lg:grid-cols-[1fr_20rem] lg:items-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.22em] text-[#588157]">Admin Achievement Monitoring</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-[#244338] sm:text-4xl">Pantau achievement seluruh user</h1>
        <p class="mt-3 max-w-3xl text-sm font-semibold leading-6 text-[#344E41]/64">
          Halaman ini menampilkan distribusi achievement aplikasi, user paling aktif, badge yang populer, dan achievement yang belum pernah terbuka.
        </p>
      </div>
      <div class="rounded-2xl bg-[#2F5946] p-5 text-white">
        <p class="text-sm font-semibold text-white/70">Achievement paling populer</p>
        <p class="mt-2 text-2xl font-black"><%= topAchievementName %></p>
        <p class="mt-2 text-sm font-semibold text-[#D4A373]"><%= adminAchievementSummary.mostUnlocked.count %> unlock</p>
      </div>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Total Unlock</p>
      <p class="mt-2 text-3xl font-black text-[#244338]"><%= adminAchievementSummary.totalUnlocked %></p>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">achievement terbuka</p>
    </article>
    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">User Aktif Badge</p>
      <p class="mt-2 text-3xl font-black text-[#244338]"><%= adminAchievementSummary.usersWithAchievements %></p>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">dari <%= adminAchievementSummary.totalUsers %> user</p>
    </article>
    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Badge Catalog</p>
      <p class="mt-2 text-3xl font-black text-[#244338]"><%= adminAchievementSummary.catalogCount %></p>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">achievement sistem</p>
    </article>
    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Belum Terbuka</p>
      <p class="mt-2 text-3xl font-black text-[#244338]"><%= adminAchievementSummary.neverUnlocked %></p>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">perlu dipantau</p>
    </article>
  </section>

  <section class="grid w-full gap-5 xl:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]">
    <div class="min-w-0 rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="mb-4">
        <h2 class="text-xl font-black text-[#244338]">Achievement Catalog</h2>
        <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Jumlah user yang membuka setiap achievement.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-[#E8E0D5]">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead class="bg-[#FBF8F2] text-[0.68rem] font-black uppercase tracking-[0.18em] text-[#344E41]/58">
            <tr>
              <th class="px-4 py-3">Achievement</th>
              <th class="px-4 py-3">Target</th>
              <th class="px-4 py-3">Unlock</th>
              <th class="px-4 py-3">Persentase</th>
              <th class="px-4 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E8E0D5] bg-white">
            <% achievementCatalog.forEach((item) => { %>
              <tr class="hover:bg-[#F8F5EE]">
                <td class="px-4 py-3">
                  <p class="font-black text-[#244338]"><%= item.name %></p>
                  <p class="mt-0.5 text-xs font-semibold text-[#344E41]/50"><%= item.description %></p>
                </td>
                <td class="px-4 py-3 font-semibold text-[#344E41]/68"><%= item.targetType %> <%= item.targetValue %></td>
                <td class="px-4 py-3 font-black text-[#244338]"><%= item.unlockedCount %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="h-2 w-24 overflow-hidden rounded-full bg-[#E8E0D5]">
                      <div class="h-full rounded-full bg-[#588157]" style="width: <%= item.percent %>%"></div>
                    </div>
                    <span class="text-xs font-black text-[#588157]"><%= item.percent %>%</span>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class="<%= item.status === 'Populer' ? 'bg-[#A3B18A]/20 text-[#3F6F42]' : item.status === 'Jarang' ? 'bg-[#FFF2D9] text-[#9A651F]' : 'bg-[#F6F1E9] text-[#344E41]/60' %> rounded-full px-3 py-1 text-xs font-black"><%= item.status %></span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="grid min-w-0 gap-5">
      <aside class="w-full rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
        <h2 class="text-xl font-black text-[#244338]">Top Users</h2>
        <div class="mt-4 space-y-3">
          <% if (topUsers.length) { %>
            <% topUsers.forEach((item, index) => { %>
              <div class="flex items-center justify-between gap-4 rounded-xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="grid h-10 w-10 place-items-center overflow-hidden rounded-full bg-[#588157] text-sm font-black text-white">
                    <% if (item.profileImage) { %>
                      <img src="<%= item.profileImage %>" alt="Foto <%= item.name %>" class="h-full w-full object-cover" />
                    <% } else { %>
                      <%= item.name ? item.name.charAt(0).toUpperCase() : "U" %>
                    <% } %>
                  </span>
                  <div>
                    <p class="font-black text-[#244338]"><%= index + 1 %>. <%= item.name %></p>
                    <p class="text-xs font-semibold text-[#344E41]/50"><%= item.achievements[0]?.achievement?.name || "Belum ada latest badge" %></p>
                  </div>
                </div>
                <span class="rounded-full bg-[#EAF3E5] px-3 py-1 text-xs font-black text-[#3F6F42]"><%= item._count.achievements %> badge</span>
              </div>
            <% }) %>
          <% } else { %>
            <p class="rounded-xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-6 text-sm font-semibold text-[#344E41]/58">Belum ada user dengan achievement.</p>
          <% } %>
        </div>
      </aside>

      <aside class="w-full rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
        <h2 class="text-xl font-black text-[#244338]">Recent Unlock Activity</h2>
        <div class="mt-4 space-y-3">
          <% if (recentUnlocks.length) { %>
            <% recentUnlocks.forEach((item) => { %>
              <div class="rounded-xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-3">
                <p class="font-black text-[#244338]"><%= item.user.name %></p>
                <p class="mt-1 text-sm font-semibold text-[#344E41]/64">membuka <span class="font-black text-[#588157]"><%= item.achievement.name %></span></p>
                <p class="mt-1 text-xs font-semibold text-[#344E41]/45"><%= item.unlockedAt.toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" }) %></p>
              </div>
            <% }) %>
          <% } else { %>
            <p class="rounded-xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-6 text-sm font-semibold text-[#344E41]/58">Belum ada aktivitas unlock.</p>
          <% } %>
        </div>
      </aside>
    </div>
  </section>
</main>
