<%
  const summary = adminStatsSummary || {};
  const weeklyPercent = Math.min(summary.consistencyPercent || 0, 100);
  const monthlyPercent = Math.min(summary.monthlyPercent || 0, 100);
  const heatmapClass = {
    great: "bg-[#3F6F42]",
    good: "bg-[#9EB985]",
    low: "bg-[#D4A373]",
    empty: "bg-[#E8E2D7]",
  };
  const insightClass = {
    success: "bg-[#EAF3E5] text-[#4F7F53]",
    warning: "bg-[#FFF2D9] text-[#B7792D]",
    info: "bg-[#EAF5F6] text-[#3D8AA0]",
    spark: "bg-[#F6F1E9] text-[#588157]",
  };
%>

<main class="mx-auto flex w-full max-w-[92rem] flex-col gap-5 px-3 py-4 text-[#344E41] sm:px-5 lg:px-6">
  <section class="overflow-hidden rounded-[1.7rem] border border-[#E6DDD1] bg-white/95 p-6 shadow-[0_14px_40px_rgba(52,78,65,0.07)]">
    <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr] xl:items-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.22em] text-[#588157]">Admin Statistics Monitoring</p>
        <h1 class="mt-3 text-3xl font-black leading-tight text-[#244338] sm:text-4xl">Statistik aktivitas seluruh user</h1>
        <p class="mt-3 max-w-3xl text-sm font-semibold leading-6 text-[#344E41]/64">
          Pantau kesehatan aplikasi dari checklist salat wajib, ibadah sunnah, streak, XP, achievement, dan bookmark spiritual pengguna.
        </p>
      </div>

      <div class="relative overflow-hidden rounded-[1.45rem] bg-[#2F5946] p-5 text-white shadow-lg shadow-[#344E41]/10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_12%,rgba(163,177,138,0.24),transparent_28%),linear-gradient(135deg,rgba(255,255,255,0.08),transparent_48%)]"></div>
        <div class="relative grid gap-5 sm:grid-cols-[1fr_auto_1fr] sm:items-center">
          <div>
            <p class="text-sm font-bold text-white/74">Konsistensi Minggu Ini</p>
            <p class="mt-2 text-4xl font-black"><%= weeklyPercent %>%</p>
            <p class="mt-2 text-base font-bold text-white/82"><%= summary.totalThisWeek || 0 %> / <%= summary.weeklyTarget || 0 %> salat wajib</p>
          </div>
          <div class="grid h-28 w-28 place-items-center rounded-full" style="background: conic-gradient(#A3B18A <%= weeklyPercent %>%, #D4A373 <%= weeklyPercent %>%, rgba(255,255,255,0.14) 0);">
            <div class="h-20 w-20 rounded-full bg-[#2F5946]"></div>
          </div>
          <div class="space-y-2 text-sm font-bold text-white/78">
            <p><span class="text-white"><%= summary.activeUsersThisWeek || 0 %></span> user aktif minggu ini</p>
            <p><span class="text-white"><%= summary.usersFullToday || 0 %></span> user full 5/5 hari ini</p>
            <p><span class="text-white"><%= summary.remainingThisWeek || 0 %></span> salat menuju target mingguan</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Total User</p>
          <p class="mt-2 text-3xl font-black text-[#244338]"><%= summary.totalUsers || 0 %></p>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58"><%= summary.activeUsersToday || 0 %> aktif hari ini</p>
        </div>
        <span class="grid h-12 w-12 place-items-center rounded-full bg-[#EAF3E5] text-[#588157]">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 11a4 4 0 1 0-8 0m8 0a4 4 0 1 1-8 0m8 0c2.7.8 4 2.6 4 5v1H4v-1c0-2.4 1.3-4.2 4-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </span>
      </div>
    </article>

    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Checklist Wajib</p>
          <p class="mt-2 text-3xl font-black text-[#244338]"><%= summary.totalThisWeek || 0 %></p>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">minggu ini</p>
        </div>
        <span class="grid h-12 w-12 place-items-center rounded-full bg-[#EEF3E6] text-[#588157]">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
    </article>

    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Ibadah Sunnah</p>
          <p class="mt-2 text-3xl font-black text-[#244338]"><%= summary.totalSunnahThisWeek || 0 %></p>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">bonus tercatat</p>
        </div>
        <span class="grid h-12 w-12 place-items-center rounded-full bg-[#FFF4DE] text-[#B7792D]">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M5 8h14M6 16h12M8 3h8a2 2 0 0 1 2 2v14H6V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
    </article>

    <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">XP Mingguan</p>
          <p class="mt-2 text-3xl font-black text-[#244338]"><%= summary.totalXpThisWeek || 0 %></p>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">XP dari semua user</p>
        </div>
        <span class="grid h-12 w-12 place-items-center rounded-full bg-[#EAF3E5] text-[#588157]">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m13 2-8 12h6l-1 8 9-13h-6l1-7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </span>
      </div>
    </article>
  </section>

  <section class="grid w-full gap-5 xl:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)]">
    <div class="min-w-0 rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-black text-[#244338]">Aktivitas 7 Hari</h2>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Perbandingan checklist wajib dan sunnah seluruh user.</p>
        </div>
        <span class="rounded-full bg-[#EAF3E5] px-4 py-2 text-sm font-black text-[#588157]">Target wajib: <%= summary.weeklyTarget || 0 %></span>
      </div>

      <div class="mt-8 grid grid-cols-7 items-end gap-4">
        <% weeklyBreakdown.forEach((day, index) => { %>
          <div class="<%= day.isToday ? 'rounded-3xl border-2 border-[#A3B18A] p-2' : '' %> flex min-h-52 flex-col items-center justify-end gap-3">
            <div class="relative flex h-36 w-full max-w-16 items-end overflow-hidden rounded-full border border-[#E8E0D5] bg-[#F8F5EE]">
              <div class="stats-bar w-full rounded-full bg-[#588157]" style="--bar-height: <%= Math.max(day.percent, day.fardhu ? 12 : 3) %>%; animation-delay: <%= index * 70 %>ms;"></div>
              <div class="absolute bottom-0 left-1/2 w-1/2 -translate-x-1/2 rounded-full bg-[#D4A373]/75" style="height: <%= Math.min(100, Math.max(day.sunnah ? 8 : 0, Math.round((day.sunnah / Math.max(day.target, 1)) * 100))) %>%;"></div>
            </div>
            <div class="text-center">
              <p class="<%= day.fardhu ? 'bg-[#588157] text-white' : 'bg-[#E8E2D7] text-[#344E41]/45' %> rounded-full px-3 py-1 text-xs font-black"><%= day.fardhu %>/<%= day.target %></p>
              <p class="mt-1 text-[11px] font-black text-[#B7792D]">+<%= day.sunnah %> sunnah</p>
              <p class="mt-1 text-xs font-bold text-[#344E41]/68"><%= day.label %></p>
              <% if (day.isToday) { %>
                <p class="text-[11px] font-black text-[#588157]">Hari ini</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="grid min-w-0 gap-5">
      <aside class="w-full rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
        <h2 class="text-xl font-black text-[#244338]">Kalender Aktivitas</h2>
        <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Heatmap aktivitas 30 hari terakhir.</p>
        <p class="mt-5 text-center text-sm font-black text-[#344E41]/72"><%= currentMonthLabel %></p>
        <div class="mx-auto mt-5 grid max-w-xl grid-cols-10 gap-2">
          <% heatmapDays.forEach((day) => { %>
            <div class="h-4 w-4 rounded <%= heatmapClass[day.level] %>" title="<%= day.label %>: <%= day.completed %>/<%= day.target %> salat"></div>
          <% }) %>
        </div>
        <div class="mt-6 grid gap-2 text-xs font-semibold text-[#344E41]/62 sm:grid-cols-2">
          <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#3F6F42]"></i>Sangat aktif</span>
          <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#9EB985]"></i>Baik</span>
          <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#D4A373]"></i>Cukup</span>
          <span class="inline-flex items-center gap-2"><i class="h-3 w-3 rounded bg-[#E8E2D7]"></i>Tidak ada</span>
        </div>
      </aside>

      <aside class="w-full rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
        <h2 class="text-xl font-black text-[#244338]">Ringkasan Spiritual</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-[#F8F5EE] p-4">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Bookmark</p>
            <p class="mt-2 text-2xl font-black"><%= summary.totalBookmarks || 0 %></p>
            <p class="mt-1 text-xs font-semibold text-[#344E41]/56"><%= summary.todayFavorites || 0 %> baru hari ini</p>
          </div>
          <div class="rounded-2xl bg-[#F8F5EE] p-4">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Achievement</p>
            <p class="mt-2 text-2xl font-black"><%= summary.achievementsUnlocked || 0 %></p>
            <p class="mt-1 text-xs font-semibold text-[#344E41]/56">unlock keseluruhan</p>
          </div>
          <div class="rounded-2xl bg-[#F8F5EE] p-4">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Qur'an</p>
            <p class="mt-2 text-2xl font-black"><%= summary.quranBookmarks || 0 %></p>
          </div>
          <div class="rounded-2xl bg-[#F8F5EE] p-4">
            <p class="text-xs font-black uppercase tracking-[0.18em] text-[#588157]">Hadis & Doa</p>
            <p class="mt-2 text-2xl font-black"><%= (summary.hadisBookmarks || 0) + (summary.doaBookmarks || 0) %></p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="grid gap-5 lg:grid-cols-[0.95fr_0.95fr_1.1fr]">
    <div class="rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <h2 class="text-xl font-black text-[#244338]">Performa Salat Wajib</h2>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Persentase semua user dalam 7 hari terakhir.</p>
      <div class="mt-5 space-y-4">
        <% prayerPerformance.forEach((item) => { %>
          <div class="grid grid-cols-[5.5rem_1fr_3rem] items-center gap-3">
            <p class="text-sm font-black text-[#344E41]"><%= item.label %></p>
            <div class="h-3 overflow-hidden rounded-full bg-[#E8E0D5]">
              <div class="dashboard-progress h-full rounded-full bg-[#588157]" style="--progress-width: <%= item.percent %>%; width: <%= item.percent %>%"></div>
            </div>
            <p class="text-right text-sm font-black text-[#344E41]/72"><%= item.percent %>%</p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <h2 class="text-xl font-black text-[#244338]">Performa Sunnah</h2>
      <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Tidak memengaruhi streak utama, tapi jadi sinyal engagement.</p>
      <div class="mt-5 space-y-4">
        <% sunnahPerformance.forEach((item) => { %>
          <div class="grid grid-cols-[7rem_1fr_3rem] items-center gap-3">
            <p class="truncate text-sm font-black text-[#344E41]"><%= item.label %></p>
            <div class="h-3 overflow-hidden rounded-full bg-[#E8E0D5]">
              <div class="dashboard-progress h-full rounded-full bg-[#D4A373]" style="--progress-width: <%= item.percent %>%; width: <%= item.percent %>%"></div>
            </div>
            <p class="text-right text-sm font-black text-[#344E41]/72"><%= item.percent %>%</p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <h2 class="text-xl font-black text-[#244338]">Insight Admin</h2>
      <div class="mt-5 space-y-3">
        <% adminInsights.forEach((insight) => { %>
          <div class="flex gap-3 rounded-2xl bg-[#F8F5EE] p-3">
            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full <%= insightClass[insight.type] %>">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <% if (insight.type === "success") { %>
                  <path d="M4 16 10 10l4 4 6-8M14 6h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <% } else if (insight.type === "warning") { %>
                  <path d="M12 8v5M12 17h.01M10.3 4.3 2.8 17.5A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.5L13.7 4.3a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <% } else { %>
                  <path d="M12 17v-6M12 7h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <% } %>
              </svg>
            </div>
            <div>
              <p class="text-sm font-black text-[#344E41]"><%= insight.title %></p>
              <p class="mt-1 text-xs font-semibold text-[#344E41]/58"><%= insight.description %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="grid gap-5 xl:grid-cols-2">
    <div class="rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-black text-[#244338]">Top Konsistensi Mingguan</h2>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Berdasarkan salat wajib, on-time, dan sunnah.</p>
        </div>
        <span class="rounded-full bg-[#EAF3E5] px-3 py-1 text-xs font-black text-[#588157]"><%= summary.activeUsersThisWeek || 0 %> aktif</span>
      </div>
      <div class="mt-4 space-y-3">
        <% if (topConsistencyUsers.length) { %>
          <% topConsistencyUsers.forEach((item, index) => { %>
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-[#588157] text-sm font-black text-white">
                  <% if (item.profileImage) { %>
                    <img src="<%= item.profileImage %>" alt="Foto <%= item.name %>" class="h-full w-full object-cover" />
                  <% } else { %>
                    <%= item.name ? item.name.charAt(0).toUpperCase() : "U" %>
                  <% } %>
                </span>
                <div class="min-w-0">
                  <p class="truncate font-black text-[#244338]"><%= index + 1 %>. <%= item.name %></p>
                  <p class="text-xs font-semibold text-[#344E41]/50"><%= item.fardhu %>/35 wajib, <%= item.sunnah %> sunnah, <%= item.onTime %> on-time</p>
                </div>
              </div>
              <span class="rounded-full bg-[#EAF3E5] px-3 py-1 text-xs font-black text-[#3F6F42]"><%= item.percent %>%</span>
            </div>
          <% }) %>
        <% } else { %>
          <p class="rounded-2xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-6 text-sm font-semibold text-[#344E41]/58">Belum ada aktivitas user minggu ini.</p>
        <% } %>
      </div>
    </div>

    <div class="rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-black text-[#244338]">Top Streak Users</h2>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/58">Berdasarkan longest streak dan streak aktif.</p>
        </div>
        <span class="rounded-full bg-[#FFF4DE] px-3 py-1 text-xs font-black text-[#B7792D]"><%= summary.activeStreakUsers || 0 %> aktif</span>
      </div>
      <div class="mt-4 space-y-3">
        <% if (topStreakUsers.length) { %>
          <% topStreakUsers.forEach((item, index) => { %>
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-[#588157] text-sm font-black text-white">
                  <% if (item.profileImage) { %>
                    <img src="<%= item.profileImage %>" alt="Foto <%= item.name %>" class="h-full w-full object-cover" />
                  <% } else { %>
                    <%= item.name ? item.name.charAt(0).toUpperCase() : "U" %>
                  <% } %>
                </span>
                <div class="min-w-0">
                  <p class="truncate font-black text-[#244338]"><%= index + 1 %>. <%= item.name %></p>
                  <p class="text-xs font-semibold text-[#344E41]/50">Level <%= item.level %>, <%= item.xp %> XP</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-sm font-black text-[#244338]"><%= item.streak %> hari</p>
                <p class="text-xs font-semibold text-[#344E41]/50">rekor <%= item.longestStreak %></p>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="rounded-2xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-6 text-sm font-semibold text-[#344E41]/58">Belum ada data streak.</p>
        <% } %>
      </div>
    </div>
  </section>

  <section class="grid gap-5 lg:grid-cols-[1fr_0.9fr]">
    <div class="rounded-[1.5rem] border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <h2 class="text-xl font-black text-[#244338]">Rekap Bulanan Aplikasi</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-[auto_1fr] sm:items-center">
        <div class="grid h-28 w-28 place-items-center rounded-full" style="background: conic-gradient(#588157 <%= monthlyPercent %>%, #E8E2D7 0);">
          <div class="grid h-20 w-20 place-items-center rounded-full bg-white text-xl font-black text-[#244338]"><%= monthlyPercent %>%</div>
        </div>
        <div>
          <p class="text-2xl font-black text-[#244338]"><%= summary.totalThisMonth || 0 %> / <%= summary.monthlyTarget || 0 %> salat wajib</p>
          <p class="mt-2 text-sm font-semibold text-[#344E41]/58"><%= summary.totalSunnahThisMonth || 0 %> aktivitas sunnah bulan ini</p>
          <p class="mt-2 text-sm font-semibold text-[#344E41]/58"><%= summary.totalAdmins || 0 %> admin aktif mengelola sistem</p>
        </div>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-[1.5rem] bg-[#A3B18A]/82 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)]">
      <img src="/assets/mosque-landing.svg" alt="" class="absolute bottom-0 right-4 w-28 opacity-60">
      <div class="relative max-w-md">
        <p class="text-3xl text-white/75">&ldquo;</p>
        <p class="text-base font-semibold leading-7 text-[#244338]">
          Statistik admin membantu melihat pola ibadah user tanpa mengubah data personal mereka.
        </p>
        <p class="mt-3 text-sm font-black text-[#244338]/72">Monitoring, bukan kompetisi.</p>
      </div>
    </div>
  </section>
</main>
