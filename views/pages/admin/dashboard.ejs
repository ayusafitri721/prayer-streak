<%
  const iconMap = {
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M21 20v-1.4a3.7 3.7 0 0 0-2.8-3.6"/><path d="M16.5 3.4a4 4 0 0 1 0 7.2"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/>',
    check: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
    bookmark: '<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16Z"/>',
    award: '<circle cx="12" cy="8" r="6"/><path d="M15.5 12.9 17 22l-5-3-5 3 1.5-9.1"/>',
    lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
    wrench: '<path d="M14.7 6.3a4 4 0 0 0-5 5L3 18v3h3l6.7-6.7a4 4 0 0 0 5-5l-2.6 2.6-3-3 2.6-2.6Z"/>',
    chart: '<path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-7"/>',
  };
  const statIconTone = {
    green: "bg-[#EAF3E5] text-[#3F6F42]",
    sage: "bg-[#EEF3E6] text-[#588157]",
    gold: "bg-[#FFF2D9] text-[#D39100]",
    cream: "bg-[#F6F1E9] text-[#344E41]",
  };
%>

<style>
  @media (max-width: 1279px) {
    [data-admin-user-scope-grid] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<main class="mx-auto flex w-full max-w-[92rem] flex-col gap-5 px-3 py-4 text-[#344E41] sm:px-5 lg:px-6">
  <section class="overflow-hidden rounded-2xl border border-[#E6DDD1] bg-white/95 px-6 py-5 shadow-[0_12px_35px_rgba(52,78,65,0.07)]">
    <div class="grid items-center gap-5 lg:grid-cols-[1fr_24rem_16rem]">
      <div>
        <h1 class="text-2xl font-black tracking-tight text-[#244338] sm:text-3xl">Selamat datang, Admin!</h1>
        <p class="mt-3 max-w-xl text-sm font-semibold leading-6 text-[#344E41]/68">
          Pantau ringkasan user, aktivitas checklist, bookmark spiritual, dan achievement dari satu halaman admin.
        </p>
      </div>

      <div class="relative hidden h-28 overflow-hidden rounded-2xl bg-[#F6F1E9] lg:block">
        <div class="absolute inset-x-5 bottom-0 h-20 rounded-t-[2rem] bg-[#EAF3E5]"></div>
        <svg class="absolute inset-x-0 bottom-0 mx-auto h-28 w-[22rem]" viewBox="0 0 420 150" fill="none" aria-hidden="true">
          <path d="M52 130c35-25 72-34 111-25 23-32 54-50 92-50 38 0 70 18 95 54 19-6 41-5 66 3v38H52v-20Z" fill="#DDE9D5"/>
          <path d="M106 126V78h24v48M304 126V72h24v54" stroke="#8BA874" stroke-width="9" stroke-linecap="round"/>
          <path d="M118 78h-24M316 72h-24" stroke="#8BA874" stroke-width="7" stroke-linecap="round"/>
          <path d="M168 126V82a42 42 0 0 1 84 0v44H168Z" fill="#588157"/>
          <path d="M176 126V88a34 34 0 0 1 68 0v38H176Z" fill="#F6F1E9"/>
          <path d="M198 126V101a13 13 0 0 1 26 0v25H198Z" fill="#588157"/>
          <path d="M210 43V30" stroke="#D4A373" stroke-width="5" stroke-linecap="round"/>
          <path d="M210 30c9 1 15 7 17 15" stroke="#D4A373" stroke-width="5" stroke-linecap="round"/>
          <path d="M80 126c18-16 41-23 70-20M268 126c28-20 58-27 91-20" stroke="#A3B18A" stroke-width="12" stroke-linecap="round"/>
          <path d="M350 31a24 24 0 1 1-17-29 18 18 0 1 0 17 29Z" fill="#D4A373"/>
          <circle cx="76" cy="42" r="2" fill="#D4A373"/>
          <circle cx="362" cy="70" r="2" fill="#D4A373"/>
          <path d="M56 68h18M65 59v18M376 92h16M384 84v16" stroke="#D4A373" stroke-width="3" stroke-linecap="round"/>
        </svg>
      </div>

      <aside class="rounded-2xl bg-[#2F5946] p-5 text-white shadow-[0_12px_30px_rgba(52,78,65,0.18)]">
        <p class="text-xs font-semibold text-white/72">Login sebagai</p>
        <div class="mt-3 flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-full border border-white/25 text-white">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </span>
          <div>
            <p class="text-xl font-black"><%= user.name %></p>
            <p class="mt-1 text-xs font-black uppercase tracking-[0.2em] text-[#D4A373]">Super Admin</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    <% statCards.forEach((card) => { %>
      <article class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
        <div class="flex items-center gap-4">
          <span class="<%= statIconTone[card.tone] || statIconTone.green %> grid h-14 w-14 shrink-0 place-items-center rounded-2xl">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconMap[card.icon] %></svg>
          </span>
          <div>
            <p class="text-[0.68rem] font-black uppercase tracking-[0.24em] text-[#588157]"><%= card.label.replace("Total ", "") %></p>
            <p class="mt-1 text-3xl font-black leading-none text-[#244338]"><%= card.value %></p>
            <p class="mt-2 text-xs font-semibold text-[#344E41]/58"><%= card.description %></p>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2 text-xs font-semibold text-[#344E41]/62">
          <span class="rounded-full bg-[#EAF3E5] px-2 py-1 font-black text-[#3F6F42]">
            <%= card.growth >= 0 ? "+" : "" %><%= card.growth %>%
          </span>
          <span>dari bulan lalu</span>
        </div>
      </article>
    <% }) %>
  </section>

  <section class="grid w-full gap-5 xl:grid-cols-none" style="grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);" data-admin-user-scope-grid>
    <div class="min-w-0 w-full rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]" id="latest-users">
      <div class="mb-4 flex items-start justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-[#588157]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconMap.users %></svg>
            <h2 class="text-xl font-black text-[#244338]">User Terbaru</h2>
          </div>
          <p class="mt-1 text-sm font-semibold text-[#344E41]/62">Data akun terbaru yang masuk ke Prayer Streak.</p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-xl border border-[#E8E0D5]">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-[#FBF8F2] text-[0.68rem] font-black uppercase tracking-[0.18em] text-[#344E41]/58">
            <tr>
              <th class="px-4 py-3">User</th>
              <th class="px-4 py-3">Email</th>
              <th class="px-4 py-3">Role</th>
              <th class="px-4 py-3">Bergabung</th>
              <th class="px-4 py-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E8E0D5] bg-white">
            <% recentUsers.slice(0, 4).forEach((item) => { %>
              <tr class="hover:bg-[#F8F5EE]">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <span class="grid h-10 w-10 place-items-center overflow-hidden rounded-full bg-[#588157] text-sm font-black text-white">
                      <% if (item.profileImage) { %>
                        <img src="<%= item.profileImage %>" alt="Foto <%= item.name %>" class="h-full w-full object-cover" />
                      <% } else { %>
                        <%= item.name ? item.name.charAt(0).toUpperCase() : "U" %>
                      <% } %>
                    </span>
                    <span class="font-black text-[#244338]"><%= item.name %></span>
                  </div>
                </td>
                <td class="px-4 py-3 font-semibold text-[#344E41]/70"><%= item.email %></td>
                <td class="px-4 py-3">
                  <span class="<%= item.role === 'ADMIN' ? 'bg-[#D4A373]/20 text-[#9A651F]' : 'bg-[#A3B18A]/20 text-[#3F6F42]' %> rounded-full px-3 py-1 text-xs font-black"><%= item.role %></span>
                </td>
                <td class="px-4 py-3 font-semibold text-[#344E41]/60">
                  <%= item.createdAt.toLocaleDateString("id-ID", { day: "2-digit", month: "short", year: "numeric" }) %>
                </td>
                <td class="px-4 py-3 text-right">
                  <a href="/admin/users/<%= item.id %>" class="inline-flex h-9 w-9 items-center justify-center rounded-full text-[#244338] hover:bg-[#EEF3E6]" title="Detail user">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/>
                    </svg>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <a href="/admin/users" class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl border border-[#E8E0D5] bg-[#FBF8F2] px-4 py-3 text-sm font-black text-[#3F6F42] hover:bg-[#EEF3E6]">
        Lihat semua user
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <aside class="min-w-0 w-full rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="flex items-center gap-2">
        <svg class="h-5 w-5 text-[#588157]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconMap.shield %></svg>
        <h2 class="text-xl font-black text-[#244338]">Admin Scope</h2>
      </div>
      <h3 class="mt-5 text-2xl font-black text-[#244338]">Tahap awal</h3>
      <p class="mt-3 text-sm font-semibold leading-6 text-[#344E41]/68">
        Saat ini admin sudah dipisahkan dari user. Tahap berikutnya bisa ditambah manajemen user, reset progress, kelola achievement, dan monitoring aktivitas.
      </p>
      <div class="mt-5 space-y-3">
        <% [
          ["users", "Role admin disimpan di table users."],
          ["lock", "Route admin dilindungi middleware."],
          ["shield", "User biasa tidak bisa membuka /admin."],
          ["wrench", "Akses terbatas hanya untuk admin."],
        ].forEach((item) => { %>
          <p class="flex items-center gap-3 rounded-xl border border-[#E8E0D5] bg-white px-4 py-3 text-sm font-semibold text-[#344E41]/78">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-[#EEF3E6] text-[#588157]">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconMap[item[0]] %></svg>
            </span>
            <%= item[1] %>
          </p>
        <% }) %>
      </div>
    </aside>
  </section>

  <section class="grid gap-5 xl:grid-cols-[1.08fr_0.92fr]">
    <div class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]">
      <div class="mb-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-[#588157]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconMap.chart %></svg>
          <h2 class="text-xl font-black text-[#244338]">Ringkasan Aktivitas</h2>
        </div>
        <select class="rounded-xl border border-[#E8E0D5] bg-white px-4 py-2 text-sm font-semibold text-[#244338] outline-none">
          <option>7 Hari Terakhir</option>
        </select>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% activitySummary.forEach((item) => { %>
          <article class="rounded-xl border border-[#E8E0D5] bg-white p-4">
            <div class="flex items-start gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#EAF3E5] text-[#588157]">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconMap[item.icon] %></svg>
              </span>
              <div>
                <p class="text-2xl font-black text-[#244338]"><%= item.value %></p>
                <p class="mt-1 text-xs font-black text-[#344E41]"><%= item.label %></p>
                <p class="mt-1 text-xs font-semibold leading-4 text-[#344E41]/56"><%= item.description %></p>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>

    <div class="rounded-2xl border border-[#E6DDD1] bg-white/96 p-5 shadow-[0_10px_28px_rgba(52,78,65,0.06)]" id="quick-actions">
      <div class="flex items-center gap-2">
        <svg class="h-5 w-5 text-[#588157]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m13 2-2 8h7l-7 12 2-8H6l7-12Z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h2 class="text-xl font-black text-[#244338]">Aksi Cepat</h2>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <% [
          ["users", "Tambah Admin", "Buat akun admin baru"],
          ["wrench", "Reset Progress", "Reset streak user"],
          ["award", "Kelola Achievement", "Atur achievement"],
          ["bookmark", "Lihat Activity Logs", "Riwayat aktivitas"],
        ].forEach((action) => { %>
          <button type="button" class="flex items-center gap-3 rounded-xl border border-[#E8E0D5] bg-white px-4 py-3 text-left hover:bg-[#F8F5EE]">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#EEF3E6] text-[#588157]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconMap[action[0]] %></svg>
            </span>
            <span>
              <span class="block text-sm font-black text-[#244338]"><%= action[1] %></span>
              <span class="mt-0.5 block text-xs font-semibold text-[#344E41]/55"><%= action[2] %></span>
            </span>
          </button>
        <% }) %>
      </div>
    </div>
  </section>
</main>
