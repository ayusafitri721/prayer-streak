<%
  const audioCount = surahs.filter((surah) => surah.audioUrl).length;
  const makkiyahCount = surahs.filter((surah) => surah.revelation === "Mekah").length;
  const madaniyahCount = surahs.filter((surah) => surah.revelation === "Madinah").length;
  const quickSurahNumbers = [1, 18, 36, 55, 67, 112];
  const quickSurahs = quickSurahNumbers
    .map((number) => surahs.find((surah) => surah.number === number))
    .filter(Boolean);
%>

<main
  class="mx-auto mt-6 w-full max-w-6xl px-4 pb-12 sm:px-6"
  data-quran-home
>
  <section class="relative overflow-hidden rounded-[2.25rem] border border-[#A3B18A]/35 bg-[radial-gradient(circle_at_top_left,_rgba(163,177,138,0.18),_transparent_32%),linear-gradient(145deg,_rgba(255,255,255,0.96)_0%,_rgba(246,241,233,0.94)_48%,_rgba(255,255,255,0.92)_100%)] p-6 shadow-2xl shadow-[#344E41]/10 sm:p-8">
    <div class="absolute -right-12 top-0 h-40 w-40 rounded-full border border-[#A3B18A]/20"></div>
    <div class="absolute -left-8 bottom-0 h-28 w-28 rounded-full bg-[#A3B18A]/10 blur-2xl"></div>

    <div class="relative grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_340px] lg:items-start">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-[#588157]/20 bg-[#588157]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-[#588157]">
          Mushaf Digital
        </span>
        <p class="mt-5 font-[Amiri,serif] text-3xl leading-none text-[#588157] sm:text-4xl" dir="rtl">بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ</p>
        <div class="mt-4 h-px w-28 bg-gradient-to-r from-[#A3B18A] via-[#588157]/50 to-transparent"></div>
        <h1 class="mt-5 max-w-2xl text-3xl font-bold tracking-tight text-[#244338] sm:text-[2.6rem]">
          Baca Al-Qur'an dengan tampilan yang lebih tenang dan mudah dijelajahi.
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-[#344E41]/72 sm:text-base">
          Pilih surat, baca teks Arab lengkap, transliterasi, terjemahan Indonesia, dan lanjutkan ke audio murottal tanpa perlu pindah halaman yang terasa rumit.
        </p>

        <div class="mt-6 flex flex-wrap gap-2.5">
          <span class="rounded-full border border-[#A3B18A]/30 bg-white/75 px-3 py-1.5 text-xs font-medium text-[#344E41]/75">114 surat</span>
          <span class="rounded-full border border-[#A3B18A]/30 bg-white/75 px-3 py-1.5 text-xs font-medium text-[#344E41]/75"><%= audioCount %> surat dengan audio</span>
          <span class="rounded-full border border-[#A3B18A]/30 bg-white/75 px-3 py-1.5 text-xs font-medium text-[#344E41]/75">Transliterasi & terjemahan</span>
        </div>

        <div class="mt-7 max-w-xl">
          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-[#344E41]/45">Cari Surat</span>
            <div class="relative">
              <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="search"
                placeholder="Cari surat... (contoh: Al-Fatihah, Yasin, 36)"
                class="w-full rounded-2xl border border-[#A3B18A]/40 bg-white/80 py-3.5 pl-11 pr-4 text-sm text-[#344E41] outline-none transition placeholder:text-[#344E41]/38 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
                data-surah-search
              />
            </div>
          </label>
        </div>
      </div>

      <aside class="relative rounded-[1.75rem] border border-[#A3B18A]/30 bg-white/72 p-5 shadow-lg shadow-[#344E41]/5 backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#344E41]/45">Ringkasan</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          <div class="rounded-2xl border border-[#A3B18A]/25 bg-[#F6F1E9]/80 px-4 py-3">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#344E41]/45">Total Surat</p>
            <p class="mt-1 text-2xl font-bold text-[#244338]"><%= surahs.length || 114 %></p>
          </div>
          <div class="rounded-2xl border border-[#A3B18A]/25 bg-[#F6F1E9]/80 px-4 py-3">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#344E41]/45">Mekah</p>
            <p class="mt-1 text-2xl font-bold text-[#244338]"><%= makkiyahCount || "-" %></p>
          </div>
          <div class="rounded-2xl border border-[#A3B18A]/25 bg-[#F6F1E9]/80 px-4 py-3">
            <p class="text-[11px] uppercase tracking-[0.2em] text-[#344E41]/45">Madinah</p>
            <p class="mt-1 text-2xl font-bold text-[#244338]"><%= madaniyahCount || "-" %></p>
          </div>
        </div>

        <% if (quickSurahs.length) { %>
          <div class="mt-5">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#344E41]/45">Akses Cepat</p>
            <div class="mt-3 flex flex-wrap gap-2">
              <% quickSurahs.forEach((surah) => { %>
                <a
                  href="/quran/<%= surah.number %>"
                  class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-white px-3 py-2 text-xs font-medium text-[#344E41] transition hover:border-[#588157]/35 hover:bg-[#588157]/8 hover:text-[#588157]"
                >
                  <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-[#588157]/10 px-1 text-[10px] font-bold text-[#588157]"><%= surah.number %></span>
                  <span><%= surah.nameLatin %></span>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </aside>
    </div>
  </section>

  <% if (pageError) { %>
    <div class="mt-5 rounded-[1.6rem] border border-red-300/40 bg-red-50/90 px-5 py-4 text-sm text-red-700 shadow-sm">
      <p class="font-semibold">Daftar surat belum bisa dimuat.</p>
      <p class="mt-1 text-red-700/80"><%= pageError %></p>
    </div>
  <% } %>

  <% if (user) { %>
    <section class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <article class="rounded-[1.9rem] border border-[#588157]/18 bg-[linear-gradient(145deg,_rgba(88,129,87,0.12)_0%,_rgba(255,255,255,0.96)_100%)] p-5 shadow-xl shadow-[#344E41]/6" data-quran-last-read-card>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#588157]/70">Lanjut Baca</p>
        <h2 class="mt-3 text-2xl font-bold text-[#244338]" data-quran-last-read-title>Belum ada bacaan terakhir</h2>
        <p class="mt-2 text-sm leading-6 text-[#344E41]/66" data-quran-last-read-summary>Ayat yang terakhir kamu buka akan muncul di sini.</p>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs" data-quran-last-read-meta></div>
        <a
          href="/quran"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#588157] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#466B47]"
          data-quran-last-read-link
        >
          Buka lagi
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </article>

      <article class="rounded-[1.9rem] border border-[#A3B18A]/30 bg-white/82 p-5 shadow-xl shadow-[#344E41]/5" data-quran-bookmark-panel>
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#344E41]/45">Bookmark Saya</p>
            <h2 class="mt-2 text-2xl font-bold text-[#244338]">Ayat yang disimpan</h2>
          </div>
          <span class="rounded-full border border-[#A3B18A]/25 bg-[#F6F1E9] px-3 py-1 text-xs font-medium text-[#344E41]/62" data-quran-bookmark-count>0 bookmark</span>
        </div>
        <div class="mt-4 space-y-3" data-quran-bookmark-list>
          <div class="rounded-2xl border border-dashed border-[#A3B18A]/35 bg-[#F6F1E9]/70 px-4 py-5 text-sm text-[#344E41]/58">
            Belum ada bookmark ayat. Simpan dari halaman detail surat untuk memunculkannya di sini.
          </div>
        </div>
      </article>
    </section>
  <% } %>

  <section class="mt-5 rounded-[2rem] border border-[#A3B18A]/35 bg-white/80 p-5 shadow-2xl shadow-[#344E41]/8 sm:p-6">
    <div class="flex flex-col gap-3 border-b border-[#A3B18A]/20 pb-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#344E41]/45">Daftar Surat</p>
        <h2 class="mt-2 text-2xl font-bold text-[#244338]">Semua surat dalam satu halaman</h2>
        <p class="mt-1 text-sm text-[#344E41]/65">Scroll biasa atau pakai pencarian di atas untuk langsung menyaring nama surat, nomor, atau terjemahannya.</p>
      </div>
      <div class="inline-flex items-center gap-2 self-start rounded-full border border-[#A3B18A]/25 bg-[#F6F1E9] px-3 py-1.5 text-xs font-medium text-[#344E41]/65">
        <span class="h-2 w-2 rounded-full bg-[#588157]"></span>
        <span><%= surahs.length || 114 %> surat tersedia</span>
      </div>
    </div>

    <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% surahs.forEach((surah) => { %>
        <a
          href="/quran/<%= surah.number %>"
          class="group relative overflow-hidden rounded-[1.7rem] border border-[#A3B18A]/30 bg-[linear-gradient(160deg,_rgba(246,241,233,0.9)_0%,_rgba(255,255,255,0.98)_100%)] p-4 transition duration-200 hover:-translate-y-0.5 hover:border-[#588157]/40 hover:shadow-lg hover:shadow-[#344E41]/10"
          data-surah-card
          data-surah-search-value="<%= `${surah.number} ${surah.nameLatin} ${surah.nameArabic} ${surah.translation}`.toLowerCase() %>"
          data-surah-number="<%= surah.number %>"
          data-surah-name-latin="<%= surah.nameLatin %>"
          data-surah-name-arabic="<%= surah.nameArabic %>"
          data-surah-translation="<%= surah.translation %>"
        >
          <div class="absolute right-0 top-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-[#A3B18A]/10 blur-2xl transition group-hover:bg-[#588157]/12"></div>

          <div class="relative flex items-start gap-4">
            <div class="mt-1 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl border border-[#588157]/20 bg-[#588157]/10 text-sm font-bold text-[#588157] shadow-sm shadow-[#588157]/10">
              <span><%= surah.number %></span>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="truncate text-xl font-bold text-[#244338] transition group-hover:text-[#588157]"><%= surah.nameLatin %></h3>
                  <p class="mt-1 truncate text-sm text-[#344E41]/62"><%= surah.translation %></p>
                </div>
                <div class="flex-shrink-0 text-right">
                  <p class="font-[Amiri,serif] text-2xl leading-none text-[#588157]" dir="rtl"><%= surah.nameArabic %></p>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-2 text-[11px]">
                <span class="rounded-full border border-[#A3B18A]/30 bg-white/80 px-2.5 py-1 text-[#344E41]/72"><%= surah.revelation %></span>
                <span class="rounded-full border border-[#A3B18A]/30 bg-white/80 px-2.5 py-1 text-[#344E41]/72"><%= surah.versesCount %> ayat</span>
                <% if (surah.audioUrl) { %>
                  <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-2.5 py-1 font-medium text-[#588157]">Audio</span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="relative mt-4 flex items-center justify-between border-t border-[#A3B18A]/20 pt-3">
            <p class="text-xs font-medium text-[#344E41]/48">Buka surat dan mulai baca</p>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#A3B18A]/25 bg-white/75 text-[#588157] transition group-hover:border-[#588157]/35 group-hover:bg-[#588157] group-hover:text-white">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="<%= surahs.length || pageError ? 'hidden' : '' %> mt-6 rounded-[1.7rem] border border-[#A3B18A]/30 bg-[#F6F1E9] px-5 py-10 text-center text-[#344E41]/60" data-surah-empty>
      <svg class="mx-auto h-10 w-10 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="mt-3 text-base font-semibold text-[#344E41]/72">Surat tidak ditemukan.</p>
      <p class="mt-1 text-sm text-[#344E41]/55">Coba pakai nama surat, nomor, atau kata dari terjemahannya.</p>
    </div>
  </section>
</main>
