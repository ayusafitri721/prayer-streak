<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <div class="text-center">
      <p class="font-[Amiri,serif] text-3xl text-[#588157]" dir="rtl">بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ</p>
      <div class="mx-auto mt-4 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41]">Al-Qur'an</h1>
      <p class="mt-2 text-[#344E41]/70">
        Pilih surat untuk membaca ayat lengkap beserta transliterasi dan terjemahan bahasa Indonesia.
      </p>
    </div>

    <div class="mt-6 flex justify-center">
      <label class="block w-full max-w-md">
        <div class="relative">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            placeholder="Cari surat... (contoh: Al-Fatihah, Yasin, 36)"
            class="w-full rounded-2xl border border-[#A3B18A]/40 bg-[#F6F1E9] py-3 pl-11 pr-4 text-[#344E41] outline-none transition placeholder:text-[#344E41]/40 focus:border-[#588157] focus:ring-2 focus:ring-[#588157]/20"
            data-surah-search
          />
        </div>
      </label>
    </div>

    <% if (pageError) { %>
      <div class="mt-6 rounded-2xl border border-red-300/40 bg-red-50 px-4 py-3 text-sm text-red-700">
        <%= pageError %>
      </div>
    <% } %>

    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
      <% surahs.forEach((surah) => { %>
        <a
          href="/quran/<%= surah.number %>"
          class="group flex items-center gap-4 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-4 transition hover:border-[#588157]/50 hover:bg-[#A3B18A]/15 hover:shadow-md"
          data-surah-card
          data-surah-search-value="<%= `${surah.number} ${surah.nameLatin} ${surah.nameArabic} ${surah.translation}`.toLowerCase() %>"
        >
          <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl border border-[#588157]/25 bg-[#588157]/10 text-sm font-bold text-[#588157] transition group-hover:bg-[#588157] group-hover:text-white" style="transform: rotate(45deg);">
            <span style="transform: rotate(-45deg);"><%= surah.number %></span>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h2 class="truncate font-bold text-[#344E41]"><%= surah.nameLatin %></h2>
                <p class="truncate text-xs text-[#344E41]/60"><%= surah.translation %></p>
              </div>
              <div class="flex-shrink-0 text-right">
                <p class="font-[Amiri,serif] text-lg text-[#588157]" dir="rtl"><%= surah.nameArabic %></p>
              </div>
            </div>
            <div class="mt-2 flex flex-wrap gap-1.5 text-[10px]">
              <span class="rounded-full border border-[#A3B18A]/30 bg-white/70 px-2 py-0.5 text-[#344E41]/70"><%= surah.revelation %></span>
              <span class="rounded-full border border-[#A3B18A]/30 bg-white/70 px-2 py-0.5 text-[#344E41]/70"><%= surah.versesCount %> ayat</span>
              <% if (surah.audioUrl) { %>
                <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-2 py-0.5 text-[#588157]">Audio</span>
              <% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="<%= surahs.length || pageError ? 'hidden' : '' %> mt-6 rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-8 text-center text-[#344E41]/60" data-surah-empty>
      <svg class="mx-auto h-10 w-10 text-[#A3B18A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <p class="mt-3">Surat tidak ditemukan untuk kata kunci tersebut.</p>
    </div>
  </section>
</main>
