<main class="mx-auto mt-8 w-full max-w-5xl px-4 pb-10 sm:px-6">
  <section class="rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <a href="/quran" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke daftar surat
    </a>

    <div class="mt-6 text-center">
      <div class="inline-flex h-14 w-14 items-center justify-center rounded-xl border border-[#588157]/25 bg-[#588157]/10 text-lg font-bold text-[#588157]" style="transform: rotate(45deg);">
        <span style="transform: rotate(-45deg);"><%= surah.number %></span>
      </div>
      <h1 class="mt-4 text-3xl font-bold text-[#344E41] sm:text-4xl"><%= surah.nameLatin %></h1>
      <p class="mt-2 font-[Amiri,serif] text-2xl text-[#588157]" dir="rtl"><%= surah.nameArabic %></p>
      <p class="mt-2 text-[#344E41]/70"><%= surah.translation %></p>
      <div class="mt-4 flex flex-wrap justify-center gap-2 text-xs">
        <span class="rounded-full border border-[#588157]/25 bg-[#588157]/10 px-3 py-1 font-medium text-[#588157]">Surat <%= surah.number %></span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70"><%= surah.revelation %></span>
        <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-[#344E41]/70"><%= surah.versesCount %> ayat</span>
      </div>
      <div class="mx-auto mt-5 h-px w-32 bg-gradient-to-r from-transparent via-[#A3B18A] to-transparent"></div>
    </div>

    <% if (surah.description) { %>
      <p class="mt-5 text-center text-sm leading-7 text-[#344E41]/70"><%= surah.description %></p>
    <% } %>

    <div class="mt-6 flex flex-wrap justify-center gap-2">
      <% if (previousSurah && previousSurah.number) { %>
        <a href="/quran/<%= previousSurah.number %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <%= previousSurah.nameLatin %>
        </a>
      <% } %>
      <% if (nextSurah && nextSurah.number) { %>
        <a href="/quran/<%= nextSurah.number %>" class="inline-flex items-center gap-2 rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-4 py-2 text-sm text-[#344E41]/80 transition hover:bg-[#A3B18A]/20">
          <%= nextSurah.nameLatin %>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      <% } %>
    </div>
  </section>

  <section class="mt-5 rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-6 shadow-2xl shadow-[#344E41]/10">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-xl font-bold text-[#344E41]">Daftar Ayat</h2>
      <span class="rounded-full border border-[#A3B18A]/30 bg-[#F6F1E9] px-3 py-1 text-xs text-[#344E41]/60"><%= verses.length %> ayat</span>
    </div>

    <div
      class="mt-5 rounded-2xl border border-[#588157]/20 bg-[#588157]/5 p-4"
      data-verse-player
      data-surah-number="<%= surah.number %>"
      data-surah-audio-url="<%= surah.audioUrl || '' %>"
      data-surah-audio-urls="<%= JSON.stringify(surah.audioUrls || {}) %>"
    >
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[#588157]/15">
            <svg class="h-5 w-5 text-[#588157]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M17.95 6.05a8 8 0 010 11.9M6.5 8.8l5.7-3.8v14L6.5 15.2H3v-6.4h3.5z" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-[#344E41]" data-verse-player-title>Dengarkan surat tanpa jeda</p>
            <p class="text-xs text-[#344E41]/50" data-verse-player-status>
              Audio berjalan kontinu. Tombol ayat dipakai untuk lompat ke posisi ayat.
            </p>
          </div>
        </div>
        <div class="flex flex-col items-end gap-2">
          <div class="flex flex-wrap items-center gap-2 text-right">
            <select
              class="rounded-full border border-[#588157]/30 bg-white px-3 py-1.5 text-xs font-medium text-[#344E41] outline-none transition focus:ring-2 focus:ring-[#588157]/20"
              data-qori-select
            >
              <% Object.entries(qoriList).forEach(([key, name]) => { %>
                <option value="<%= key %>" <%= key === "02" ? "selected" : "" %>><%= name %></option>
              <% }) %>
            </select>
            <span class="rounded-full border border-[#A3B18A]/30 bg-white/70 px-3 py-1.5 text-[11px] font-medium text-[#344E41]/65">
              Penanda ayat bersifat perkiraan, termasuk pembuka surat
            </span>
          </div>
          <audio preload="none" class="hidden" data-surah-audio aria-hidden="true" tabindex="-1"></audio>
        </div>
      </div>
    </div>

    <div
      class="mt-5 space-y-4"
      data-verse-section
      data-surah-name-latin="<%= surah.nameLatin %>"
      data-surah-name-arabic="<%= surah.nameArabic %>"
      data-surah-number="<%= surah.number %>"
    >
      <% verses.forEach((verse) => { %>
        <article
          class="rounded-2xl border border-[#A3B18A]/30 bg-[#F6F1E9]/60 p-5 transition"
          data-verse-card
          data-verse-number="<%= verse.number %>"
          data-verse-arabic="<%= verse.arabic %>"
          data-verse-latin="<%= verse.latin || '' %>"
          data-verse-translation="<%= verse.translation %>"
        >
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#588157]/25 bg-[#588157]/10 text-xs font-bold text-[#588157]">
              <%= verse.number %>
            </span>
            <div class="flex items-center gap-1.5">
              <% if (verse.audioUrl) { %>
                <button
                  type="button"
                  class="inline-flex items-center gap-1.5 rounded-full border border-[#A3B18A]/30 bg-white/70 px-3 py-1.5 text-xs font-semibold text-[#344E41]/80 transition hover:bg-[#588157]/10 hover:text-[#588157]"
                  data-verse-play
                  data-verse-number="<%= verse.number %>"
                  data-verse-audio-url="<%= verse.audioUrl %>"
                  data-verse-audio-urls="<%= JSON.stringify(verse.audioUrls) %>"
                >
                  <svg class="pointer-events-none h-3.5 w-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" data-verse-play-icon>
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <span data-verse-play-label>Lompat ke ayat</span>
                </button>
              <% } %>
              <button
                type="button"
                class="inline-flex h-8 w-8 items-center justify-center rounded-full text-[#344E41]/50 transition hover:bg-[#588157]/10 hover:text-[#588157]"
                data-verse-more
              >
                <svg class="h-4 w-4 pointer-events-none" fill="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="5" r="1.5"/>
                  <circle cx="12" cy="12" r="1.5"/>
                  <circle cx="12" cy="19" r="1.5"/>
                </svg>
              </button>
            </div>
          </div>

          <p class="mt-5 text-right font-[Amiri,serif] text-3xl leading-[2.5] text-[#344E41] sm:text-4xl" dir="rtl"><%= verse.arabic %></p>

          <div class="mt-4 h-px bg-gradient-to-r from-transparent via-[#A3B18A]/40 to-transparent"></div>

          <% if (verse.latin) { %>
            <p class="mt-4 text-sm italic leading-7 text-[#588157]"><%= verse.latin %></p>
          <% } %>
          <p class="mt-2 text-sm leading-7 text-[#344E41]/80"><%= verse.translation %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <!-- Hidden share image template 540x960 → scale 2x = 1080x1920 (9:16 story) -->
  <div id="share-image-card" style="position:fixed;left:-9999px;top:0;width:540px;height:960px;font-family:sans-serif;overflow:hidden;">
    <div style="width:100%;height:100%;background:linear-gradient(170deg,#344E41 0%,#588157 50%,#344E41 100%);padding:0 48px;position:relative;display:flex;flex-direction:column;justify-content:center;align-items:center;box-sizing:border-box;">
      <!-- Decorative circles -->
      <div style="position:absolute;top:-40px;right:-40px;width:200px;height:200px;border-radius:50%;border:1.5px solid rgba(255,255,255,0.08);"></div>
      <div style="position:absolute;bottom:60px;left:-60px;width:240px;height:240px;border-radius:50%;border:1.5px solid rgba(255,255,255,0.06);"></div>
      <div style="position:absolute;top:30%;right:30px;width:80px;height:80px;border-radius:50%;border:1px solid rgba(255,255,255,0.05);"></div>
      <div style="position:absolute;bottom:25%;left:20px;width:50px;height:50px;border-radius:50%;border:1px solid rgba(255,255,255,0.04);"></div>

      <!-- Top ornament line -->
      <div style="width:80px;height:2px;background:linear-gradient(90deg,transparent,rgba(163,177,138,0.6),transparent);border-radius:1px;margin-bottom:36px;"></div>

      <!-- Arabic text -->
      <p id="share-arabic" dir="rtl" style="font-family:'Amiri',serif;font-size:36px;line-height:2.2;color:#ffffff;text-align:center;margin:0 0 28px;width:100%;"></p>

      <!-- Separator -->
      <div style="width:50px;height:1px;background:linear-gradient(90deg,transparent,rgba(163,177,138,0.4),transparent);margin-bottom:24px;"></div>

      <!-- Latin transliteration -->
      <p id="share-latin" style="font-size:15px;font-style:italic;line-height:1.9;color:rgba(218,215,205,0.85);text-align:center;margin:0 0 16px;width:100%;"></p>

      <!-- Translation -->
      <p id="share-translation" style="font-size:15px;line-height:1.9;color:rgba(218,215,205,0.7);text-align:center;margin:0 0 36px;width:100%;"></p>

      <!-- Bottom ornament line -->
      <div style="width:80px;height:2px;background:linear-gradient(90deg,transparent,rgba(163,177,138,0.6),transparent);border-radius:1px;margin-bottom:20px;"></div>

      <!-- Surah info -->
      <p id="share-surah-info" style="font-size:14px;color:rgba(218,215,205,0.6);text-align:center;margin:0 0 28px;letter-spacing:0.5px;"></p>

      <!-- Branding -->
      <p style="font-size:11px;color:rgba(218,215,205,0.3);text-align:center;margin:0;letter-spacing:3px;text-transform:uppercase;">Prayer Streak</p>
    </div>
  </div>

  <!-- Context menu -->
  <div id="verse-context-menu" style="display:none;position:fixed;z-index:9999;min-width:200px;background:#fff;border:1px solid rgba(163,177,138,0.4);border-radius:12px;box-shadow:0 8px 30px rgba(52,78,65,0.18);overflow:hidden;">
    <button type="button" data-action="share-image" style="display:flex;align-items:center;gap:10px;width:100%;padding:12px 16px;border:none;background:none;cursor:pointer;font-size:14px;color:#344E41;text-align:left;" onmouseover="this.style.background='#F6F1E9'" onmouseout="this.style.background='none'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#588157" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
      Bagikan sebagai Gambar
    </button>
    <div style="height:1px;background:rgba(163,177,138,0.25);margin:0 12px;"></div>
    <button type="button" data-action="download-image" style="display:flex;align-items:center;gap:10px;width:100%;padding:12px 16px;border:none;background:none;cursor:pointer;font-size:14px;color:#344E41;text-align:left;" onmouseover="this.style.background='#F6F1E9'" onmouseout="this.style.background='none'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#588157" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Unduh Gambar
    </button>
    <div style="height:1px;background:rgba(163,177,138,0.25);margin:0 12px;"></div>
    <button type="button" data-action="copy-text" style="display:flex;align-items:center;gap:10px;width:100%;padding:12px 16px;border:none;background:none;cursor:pointer;font-size:14px;color:#344E41;text-align:left;" onmouseover="this.style.background='#F6F1E9'" onmouseout="this.style.background='none'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#588157" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
      Salin Teks
    </button>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</main>
