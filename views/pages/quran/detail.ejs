<main class="mx-auto mt-8 w-full max-w-6xl px-4 pb-10 sm:px-6">
  <section class="rounded-3xl border border-emerald-200/15 bg-slate-900/85 p-6 shadow-2xl">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <a href="/quran" class="inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-emerald-100 transition hover:bg-white/10">
          Kembali ke daftar surat
        </a>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-sm text-emerald-100">Surat <%= surah.number %></span>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm text-slate-200"><%= surah.revelation %></span>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm text-slate-200"><%= surah.versesCount %> ayat</span>
        </div>
        <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl"><%= surah.nameLatin %></h1>
        <p class="mt-2 text-lg text-emerald-100" dir="rtl"><%= surah.nameArabic %></p>
        <p class="mt-2 text-slate-300"><%= surah.translation %></p>
        <% if (surah.description) { %>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300"><%= surah.description %></p>
        <% } %>
      </div>

      <% if (surah.audioUrl) { %>
        <div class="w-full max-w-md rounded-2xl border border-slate-700/70 bg-slate-950/70 p-4">
          <p class="text-sm font-semibold text-white">Audio Surat</p>
          <p class="mt-1 text-xs text-slate-400">Sumber audio dari EQuran.id API v2.</p>
          <audio controls preload="none" class="mt-4 w-full">
            <source src="<%= surah.audioUrl %>" type="audio/mpeg" />
          </audio>
        </div>
      <% } %>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <% if (previousSurah && previousSurah.number) { %>
        <a href="/quran/<%= previousSurah.number %>" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 transition hover:bg-white/10">
          Surat sebelumnya: <%= previousSurah.nameLatin %>
        </a>
      <% } %>
      <% if (nextSurah && nextSurah.number) { %>
        <a href="/quran/<%= nextSurah.number %>" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 transition hover:bg-white/10">
          Surat berikutnya: <%= nextSurah.nameLatin %>
        </a>
      <% } %>
    </div>
  </section>

  <section class="mt-6 rounded-3xl border border-emerald-200/15 bg-slate-900/85 p-6 shadow-2xl">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-2xl font-bold text-white">Daftar Ayat</h2>
      <p class="text-sm text-slate-400"><%= verses.length %> ayat ditampilkan</p>
    </div>

    <div class="mt-6 rounded-2xl border border-emerald-300/15 bg-slate-950/70 p-4" data-verse-player>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-200">Pemutar Ayat</p>
          <p class="mt-2 text-lg font-semibold text-white" data-verse-player-title>Pilih ayat untuk mulai mendengarkan</p>
          <p class="mt-1 text-sm text-slate-400" data-verse-player-status>Audio ayat akan diputar langsung di halaman ini.</p>
        </div>
        <audio controls preload="none" class="w-full max-w-xl" data-verse-audio></audio>
      </div>
    </div>

    <div class="mt-6 space-y-4">
      <% verses.forEach((verse) => { %>
        <article
          class="rounded-2xl border border-slate-700/70 bg-slate-900/75 p-5 transition"
          data-verse-card
          data-verse-number="<%= verse.number %>"
        >
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-emerald-300/20 bg-emerald-300/10 text-sm font-semibold text-emerald-100">
              <%= verse.number %>
            </span>
            <% if (verse.audioUrl) { %>
              <button
                type="button"
                class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-slate-200 transition hover:bg-white/10"
                data-verse-play
                data-verse-number="<%= verse.number %>"
                data-verse-audio-url="<%= verse.audioUrl %>"
              >
                Putar ayat
              </button>
            <% } %>
          </div>
          <p class="mt-5 text-right text-3xl leading-loose text-white sm:text-4xl" dir="rtl"><%= verse.arabic %></p>
          <% if (verse.latin) { %>
            <p class="mt-4 text-sm italic leading-7 text-emerald-100"><%= verse.latin %></p>
          <% } %>
          <p class="mt-3 text-base leading-7 text-slate-300"><%= verse.translation %></p>
        </article>
      <% }) %>
    </div>
  </section>
</main>
