<main class="mx-auto flex min-h-[calc(100vh-73px)] w-full max-w-lg items-center px-4 py-10">
  <section class="w-full rounded-[2rem] border border-[#A3B18A]/40 bg-white/80 p-8 shadow-2xl shadow-[#344E41]/10">
    <h1 class="text-3xl font-bold text-[#344E41]">Login</h1>
    <p class="mt-2 text-sm leading-6 text-[#344E41]/75">Lanjut ke akunmu dan lanjutkan streak hari ini.</p>
    <form class="mt-8 space-y-4" action="/login" method="POST">
      <div>
        <label class="mb-1 block text-sm font-medium text-[#344E41]" for="email">Email</label>
        <input id="email" name="email" type="email" placeholder="nama@email.com" class="w-full rounded-xl border border-[#A3B18A]/50 bg-[#F6F1E9] px-4 py-3 text-[#344E41] outline-none transition placeholder:text-[#344E41]/45 focus:border-[#588157] focus:bg-white" required />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-[#344E41]" for="password">Password</label>
        <input id="password" name="password" type="password" class="w-full rounded-xl border border-[#A3B18A]/50 bg-[#F6F1E9] px-4 py-3 text-[#344E41] outline-none transition focus:border-[#588157] focus:bg-white" required />
      </div>
      <button type="submit" class="w-full rounded-xl bg-[#588157] px-4 py-3 font-semibold text-white transition hover:bg-[#D4A373] hover:text-[#344E41]">
        Login
      </button>
    </form>
    <p class="mt-5 text-sm text-[#344E41]/75">
      Belum punya akun?
      <a href="/register" class="font-semibold text-[#588157] underline">Register</a>
    </p>
  </section>
</main>
