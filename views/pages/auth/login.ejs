<main class="min-h-screen bg-white text-[#344E41]">
  <div class="mx-auto grid min-h-screen w-full max-w-7xl grid-cols-1 items-center gap-10 px-6 py-8 lg:grid-cols-2 lg:px-12">
    <section class="mx-auto w-full max-w-md">
      <a href="/" class="mb-10 inline-flex items-center gap-3 text-[#344E41]">
        <span class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-2xl shadow-md shadow-[#344E41]/10">
          <img src="/assets/prayer-streak-logo.svg" alt="" class="h-full w-full" />
        </span>
        <span class="text-lg font-bold">Prayer Streak</span>
      </a>

      <div>
        <h1 class="text-4xl font-bold tracking-tight text-[#111827] sm:text-5xl">Welcome back!</h1>
        <p class="mt-4 max-w-sm text-center text-sm leading-6 text-[#344E41]/65 sm:text-left">
          Masuk untuk melanjutkan tracking salat, menjaga streak, dan melihat progress harianmu.
        </p>
      </div>

      <form class="mt-10 space-y-4" action="/login" method="POST" data-auth-submit="login">
        <div>
          <label class="mb-2 block text-sm font-semibold text-[#344E41]" for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="Email"
            class="w-full rounded-full border border-[#344E41]/35 bg-white px-7 py-4 text-[#344E41] outline-none transition placeholder:text-[#344E41]/45 focus:border-[#588157] focus:ring-4 focus:ring-[#A3B18A]/25"
            required
          />
        </div>
        <div>
          <label class="mb-2 block text-sm font-semibold text-[#344E41]" for="password">Password</label>
          <div class="relative">
            <input
              id="password"
              name="password"
              type="password"
              placeholder="Password"
              class="w-full appearance-none rounded-full border border-[#344E41]/35 bg-white px-7 py-4 pr-16 text-[#344E41] outline-none transition placeholder:text-[#344E41]/45 focus:border-[#588157] focus:ring-4 focus:ring-[#A3B18A]/25"
              data-password-input="login-password"
              required
            />
            <button type="button" class="absolute right-5 top-1/2 -translate-y-1/2 text-[#588157] hover:text-[#344E41]" data-password-toggle="login-password" aria-label="Tampilkan password">
              <svg class="h-5 w-5" data-password-icon="show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2.5 12S5.8 5.5 12 5.5 21.5 12 21.5 12 18.2 18.5 12 18.5 2.5 12 2.5 12Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <svg class="hidden h-5 w-5" data-password-icon="hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3l18 18" />
                <path d="M10.6 10.6A3 3 0 0 0 13.4 13.4" />
                <path d="M9.9 5.8A8.8 8.8 0 0 1 12 5.5C18.2 5.5 21.5 12 21.5 12a17.8 17.8 0 0 1-3.2 4.1" />
                <path d="M6.5 7.4A18.4 18.4 0 0 0 2.5 12S5.8 18.5 12 18.5a8.7 8.7 0 0 0 3.2-.6" />
              </svg>
            </button>
          </div>
        </div>

        <div class="flex justify-end">
          <a href="/register" class="text-sm font-medium text-[#588157] hover:text-[#344E41]">Belum punya akun?</a>
        </div>

        <button type="submit" class="w-full rounded-full bg-[#111827] px-7 py-4 font-semibold text-white transition hover:bg-[#588157]">
          Login
        </button>
      </form>

      <div class="mt-10 flex items-center gap-4">
        <div class="h-px flex-1 bg-[#344E41]/15"></div>
        <span class="text-sm text-[#344E41]/55">atau</span>
        <div class="h-px flex-1 bg-[#344E41]/15"></div>
      </div>

      <p class="mt-10 text-center text-sm text-[#344E41]/70">
        Belum punya akun?
        <a href="/register" class="font-semibold text-[#588157] hover:text-[#344E41]">Register sekarang</a>
      </p>
    </section>

    <section class="hidden lg:block">
      <div class="rounded-[2rem] bg-[#F1F7EE] p-8 shadow-2xl shadow-[#344E41]/8">
        <img src="/assets/login-illustration.svg" alt="Prayer Streak illustration" class="mx-auto h-auto w-full max-w-[560px]" />
        <div class="mx-auto mt-3 flex w-fit items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#D7DED0]"></span>
          <span class="h-2 w-2 rounded-full bg-[#D7DED0]"></span>
          <span class="h-2 w-7 rounded-full bg-[#344E41]"></span>
        </div>
        <h2 class="mx-auto mt-8 max-w-md text-center text-3xl font-semibold leading-tight text-[#111827]">
          Bangun kebiasaan salat yang lebih teratur bersama <span class="font-bold">Prayer Streak</span>
        </h2>
      </div>
    </section>
  </div>
</main>
