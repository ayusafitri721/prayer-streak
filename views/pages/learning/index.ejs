<main class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-4 pb-28 pt-5 text-[#244338] sm:px-6 lg:py-6">
  <section class="rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.10)] sm:p-6">
    <p class="text-sm font-bold text-[#2F654D]">Belajar Bertahap</p>
    <h1 class="mt-3 text-3xl font-black leading-tight text-[#244338] sm:text-4xl">Panduan Ibadah & Belajar Baca Al-Qur'an</h1>
    <p class="mt-3 max-w-3xl text-base text-[#244338]/72">
      Halaman ini disiapkan untuk belajar dasar ibadah secara ringkas dan terstruktur. Fokusnya supaya kamu bisa mulai dari materi paling penting, lalu lanjut konsisten setiap hari.
    </p>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="rounded-full border border-[#A3B18A]/40 bg-[#F6F1E9] px-3 py-1 text-xs font-bold text-[#2F654D]">Pemula Friendly</span>
      <span class="rounded-full border border-[#A3B18A]/40 bg-[#F6F1E9] px-3 py-1 text-xs font-bold text-[#2F654D]">Step-by-step</span>
      <span class="rounded-full border border-[#A3B18A]/40 bg-[#F6F1E9] px-3 py-1 text-xs font-bold text-[#2F654D]">Rencana Mingguan</span>
    </div>
  </section>

  <section class="grid gap-5 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
    <article class="overflow-hidden rounded-[1.9rem] border border-[#D8CDBB] bg-white shadow-[0_20px_55px_rgba(52,78,65,0.10)]">
      <div class="bg-[linear-gradient(140deg,#244338_0%,#2F654D_65%,#4F7F53_100%)] px-5 py-6 text-white sm:px-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs font-black uppercase tracking-[0.22em] text-[#D9E7D1]">Fiqih Praktis</p>
            <h2 class="mt-1 text-3xl font-black leading-tight sm:text-4xl">Panduan Ibadah Dasar</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-white/80">Materi inti dari thaharah, sholat fardhu, sampai sholat sunnah agar belajar tidak acak.</p>
          </div>
          <span class="rounded-full border border-white/20 bg-white/15 px-4 py-1.5 text-xs font-black uppercase tracking-[0.16em] text-white">
            <%= fiqihGuides.length %> Materi
          </span>
        </div>
      </div>

      <div class="bg-[#FFFCF7] px-5 py-5 sm:px-6 sm:py-6">
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <% fiqihGuides.forEach((item) => { %>
          <a href="<%= item.href %>" class="group rounded-2xl border border-[#D8CDBB] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#A3B18A] hover:shadow-md hover:shadow-[#344E41]/8">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-lg font-black text-[#244338]"><%= item.title %></h3>
              <span class="mt-1 inline-flex rounded-full border border-[#A3B18A]/45 bg-[#F6F1E9] px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#2F654D] transition group-hover:bg-[#588157] group-hover:text-white">Buka</span>
            </div>
            <p class="mt-2 text-sm leading-6 text-[#244338]/70"><%= item.summary %></p>
            <% if (item.category) { %>
              <p class="mt-3 inline-flex rounded-full bg-[#EDE5D8] px-3 py-1 text-[11px] font-black uppercase tracking-[0.12em] text-[#2F654D]/88"><%= item.category %></p>
            <% } %>
            <div class="mt-3 flex flex-wrap gap-2">
              <% item.points.forEach((point) => { %>
                <span class="rounded-full border border-[#A3B18A]/40 bg-[#FFF9F0] px-3 py-1 text-xs font-semibold text-[#2F654D]"><%= point %></span>
              <% }) %>
            </div>
          </a>
        <% }) %>
      </div>
      </div>
    </article>

    <aside class="flex flex-col gap-5">
      <section class="rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)] sm:p-6">
        <h2 class="text-xl font-black text-[#244338]">Rencana 7 Hari Belajar Baca Qur'an</h2>
        <p class="mt-2 text-sm leading-6 text-[#244338]/66">
          Target kecil tiap hari lebih mudah dijaga daripada belajar panjang sekaligus.
        </p>
        <div class="mt-4 space-y-2">
          <% weeklyPlan.forEach((step, index) => { %>
            <div class="flex items-start gap-3 rounded-xl border border-[#D8CDBB] bg-[#FFF9F0] px-3 py-2.5">
              <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#588157] text-xs font-black text-white"><%= index + 1 %></span>
              <p class="text-sm font-semibold text-[#244338]/78"><%= step %></p>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="rounded-[1.75rem] border border-[#D8CDBB] bg-white/92 p-5 shadow-[0_18px_45px_rgba(52,78,65,0.08)] sm:p-6">
        <h2 class="text-xl font-black text-[#244338]">Latihan Harian</h2>
        <p class="mt-2 text-sm leading-6 text-[#244338]/66">
          Pakai menu Al-Qur'an untuk latihan bacaan setelah menyelesaikan materi dasar.
        </p>
        <a href="/quran" class="mt-4 inline-flex rounded-full bg-[#588157] px-5 py-2.5 text-sm font-black text-white transition hover:bg-[#466B47]">
          Buka Menu Al-Qur'an
        </a>
      </section>
    </aside>
  </section>

  <section class="overflow-hidden rounded-[1.9rem] border border-[#D8CDBB] bg-white shadow-[0_20px_55px_rgba(52,78,65,0.10)]">
    <div class="bg-[linear-gradient(130deg,#244338_0%,#2F654D_55%,#4F7F53_100%)] px-5 py-6 text-white sm:px-7">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.24em] text-[#D9E7D1]">Qur'an Learning Path</p>
          <h2 class="mt-2 text-3xl font-black leading-tight sm:text-4xl">Belajar Baca Al-Qur'an</h2>
          <p class="mt-2 max-w-3xl text-sm leading-7 text-white/80"><%= quranLearningPath.summary %></p>
        </div>
        <span class="rounded-full border border-white/20 bg-white/15 px-4 py-1.5 text-xs font-black uppercase tracking-[0.16em] text-white">
          Satu Jalur
        </span>
      </div>
    </div>

    <div class="bg-[#FFFDF8] px-5 py-6 sm:px-7">
      <div class="grid gap-3 md:grid-cols-2">
        <% quranLearningPath.stages.forEach((stage) => { %>
          <article class="rounded-2xl border border-[#D8CDBB] bg-white p-4 transition hover:border-[#A3B18A] hover:shadow-md hover:shadow-[#344E41]/8">
            <p class="text-xs font-black uppercase tracking-[0.16em] text-[#588157]"><%= stage.name %></p>
            <p class="mt-1 text-xl font-black text-[#244338]"><%= stage.title %></p>
            <p class="mt-1.5 text-sm leading-6 text-[#244338]/68"><%= stage.note %></p>
          </article>
        <% }) %>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-2.5">
        <a href="<%= quranLearningPath.href %>" class="inline-flex items-center gap-2 rounded-full bg-[#244338] px-5 py-2.5 text-sm font-black text-white transition hover:bg-[#588157]">
          Mulai Jalur Iqro
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="/belajar/tajwid"
          class="inline-flex items-center gap-2 rounded-full border border-[#244338]/20 bg-white px-5 py-2.5 text-sm font-black text-[#244338] transition hover:border-[#588157] hover:text-[#588157]"
        >
          Buka Halaman Tajwid
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</main>
